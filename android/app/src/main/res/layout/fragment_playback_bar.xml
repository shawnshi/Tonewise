<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <TextView
        android:id="@+id/playback_scene_pill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingTop="4dp"
        android:paddingBottom="0dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Focus · Slot #2 (12)"
        tools:visibility="visible" />

    <com.shawnshi.tonewise.image.CoverView
        android:id="@+id/playback_cover"
        style="@style/Widget.Auxio.Image.Small"
        android:layout_margin="@dimen/spacing_small"
        app:enablePlaybackIndicator="false"
        app:enableSelectionBadge="false"
        app:layout_constraintBottom_toTopOf="@+id/playback_progress_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_scene_pill" />

    <TextView
        android:id="@+id/playback_song"
        style="@style/Widget.Auxio.TextView.Primary.Compact"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_tiny"
        app:layout_constraintBottom_toTopOf="@+id/playback_info"
        app:layout_constraintEnd_toStartOf="@+id/playback_controls_wrapper"
        app:layout_constraintStart_toEndOf="@+id/playback_cover"
        app:layout_constraintTop_toTopOf="@+id/playback_cover"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Song Name" />

    <TextView
        android:id="@+id/playback_info"
        style="@style/Widget.Auxio.TextView.Secondary.Compact"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_tiny"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintBottom_toBottomOf="@+id/playback_cover"
        app:layout_constraintEnd_toStartOf="@+id/playback_controls_wrapper"
        app:layout_constraintStart_toEndOf="@+id/playback_cover"
        app:layout_constraintTop_toBottomOf="@+id/playback_song"
        tools:text="Artist Name" />

    <com.shawnshi.tonewise.playback.ui.ForcedLTRFrameLayout
        android:id="@+id/playback_controls_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toTopOf="@+id/playback_progress_container"
        app:layout_constraintEnd_toStartOf="@+id/playback_appbar_more"
        app:layout_constraintTop_toBottomOf="@+id/playback_scene_pill">

        <com.google.android.material.button.MaterialButtonGroup
            android:id="@+id/playback_controls_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:spacing="0dp"
            app:buttonSizeChange="@xml/safe_button_group_size_change">

            <com.shawnshi.tonewise.ui.RippleFixMaterialButton
                android:id="@+id/playback_play_pause"
                style="@style/Widget.Auxio.Button.Playback.PlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:contentDescription="@string/desc_play_pause"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
                app:icon="@drawable/sel_playing_state_24" />

            <com.shawnshi.tonewise.playback.ui.button.WidthFixMaterialButton
                android:id="@+id/playback_secondary_action"
                style="@style/Widget.Auxio.Button.Playback.Toggle"
                app:materialSizeOverlay="@style/SizeOverlay.Tonewise.Button.Playback.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:icon="@drawable/ic_skip_next_24" />
        </com.google.android.material.button.MaterialButtonGroup>

    </com.shawnshi.tonewise.playback.ui.ForcedLTRFrameLayout>

    <com.shawnshi.tonewise.ui.RippleFixMaterialButton
        android:id="@+id/playback_appbar_more"
        style="@style/Widget.Auxio.Button.Playback.More"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_tiny"
        android:contentDescription="@string/lbl_more"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_more_24"
        app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
        app:layout_constraintBottom_toTopOf="@+id/playback_progress_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_scene_pill" />

    <com.shawnshi.tonewise.playback.ui.ForcedLTRFrameLayout
        android:id="@+id/playback_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/playback_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:trackCornerRadius="0dp"
            app:trackThickness="2dp"
            tools:progress="70" />

    </com.shawnshi.tonewise.playback.ui.ForcedLTRFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
