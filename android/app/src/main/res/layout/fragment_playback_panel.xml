<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.shawnshi.tonewise.playback.ui.ZuneMosaicBackdropView
        android:id="@+id/playback_mosaic_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.shawnshi.tonewise.ui.AuxioToolbar
        android:id="@+id/playback_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/toolbar_playback"
        app:navigationIcon="@drawable/ic_down_24"
        app:subtitleCentered="true"
        app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
        app:title=""
        app:titleCentered="true"
        app:titleTextAppearance="?attr/textAppearanceLabelLargeEmphasized"
        tools:subtitle="@string/lbl_all_songs" />


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/playback_pager"
        style="@style/Widget.Auxio.Image.Full"
        android:layout_marginVertical="@dimen/spacing_small"
        app:enablePlaybackIndicator="false"
        app:enableSelectionBadge="false"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Large"
        android:layout_marginStart="@dimen/spacing_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_toolbar" />

    <com.shawnshi.tonewise.playback.ui.VinylTurntableView
        android:id="@+id/playback_vinyl_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/playback_pager"
        app:layout_constraintEnd_toEndOf="@+id/playback_pager"
        app:layout_constraintStart_toStartOf="@+id/playback_pager"
        app:layout_constraintTop_toTopOf="@+id/playback_pager" />

    <LinearLayout
        android:id="@+id/playback_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_tiny"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/playback_controls_wrapper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playback_pager"
        app:layout_constraintTop_toTopOf="@+id/playback_pager"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:id="@+id/playback_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fallbackLineSpacing="false"
            android:maxLines="1"
            android:textColor="?attr/colorSecondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Johann Sebastian Bach" />

        <TextView
            android:id="@+id/playback_song"
            style="@style/Widget.Auxio.TextView.Primary.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fallbackLineSpacing="false"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textSize="19sp"
            tools:text="Song Name" />

        <TextView
            android:id="@+id/playback_artist"
            style="@style/Widget.Auxio.TextView.Secondary.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fallbackLineSpacing="false"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textSize="13.5sp"
            tools:text="Artist" />

        <TextView
            android:id="@+id/playback_album"
            style="@style/Widget.Auxio.TextView.Secondary.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fallbackLineSpacing="false"
            android:visibility="gone"
            tools:text="Album Name" />

        <TextView
            android:id="@+id/playback_meta"
            style="@style/Widget.Auxio.TextView.Secondary.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.72"
            android:ellipsize="end"
            android:fallbackLineSpacing="false"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textSize="12.5sp"
            android:visibility="invisible"
            tools:text="Album · 2024" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/playback_status_badges"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_tiny"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/playback_seek_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playback_pager"
        app:layout_constraintTop_toBottomOf="@+id/playback_info_container">

        <TextView
            android:id="@+id/playback_bit_perfect_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_signal_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/lbl_badge_bit_perfect"
            android:textColor="?attr/colorPrimary"
            android:textSize="10.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/playback_shuffle_lock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_signal_pill"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/lbl_badge_shuffle_lock"
            android:textColor="?attr/colorSecondary"
            android:textSize="10.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/playback_action_recordings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_signal_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="10.5sp"
            android:visibility="gone"
            tools:text="3 recordings ▸" />

    </LinearLayout>

    <com.shawnshi.tonewise.playback.ui.StyledSeekBar
        android:id="@+id/playback_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/playback_controls_wrapper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playback_pager"
        app:layout_constraintTop_toBottomOf="@+id/playback_status_badges" />

    <com.shawnshi.tonewise.playback.ui.ForcedLTRFrameLayout
        android:id="@+id/playback_controls_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_mid_medium"
        android:layout_marginEnd="@dimen/spacing_mid_medium"
        app:layout_constraintBottom_toTopOf="@+id/playback_utility_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/playback_pager"
        app:layout_constraintTop_toBottomOf="@+id/playback_seek_bar">

        <com.shawnshi.tonewise.playback.ui.button.ScaledPlaybackButtonGroup
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:spacing="@dimen/spacing_small">

            <com.shawnshi.tonewise.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_repeat"
                style="@style/Widget.Auxio.Button.Playback.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_change_repeat"
                app:icon="@drawable/ic_repeat_off_24"
                app:materialSizeOverlay="@style/SizeOverlay.Tonewise.Button.Playback.Toggle" />

            <com.shawnshi.tonewise.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_skip_prev"
                style="@style/Widget.Auxio.Button.Playback.Skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_skip_prev"
                app:icon="@drawable/ic_skip_prev_24"
                app:materialSizeOverlay="@style/SizeOverlay.Tonewise.Button.Playback.Skip" />

            <com.shawnshi.tonewise.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_play_pause"
                style="@style/Widget.Auxio.Button.Playback.PlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_play_pause"
                app:icon="@drawable/sel_playing_state_24"
                app:materialSizeOverlay="@style/SizeOverlay.Tonewise.Button.Playback.PlayPause"
                tools:icon="@drawable/ic_play_24" />

            <com.shawnshi.tonewise.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_skip_next"
                style="@style/Widget.Auxio.Button.Playback.Skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_skip_next"
                app:icon="@drawable/ic_skip_next_24"
                app:materialSizeOverlay="@style/SizeOverlay.Tonewise.Button.Playback.Skip" />

            <com.shawnshi.tonewise.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_shuffle"
                style="@style/Widget.Auxio.Button.Playback.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_shuffle"
                app:icon="@drawable/sel_shuffle_state_24"
                app:materialSizeOverlay="@style/SizeOverlay.Tonewise.Button.Playback.Toggle" />

        </com.shawnshi.tonewise.playback.ui.button.ScaledPlaybackButtonGroup>

    </com.shawnshi.tonewise.playback.ui.ForcedLTRFrameLayout>

    <LinearLayout
        android:id="@+id/playback_utility_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/spacing_mid_medium"
        android:layout_marginEnd="@dimen/spacing_mid_medium"
        app:layout_constraintBottom_toBottomOf="@+id/playback_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playback_pager"
        app:layout_constraintTop_toBottomOf="@+id/playback_controls_wrapper">

        <com.shawnshi.tonewise.ui.RippleFixMaterialButton
            android:id="@+id/playback_love"
            style="@style/Widget.Auxio.Button.Playback.More"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:contentDescription="@string/lbl_love_track"
            app:icon="@drawable/ic_heart_outline_24"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

        <TextView
            android:id="@+id/playback_action_booklet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_signal_pill"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="6dp"
            android:text="@string/lbl_now_playing_booklet"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/playback_action_dsp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.75"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_signal_pill"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="6dp"
            android:text="@string/lbl_now_playing_dsp"
            android:textColor="?attr/colorPrimary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/playback_action_queue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_signal_pill"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11.5sp"
            tools:text="Queue (12)" />

        <com.shawnshi.tonewise.ui.RippleFixMaterialButton
            android:id="@+id/playback_stage_toggle"
            style="@style/Widget.Auxio.Button.Playback.More"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:contentDescription="@string/desc_toggle_vinyl_mode"
            app:icon="@drawable/ic_album_24"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
