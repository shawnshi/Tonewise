<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingEnd="@dimen/spacing_medium">

    <TextView
        android:id="@+id/seek_bar_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:minWidth="38dp"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/sel_activatable_text_secondary"
        tools:text="11:38" />

    <com.google.android.material.slider.WavySlider
        android:id="@+id/seek_bar_slider"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        app:thumbRadius="4dp"
        app:haloRadius="12dp"
        app:waveAmplitudeRampProgressMin="0.0"
        app:waveAmplitudeRampProgressMax="0.03"
        app:wavelength="@dimen/progress_wavelength"
        app:waveSpeed="@dimen/progress_wave_speed"
        app:waveAmplitude="@dimen/progress_amplitude"
        android:valueFrom="0"
        android:valueTo="1" />

    <TextView
        android:id="@+id/seek_bar_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:minWidth="38dp"
        android:minHeight="48dp"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="16:16" />

</LinearLayout>
