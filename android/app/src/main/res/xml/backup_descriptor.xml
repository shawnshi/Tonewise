<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Cache databases are useless between devices, drop them -->
    <exclude
        domain="database"
        path="music_cache.db" />
    <!-- Exclude LAN Sync Bearer tokens and mutable sync ledger from cloud backup -->
    <exclude
        domain="database"
        path="tonewise_sync.db" />
    <exclude
        domain="database"
        path="tonewise_sync.db-wal" />
    <exclude
        domain="database"
        path="tonewise_sync.db-shm" />
    <!-- Exclude sensitive Last.fm API secrets and session keys from cloud backup -->
    <exclude
        domain="sharedpref"
        path="tonewise_lastfm.xml" />
</full-backup-content>
