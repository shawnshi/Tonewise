<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tonewise.Desktop.DeskClockWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="Tonewise OLED Companion">

    <Grid Background="#131720">
        <Border x:Name="OledCanvasHost"
                Margin="4"
                Background="#1A202C"
                BorderBrush="#33D9B372"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: Title + Champagne Signal Path Badge -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay, FallbackValue='Tonewise Companion'}"
                                   Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ArtistsDisplay, Mode=OneWay, FallbackValue='Ready'}"
                                   Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#26D9B372" BorderBrush="#66D9B372" BorderThickness="1"
                            CornerRadius="6" Padding="6,2" VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind ViewModel.SignalPathBadge, Mode=OneWay}"
                                   Foreground="#D9B372" FontSize="10" FontFamily="Consolas" />
                    </Border>
                </Grid>

                <!-- 150-Point Champagne Gold Waveform -->
                <skia:SKXamlCanvas x:Name="WidgetWaveformCanvas"
                                   Grid.Row="1"
                                   PaintSurface="OnPaintWaveform" />

                <!-- Quick Transport & Coding Instant Switch -->
                <Grid Grid.Row="2" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Prev" Padding="8,3" FontSize="11"
                            Background="#242C3B" Foreground="#E2E8F0"
                            Command="{x:Bind ViewModel.PreviousTrackCommand}" />
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}" Padding="10,3" FontSize="11"
                            Background="#D9B372" Foreground="#131720" FontWeight="SemiBold"
                            Command="{x:Bind ViewModel.TogglePlayPauseCommand}" />
                    <Button Grid.Column="2" Content="Next" Padding="8,3" FontSize="11"
                            Background="#242C3B" Foreground="#E2E8F0"
                            Command="{x:Bind ViewModel.NextTrackCommand}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}"
                               Foreground="#94A3B8" FontSize="11" FontFamily="Consolas"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Content="Coding" Padding="8,3" FontSize="11"
                            Background="#242C3B" BorderBrush="#D9B372" BorderThickness="1" Foreground="#D9B372"
                            Command="{x:Bind ViewModel.ActivateCodingQuickSceneCommand}" />
                    <Button Grid.Column="5" Content="×" Padding="7,3" FontSize="11"
                            Background="Transparent" Foreground="#94A3B8"
                            Click="OnCloseWidgetClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
