<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tonewise.Desktop.DeskClockWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="Tonewise OLED Wall Clock">

    <Grid
        x:Name="OledRootGrid"
        Background="#000000"
        RequestedTheme="Dark"
        PointerMoved="OnRootPointerActivity"
        PointerPressed="OnRootPointerActivity"
        KeyDown="OnRootKeyDown">
        <Border x:Name="OledCanvasHost"
                Margin="14"
                Background="#000000"
                BorderBrush="#26E5006B"
                BorderThickness="1"
                CornerRadius="0"
                Padding="14,10,14,12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Chrome Bar (auto-hides in Fullscreen Wall-Clock after 10s idle) -->
                <Grid x:Name="TopChromeBar" Grid.Row="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="WidgetTitleDragBar" Grid.Column="0" Background="Transparent" VerticalAlignment="Stretch">
                        <TextBlock
                            Text="TONEWISE OLED CLOCK"
                            FontSize="12"
                            FontWeight="SemiBold"
                            CharacterSpacing="80"
                            Foreground="#E5006B"
                            VerticalAlignment="Center" />
                    </Border>
                    <Button
                        x:Name="VinylToggleButton"
                        Grid.Column="1"
                        Content="黑胶"
                        MinHeight="28"
                        Padding="8,4"
                        FontSize="12"
                        Background="#0D0D0D"
                        Foreground="#A3A3A3"
                        Click="OnToggleVinylModeClick"
                        AutomationProperties.Name="切换全屏挂钟黑胶唱片模式"
                        ToolTipService.ToolTip="切换全屏挂钟黑胶唱片模式 (V · Shift+V 换材质)" />
                    <Button
                        x:Name="SleepTimerButton"
                        Grid.Column="2"
                        MinHeight="28"
                        Padding="8,4"
                        FontSize="12"
                        Background="#0D0D0D"
                        Foreground="#E5006B"
                        AutomationProperties.Name="挂钟睡眠定时">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="关闭睡眠定时" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="off" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="15 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="15" />
                                <MenuFlyoutItem Text="30 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="30" />
                                <MenuFlyoutItem Text="45 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="45" />
                                <MenuFlyoutItem Text="60 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="60" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="本曲结束后暂停" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="track" />
                                <MenuFlyoutItem Text="本古典作品结束后暂停" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="work" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🌙" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.SleepTimerBadge, Mode=OneWay}"
                                       FontSize="12"
                                       Visibility="{x:Bind ViewModel.IsSleepTimerActive, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PinToggleButton"
                        Grid.Column="3"
                        Content="置顶"
                        MinHeight="28"
                        Padding="8,4"
                        FontSize="12"
                        Background="#0D0D0D"
                        Foreground="#E5006B"
                        Click="OnToggleAlwaysOnTopClick"
                        AutomationProperties.Name="切换窗口置顶" />
                    <Button
                        x:Name="FullscreenToggleButton"
                        Grid.Column="4"
                        Content="全屏挂钟"
                        MinHeight="28"
                        Padding="8,4"
                        FontSize="12"
                        Background="#0D0D0D"
                        Foreground="#FFFFFF"
                        Click="OnToggleFullscreenClick"
                        AutomationProperties.Name="切换全屏挂钟模式 (F11)"
                        ToolTipService.ToolTip="切换全屏挂钟模式 (F11 / Esc)" />
                    <Button
                        x:Name="PipToggleButton"
                        Grid.Column="5"
                        Content="PiP 画中画"
                        MinHeight="28"
                        Padding="8,4"
                        FontSize="12"
                        Background="#0D0D0D"
                        Foreground="#FFFFFF"
                        Click="OnTogglePipModeClick"
                        AutomationProperties.Name="切换 CompactOverlay 置顶画中画模式" />
                    <Button
                        Grid.Column="6"
                        Content="×"
                        MinWidth="28"
                        MinHeight="28"
                        Padding="8,2"
                        FontSize="12"
                        Background="Transparent"
                        Foreground="#A3A3A3"
                        Click="OnCloseWidgetClick"
                        AutomationProperties.Name="关闭 OLED 挂钟" />
                </Grid>

                <!-- Row 1: Responsive Wall Clock + Cover + Classical 3-Tier Track Info + Signal Badge -->
                <Grid Grid.Row="1" ColumnSpacing="14" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock x:Name="ClockTextBlock"
                                       Text="00:00"
                                       Foreground="#F2F0EC"
                                       FontSize="36"
                                       FontWeight="Light"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Bottom" />
                            <TextBlock x:Name="SecondsTextBlock"
                                       Text="00"
                                       Foreground="#E5006B"
                                       FontSize="13"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Margin="0,0,0,5"
                                       VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock x:Name="DateTextBlock"
                                   Text=""
                                   Foreground="#8E8E8E"
                                   FontSize="12"
                                   FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>

                    <Border x:Name="CoverArtBorder"
                            Grid.Column="1"
                            Width="56"
                            Height="56"
                            CornerRadius="0"
                            BorderBrush="#26E5006B"
                            BorderThickness="1"
                            Background="#090909"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <Image x:Name="CoverArtImage" Stretch="UniformToFill" />
                    </Border>

                    <skia:SKXamlCanvas
                        x:Name="OledVinylCanvas"
                        Grid.Column="1"
                        Width="260"
                        Height="260"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Tapped="OnOledVinylTapped"
                        PaintSurface="OnPaintOledVinyl" />

                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="EyebrowTextBlock"
                                   Foreground="#E5006B"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TitleTextBlock"
                                   Foreground="#FFFFFF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleTextBlock"
                                   Foreground="#A3A3A3"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#18E5006B" BorderBrush="#44E5006B" BorderThickness="1"
                                CornerRadius="0" Padding="7,2">
                            <TextBlock Text="{x:Bind ViewModel.SignalPathBadge, Mode=OneWay}"
                                       Foreground="#E5006B" FontSize="12" FontFamily="Consolas" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}"
                                   Foreground="#A3A3A3" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: 150-Point Champagne Gold Click-to-Seek Waveform -->
                <skia:SKXamlCanvas x:Name="WidgetWaveformCanvas"
                                   Grid.Row="2"
                                   PointerPressed="OnWaveformPointerPressed"
                                   PaintSurface="OnPaintWaveform" />

                <!-- Row 3: Console Transport + Love + Quick Scene Capsules -->
                <Grid x:Name="BottomTransportBar" Grid.Row="3" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ShuffleButton" Grid.Column="0" Content="⇄" MinWidth="28" MinHeight="28" Padding="7,4" FontSize="12"
                            Background="#141414" Foreground="#A3A3A3"
                            Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                            AutomationProperties.Name="切换随机播放" />
                    <Button Grid.Column="1" Content="⏮" MinWidth="28" MinHeight="28" Padding="7,4" FontSize="12"
                            Background="#141414" Foreground="#FFFFFF"
                            Command="{x:Bind ViewModel.PreviousTrackCommand}"
                            AutomationProperties.Name="上一曲" />
                    <Button x:Name="PlayPauseButton" Grid.Column="2" Content="▶" MinWidth="32" MinHeight="28" Padding="11,4" FontSize="12"
                            Background="#E5006B" Foreground="#FFFFFF" FontWeight="Bold"
                            Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                            AutomationProperties.Name="播放或暂停" />
                    <Button Grid.Column="3" Content="⏭" MinWidth="28" MinHeight="28" Padding="7,4" FontSize="12"
                            Background="#0D0D0D" Foreground="#FFFFFF"
                            Command="{x:Bind ViewModel.NextTrackCommand}"
                            AutomationProperties.Name="下一曲" />
                    <Button x:Name="RepeatButton" Grid.Column="4" Content="↻" MinWidth="28" MinHeight="28" Padding="7,4" FontSize="12"
                            Background="#0D0D0D" Foreground="#A3A3A3"
                            Command="{x:Bind ViewModel.CycleRepeatModeCommand}"
                            AutomationProperties.Name="切换循环模式" />
                    <Button x:Name="LoveButton" Grid.Column="5" Content="♡" MinWidth="28" MinHeight="28" Padding="7,4" FontSize="12"
                            Background="#0D0D0D" Foreground="#A3A3A3"
                            Command="{x:Bind ViewModel.ToggleCurrentTrackLovedCommand}"
                            AutomationProperties.Name="收藏曲目" />

                    <Button Grid.Column="7" Content="专注" MinHeight="28" Padding="8,4" FontSize="12"
                            Background="#0D0D0D" BorderBrush="#E5006B" BorderThickness="1" Foreground="#E5006B"
                            Command="{x:Bind ViewModel.ActivateClockQuickSceneCommand}" CommandParameter="focus"
                            AutomationProperties.Name="快速切换至深度专注场景" />
                    <Button Grid.Column="8" Content="编码" MinHeight="28" Padding="8,4" FontSize="12"
                            Background="#0D0D0D" Foreground="#FFFFFF"
                            Command="{x:Bind ViewModel.ActivateClockQuickSceneCommand}" CommandParameter="coding"
                            AutomationProperties.Name="快速切换至心流编码场景" />
                    <Button Grid.Column="9" Content="松弛" MinHeight="28" Padding="8,4" FontSize="12"
                            Background="#0D0D0D" Foreground="#FFFFFF"
                            Command="{x:Bind ViewModel.ActivateClockQuickSceneCommand}" CommandParameter="relax"
                            AutomationProperties.Name="快速切换至午后休憩场景" />
                    <Button Grid.Column="10" Content="助眠" MinHeight="28" Padding="8,4" FontSize="12"
                            Background="#0D0D0D" Foreground="#FFFFFF"
                            Command="{x:Bind ViewModel.ActivateClockQuickSceneCommand}" CommandParameter="sleep"
                            AutomationProperties.Name="快速切换至深夜助眠场景" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
