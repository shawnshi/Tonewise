<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tonewise.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    xmlns:local="using:Tonewise.Desktop"
    xmlns:models="using:Tonewise.Desktop.Models"
    xmlns:services="using:Tonewise.Desktop.Services"
    xmlns:playlists="using:Tonewise.SyncHost.Playlists"
    xmlns:audio="using:Tonewise.Audio"
    xmlns:interop="using:Tonewise.Interop"
    mc:Ignorable="d"
    Title="Tonewise">

    <Grid
        x:Name="RootWorkbench"
        Background="{ThemeResource ZuneCanvasBrush}"
        UseLayoutRounding="True"
        PreviewKeyDown="RootWorkbench_PreviewKeyDown"
        KeyDown="RootWorkbench_KeyDown"
        SizeChanged="OnRootWorkbenchSizeChanged">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnFocusGlobalSearchShortcut" />
            <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="OnToggleInspectorShortcut" />
            <KeyboardAccelerator Key="T" Modifiers="None" Invoked="OnOpenLexiconTagShortcut" />
            <KeyboardAccelerator Key="F2" Modifiers="None" Invoked="OnF2BasicMetadataShortcut" />
            <KeyboardAccelerator Key="Number1" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="Number2" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="Number3" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="Number4" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="Number5" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="I" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnTogglePlayShortcut" />
            <KeyboardAccelerator Key="K" Modifiers="Control,Shift" Invoked="OnCodingQuickSceneShortcut" />
            <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="OnPrevTrackShortcut" />
            <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="OnNextTrackShortcut" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <local:SecondsToClockConverter x:Key="SecondsToClockConverter" />
            <Style x:Key="StudioChipButtonStyle" BasedOn="{StaticResource ZuneFlatButtonStyle}" TargetType="Button" />
            <Style x:Key="GoldActionButtonStyle" BasedOn="{StaticResource ZuneAccentActionButtonStyle}" TargetType="Button" />
            <Style x:Key="FilterPillDropDownStyle" BasedOn="{StaticResource ZuneFilterDropDownStyle}" TargetType="DropDownButton" />
            <Style x:Key="StudioCardStyle" BasedOn="{StaticResource ZuneEditorialPanelStyle}" TargetType="Border" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- ROW 0: SEAMLESS ZUNE HEADER (TitleBar + 4-Hub Typographic Pivot + Sub-Pivot + Global Channels) -->
        <StackPanel
            x:Name="TopHeaderContainer"
            Grid.Row="0"
            Background="{ThemeResource ZuneCanvasBrush}"
            Canvas.ZIndex="10">

            <!-- TitleBar Utility Strip (38px) -->
            <Grid Height="38" Padding="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="138" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Width="32"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="{x:Bind ViewModel.CanNavigateBack, Mode=OneWay}"
                        Command="{x:Bind ViewModel.GoBackCommand}"
                        AutomationProperties.Name="返回上一视图"
                        ToolTipService.ToolTip="返回上一视图 (Alt+←)">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                    </Button>
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <Canvas Width="32" Height="32">
                            <Rectangle Canvas.Left="1.8" Canvas.Top="12.6" Width="2.2" Height="5.6" Fill="{ThemeResource ZuneInkSecondaryBrush}" />
                            <Rectangle Canvas.Left="5.4" Canvas.Top="10.0" Width="2.2" Height="10.8" Fill="{ThemeResource ZuneInkSecondaryBrush}" />
                            <Rectangle Canvas.Left="9.0" Canvas.Top="10.0" Width="2.2" Height="14.2" Fill="{ThemeResource ZuneInkPrimaryBrush}" />
                            <Rectangle Canvas.Left="20.8" Canvas.Top="10.0" Width="2.2" Height="14.2" Fill="{ThemeResource ZuneInkPrimaryBrush}" />
                            <Rectangle Canvas.Left="24.4" Canvas.Top="10.0" Width="2.2" Height="10.8" Fill="{ThemeResource ZuneInkSecondaryBrush}" />
                            <Rectangle Canvas.Left="28.0" Canvas.Top="12.6" Width="2.2" Height="5.6" Fill="{ThemeResource ZuneInkSecondaryBrush}" />
                            <Path Data="F0 M 7,4.6 H 25 V 7.2 H 19.4 V 18.5 C 19.4,20.8 18.0,21.9 17.3,22.8 V 27.4 H 14.7 V 22.8 C 14.0,21.9 12.6,20.8 12.6,18.5 V 7.2 H 7 Z M 15.0,7.4 V 19.2 C 15.0,19.9 15.4,20.4 16.0,20.4 C 16.6,20.4 17.0,19.9 17.0,19.2 V 7.4 Z" Fill="{ThemeResource ZuneAccentBrush}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock
                        Text="TONEWISE"
                        FontSize="12"
                        FontWeight="SemiBold"
                        CharacterSpacing="120"
                        Foreground="{ThemeResource ZuneInkPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <AutoSuggestBox
                    x:Name="GlobalSearchBox"
                    Grid.Column="1"
                    Width="320"
                    Margin="20,0,8,0"
                    VerticalAlignment="Center"
                    CornerRadius="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource ZuneHairlineBrush}"
                    Background="Transparent"
                    QueryIcon="Find"
                    ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                    Text="{x:Bind ViewModel.SearchBoxText, Mode=TwoWay}"
                    TextChanged="OnGlobalSearchTextChanged"
                    SuggestionChosen="OnGlobalSearchSuggestionChosen"
                    QuerySubmitted="OnGlobalSearchQuerySubmitted"
                    AutomationProperties.Name="全局搜索"
                    PlaceholderText="搜索曲目、作品、艺人，或输入 scene:focus (Ctrl+K)" />

                <Border
                    x:Name="AppTitleBarDragRegion"
                    Grid.Column="2"
                    Background="Transparent"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnOpenOledWidgetClick"
                        AutomationProperties.Name="打开 OLED 副屏挂钟"
                        ToolTipService.ToolTip="OLED 副屏挂钟 (Ctrl+Alt+M)">
                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                    </Button>
                    <ToggleButton
                        x:Name="InspectorToggleButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnToggleInspectorClick"
                        AutomationProperties.Name="显示或隐藏右侧属性检查器"
                        ToolTipService.ToolTip="属性检查器 (Ctrl+I)">
                        <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                    </ToggleButton>
                    <Button
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Tag="settings"
                        Click="OnPrimaryNavClick"
                        AutomationProperties.Name="打开设置"
                        ToolTipService.ToolTip="设置 (Ctrl+,)：音频输出 / 存储 / 外观">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource ZuneInkPrimaryBrush}" Opacity="{x:Bind PivotInkOpacity(ViewModel.IsNavSettings), Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Zune Top Hero Typographic Pivot: quickplay · collection · now playing · studio -->
            <Grid x:Name="PivotHeaderRow" Padding="18,4,18,6" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="28" VerticalAlignment="Bottom">
                    <Button
                        Padding="0,0,0,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Tag="quickplay"
                        Click="OnPrimaryNavClick"
                        AutomationProperties.Name="quickplay 速播全景"
                        ToolTipService.ToolTip="quickplay (Alt+1)">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Text="quickplay"
                                Style="{StaticResource ZunePivotHeaderStyle}"
                                Foreground="{ThemeResource ZuneInkPrimaryBrush}"
                                Opacity="{x:Bind PivotInkOpacity(ViewModel.IsNavQuickplay), Mode=OneWay}" />
                            <Rectangle Height="2" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsNavQuickplay, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Padding="0,0,0,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Tag="collection"
                        Click="OnPrimaryNavClick"
                        AutomationProperties.Name="collection 馆藏"
                        ToolTipService.ToolTip="collection (Alt+2)">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Text="collection"
                                Style="{StaticResource ZunePivotHeaderStyle}"
                                Foreground="{ThemeResource ZuneInkPrimaryBrush}"
                                Opacity="{x:Bind PivotInkOpacity(ViewModel.IsNavCollection), Mode=OneWay}" />
                            <Rectangle Height="2" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsNavCollection, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Padding="0,0,0,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Tag="now_playing"
                        Click="OnPrimaryNavClick"
                        AutomationProperties.Name="now playing 正在播放画廊"
                        ToolTipService.ToolTip="now playing (Alt+3)">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Text="now playing"
                                Style="{StaticResource ZunePivotHeaderStyle}"
                                Foreground="{ThemeResource ZuneInkPrimaryBrush}"
                                Opacity="{x:Bind PivotInkOpacity(ViewModel.IsNavNowPlaying), Mode=OneWay}" />
                            <Rectangle Height="2" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsNavNowPlaying, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Padding="0,0,0,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Tag="studio"
                        Click="OnPrimaryNavClick"
                        AutomationProperties.Name="studio 工坊与同步"
                        ToolTipService.ToolTip="studio (Alt+4)：入库审校 / 局域网与 USB 同步 / Last.fm">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock
                                    Text="studio"
                                    Style="{StaticResource ZunePivotHeaderStyle}"
                                    Foreground="{ThemeResource ZuneInkPrimaryBrush}"
                                    Opacity="{x:Bind PivotInkOpacity(ViewModel.IsNavStudio), Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.InboxAuditBadgeDisplayValue, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasInboxAuditBadge, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource ZuneAccentBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,3,0,0" />
                            </StackPanel>
                            <Rectangle Height="2" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsNavStudio, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Active context header & filter summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentViewHeader, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveFilterPillsSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Sub-Pivot Strip + Workbench Action Bar (hidden in quickplay / now playing) -->
            <Border
                BorderBrush="{ThemeResource ZuneHairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0,18,6"
                Visibility="{x:Bind ViewModel.IsCollectionOrStudioMainVisible, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer
                            Grid.Column="0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalAlignment="Center">
                            <StackPanel x:Name="SubPivotBar" Orientation="Horizontal" Spacing="20" />
                        </ScrollViewer>

                        <CommandBar
                            x:Name="WorkbenchCommandBar"
                            Grid.Column="1"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="False"
                            Visibility="{x:Bind ViewModel.IsTrackTableVisible, Mode=OneWay}"
                            VerticalAlignment="Center">
                            <AppBarToggleButton
                                x:Name="FilterDrawerToggleButton"
                                Label="筛选"
                                IsChecked="{x:Bind ViewModel.IsFilterStripExpanded, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.IsFiveDimFilterStripVisible, Mode=OneWay}"
                                AutomationProperties.Name="展开或收起五维筛选"
                                ToolTipService.ToolTip="展开或收起场景/能量/节奏筛选面板">
                                <AppBarToggleButton.Icon>
                                    <FontIcon Glyph="&#xE71C;" />
                                </AppBarToggleButton.Icon>
                            </AppBarToggleButton>
                            <AppBarToggleButton
                                x:Name="MultiSelectToggleButton"
                                Label="批量多选"
                                IsChecked="{x:Bind ViewModel.IsMultiSelectMode, Mode=TwoWay}"
                                Click="OnMultiSelectToggleClick"
                                AutomationProperties.Name="开启列表复选框多选"
                                ToolTipService.ToolTip="开启列表复选框以单击勾选多首曲目并批量编辑属性">
                                <AppBarToggleButton.Icon>
                                    <FontIcon Glyph="&#xE762;" />
                                </AppBarToggleButton.Icon>
                            </AppBarToggleButton>
                            <AppBarButton
                                Label="全选"
                                Click="OnSelectAllTracksClick"
                                AutomationProperties.Name="全选当前列表曲目"
                                ToolTipService.ToolTip="全选当前列表曲目以批量编辑属性 (Ctrl+A)">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8B3;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="LexiconTagToolbarButton"
                                Label="五维打标"
                                Click="OnOpenLexiconTagMatrixClick"
                                AutomationProperties.Name="为选中曲目打五维标签"
                                ToolTipService.ToolTip="为选中曲目打五维标签 (T)">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8EC;" />
                                </AppBarButton.Icon>
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout x:Name="LexiconTagMatrixFlyout" Placement="BottomEdgeAlignedRight">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{ThemeResource ZuneSurfaceElevatedBrush}" />
                                                <Setter Property="BorderBrush" Value="{ThemeResource ZuneAccentBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="2" />
                                                <Setter Property="MaxWidth" Value="640" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                            </AppBarButton>
                            <AppBarButton
                                Label="编辑属性"
                                Click="OnOpenF2BasicMetadataClick"
                                AutomationProperties.Name="在属性检查器中编辑选中曲目"
                                ToolTipService.ToolTip="在属性检查器中编辑选中曲目 (F2)">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Label="发送到手机"
                                Click="OnToolbarSendToPhoneClick"
                                AutomationProperties.Name="将选中曲目发送到手机"
                                ToolTipService.ToolTip="将当前选中的一首或多首曲目发送到手机">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8EA;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Label="清空筛选"
                                Command="{x:Bind ViewModel.ResetAllFiltersCommand}"
                                Visibility="{x:Bind ViewModel.IsFiveDimFilterStripVisible, Mode=OneWay}"
                                AutomationProperties.Name="清空全部筛选条件">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE894;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="OLED 副屏挂件" Click="OnOpenOledWidgetClick">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Global Notification & Busy Progress -->
            <InfoBar
                x:Name="GlobalNotificationBar"
                Margin="18,4,18,0"
                CornerRadius="0"
                IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                Severity="{x:Bind SeverityFromLevel(ViewModel.NotificationLevel), Mode=OneWay}"
                IsClosable="True"
                Closed="OnGlobalNotificationBarClosed"
                AutomationProperties.LiveSetting="Polite">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="GlobalNotificationUndoButton"
                        Style="{StaticResource StudioChipButtonStyle}"
                        Content="撤销"
                        Visibility="Collapsed"
                        Click="OnGlobalNotificationUndoClick"
                        AutomationProperties.Name="撤销上一步操作" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Grid
                ColumnSpacing="10"
                Margin="18,4,18,4"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource ZuneInkPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar
                        IsIndeterminate="{x:Bind ViewModel.IsBusyIndeterminate, Mode=OneWay}"
                        Value="{x:Bind ViewModel.BusyProgressValue, Mode=OneWay}"
                        Maximum="100"
                        AutomationProperties.Name="后台任务进度" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource ZuneFlatButtonStyle}"
                    Content="取消"
                    Command="{x:Bind ViewModel.CancelBusyCommand}"
                    Visibility="{x:Bind ViewModel.CanCancelBusy, Mode=OneWay}"
                    VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- ROW 1: MAIN STAGE HOSTED WITH RIGHT SPLITVIEW INSPECTOR -->
        <SplitView
            x:Name="InspectorSplitView"
            Grid.Row="1"
            PanePlacement="Right"
            OpenPaneLength="360"
            CompactPaneLength="0"
            DisplayMode="Inline"
            PaneClosed="OnInspectorPaneClosed"
            PaneBackground="{ThemeResource ZuneSurfaceSubtleBrush}">
            <SplitView.Content>
                <Grid x:Name="StageContainer" Background="Transparent">

                    <!-- STAGE A: QUICKPLAY HORIZONTAL PANORAMA -->
                    <ScrollViewer
                        x:Name="QuickplayScrollViewer"
                        Visibility="{x:Bind ViewModel.IsQuickplayViewVisible, Mode=OneWay}"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        PointerWheelChanged="OnQuickplayPointerWheelChanged">
                        <StackPanel Orientation="Horizontal" Spacing="44" Padding="24,18,120,18">

                            <!-- Column 1: PINS (2x3 Sharp Cover Tiles) -->
                            <StackPanel Width="328" Spacing="12">
                                <TextBlock Text="pins" Style="{StaticResource ZunePivotHeaderStyle}" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                <Border
                                    Background="{ThemeResource ZuneSurfaceSubtleBrush}"
                                    BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                    BorderThickness="1"
                                    Padding="16"
                                    Visibility="{x:Bind ViewModel.HasNoQuickplayPins, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="暂无固定馆藏" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                        <TextBlock Text="在 collection 的专辑、古典作品或歌单上右键选择「固定到 quickplay」，即可在此形成个人直达墙。" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource ZuneAccentActionButtonStyle}" Content="浏览 albums 馆藏" Tag="collection:albums" Click="OnQuickplayNavLinkClick" />
                                    </StackPanel>
                                </Border>
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.QuickplayPins, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasQuickplayPins, Mode=OneWay}"
                                    ElementPrepared="OnQuickplayRepeaterElementPrepared">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="156" MinItemHeight="204" MinColumnSpacing="12" MinRowSpacing="12" MaximumRowsOrColumns="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:QuickplayTileItem">
                                            <Button
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Click="OnQuickplayTileClick"
                                                RightTapped="OnQuickplayTileRightTapped"
                                                AutomationProperties.Name="{x:Bind Title}">
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="立即播放" Click="OnContextPlayQuickplayTileClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="取消固定" Click="OnContextUnpinQuickplayTileClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77A;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                                <StackPanel Spacing="6" Width="156">
                                                    <Border Width="156" Height="156" Background="{ThemeResource ZuneSurfaceSubtleBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image x:Name="TileCoverImage" Source="{x:Bind services:CoverArtImageCache.GetQuickplayCover(CoverArtPath)}" Stretch="UniformToFill" />
                                                            <Border Background="{ThemeResource ZuneAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5,3">
                                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource ZuneInkOnAccentBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <!-- Column 2: SCENES & RELAY (AutoDJ Hero + 4 Instant Scenes + 5 Session Slots) -->
                            <StackPanel Width="320" Spacing="12">
                                <TextBlock Text="scenes &amp; relay" Style="{StaticResource ZunePivotHeaderStyle}" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="16"
                                    Background="{ThemeResource ZuneAccentBrush}"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.GenerateAutoDjPlaylistCommand}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="SMART MIX · 50 TRACKS" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource ZuneInkOnAccentBrush}" />
                                        <TextBlock Text="时段智能 AutoDJ" FontSize="22" FontWeight="Light" Foreground="{ThemeResource ZuneInkOnAccentBrush}" />
                                        <TextBlock Text="70% 常听 + 30% 沉睡唤醒 · 邻曲节奏平滑过渡" FontSize="12" Foreground="{ThemeResource ZuneInkOnAccentBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ZuneFlatButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Command="{x:Bind ViewModel.ActivateDtdDeepFocusSceneCommand}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="深度专注" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneStatusSuccessBrush}" />
                                            <TextBlock Text="器乐 · 低能量" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ZuneFlatButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Command="{x:Bind ViewModel.ActivateCodingQuickSceneCommand}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="心流编程" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneStatusInfoBrush}" />
                                            <TextBlock Text="排除人声" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ZuneFlatButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Command="{x:Bind ViewModel.ActivateDtdAfternoonRelaxSceneCommand}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="午后休憩" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                            <TextBlock Text="放松 · 温暖" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ZuneFlatButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Command="{x:Bind ViewModel.ActivateDtdNightSleepSceneCommand}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="深夜助眠" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneStatusPurpleBrush}" />
                                            <TextBlock Text="能量递减" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="跨端场景接力槽位" Style="{StaticResource ZuneSectionLabelStyle}" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SessionSlots, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="interop:SessionSlotDto">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="{ThemeResource ZuneSurfaceSubtleBrush}"
                                                BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                                BorderThickness="1"
                                                Padding="10,7"
                                                Margin="0,0,0,4"
                                                Tag="{x:Bind SlotIndex}"
                                                Click="OnRestoreSessionSlotClick">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind SlotIndex}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="接续 ▶" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Column 3: HISTORY (Recently Played Albums / Classical Works) -->
                            <StackPanel Width="328" Spacing="12">
                                <TextBlock Text="history" Style="{StaticResource ZunePivotHeaderStyle}" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                <Border
                                    Background="{ThemeResource ZuneSurfaceSubtleBrush}"
                                    BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                    BorderThickness="1"
                                    Padding="16"
                                    Visibility="{x:Bind NegateToVisibility(ViewModel.HasQuickplayHistory), Mode=OneWay}">
                                    <TextBlock Text="播放任意专辑或古典作品后，最近聆听记录会自动汇聚于此。" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.QuickplayHistory, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasQuickplayHistory, Mode=OneWay}"
                                    ElementPrepared="OnQuickplayRepeaterElementPrepared">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="156" MinItemHeight="204" MinColumnSpacing="12" MinRowSpacing="12" MaximumRowsOrColumns="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:QuickplayTileItem">
                                            <Button
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Click="OnQuickplayTileClick"
                                                AutomationProperties.Name="{x:Bind Title}">
                                                <StackPanel Spacing="6" Width="156">
                                                    <Border Width="156" Height="156" Background="{ThemeResource ZuneSurfaceSubtleBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image x:Name="TileCoverImage" Source="{x:Bind services:CoverArtImageCache.GetQuickplayCover(CoverArtPath)}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <!-- Column 4: NEW & REDISCOVERY (Intentional Right Edge Bleed) -->
                            <StackPanel Width="328" Spacing="14">
                                <TextBlock Text="new &amp; rediscovery" Style="{StaticResource ZunePivotHeaderStyle}" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                <TextBlock Text="新近入库" Style="{StaticResource ZuneSectionLabelStyle}" />
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.QuickplayNewAlbums, Mode=OneWay}"
                                    ElementPrepared="OnQuickplayRepeaterElementPrepared">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="156" MinItemHeight="200" MinColumnSpacing="12" MinRowSpacing="12" MaximumRowsOrColumns="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:QuickplayTileItem">
                                            <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Click="OnQuickplayTileClick">
                                                <StackPanel Spacing="5" Width="156">
                                                    <Border Width="156" Height="156" Background="{ThemeResource ZuneSurfaceSubtleBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image x:Name="TileCoverImage" Source="{x:Bind services:CoverArtImageCache.GetQuickplayCover(CoverArtPath)}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind BadgeText}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <TextBlock Text="90天未听唤醒" Style="{StaticResource ZuneSectionLabelStyle}" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.QuickplayRediscovery, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:QuickplayTileItem">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="{ThemeResource ZuneSurfaceSubtleBrush}"
                                                BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                                BorderThickness="1"
                                                Padding="8,7"
                                                Margin="0,0,0,4"
                                                Click="OnQuickplayTileClick">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{x:Bind services:CoverArtImageCache.GetRowCover(CoverArtPath)}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind BadgeText}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- STAGE B: COLLECTION / STUDIO / SETTINGS WORKBENCH -->
                    <Grid x:Name="CollectionAndStudioStage" Visibility="{x:Bind ViewModel.IsCollectionOrStudioMainVisible, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- CONTEXTUAL DECKS ROW -->
                        <StackPanel Grid.Row="0" Spacing="8" Padding="18,8,18,6">

                            <!-- 1) Entity Browser Deck (Zero-Radius Cover Wall in albums mode + Editorial Entity Index otherwise) -->
                            <Border
                                Style="{StaticResource StudioCardStyle}"
                                Visibility="{x:Bind ViewModel.IsEntityBrowserVisible, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="右键卡片可「固定到 quickplay」或「发送到手机」"
                                            FontSize="12"
                                            Foreground="{ThemeResource ZuneInkSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Command="{x:Bind ViewModel.CloseSelectedAlbumCommand}"
                                            Visibility="{x:Bind VisibleWhenBoth(ViewModel.IsAlbumsGridMode, ViewModel.HasSelectedEntityGroup), Mode=OneWay}"
                                            AutomationProperties.Name="返回全部专辑封面墙"
                                            Padding="9,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                                <TextBlock Text="返回全部专辑" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleButton
                                            Grid.Column="1"
                                            Content="显示全部演职员"
                                            FontSize="12"
                                            Padding="10,4"
                                            IsChecked="{x:Bind ViewModel.ShowAllPerformers, Mode=TwoWay}"
                                            Visibility="{x:Bind ViewModel.IsNavArtists, Mode=OneWay}" />
                                        <ToggleButton
                                            Grid.Column="1"
                                            Content="切换乐团 / 独奏"
                                            FontSize="12"
                                            Padding="10,4"
                                            IsChecked="{x:Bind ViewModel.ShowClassicalEnsembles, Mode=TwoWay}"
                                            Visibility="{x:Bind ViewModel.IsNavClassicalWorks, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Click="OnPinSelectedEntityGroupToQuickplayClick"
                                            Visibility="{x:Bind ViewModel.HasSelectedEntityGroup, Mode=OneWay}"
                                            Padding="9,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE718;" FontSize="12" />
                                                <TextBlock Text="固定到 quickplay" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="3"
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Click="OnSendSelectedEntityGroupToPhoneClick"
                                            Visibility="{x:Bind ViewModel.HasSelectedEntityGroup, Mode=OneWay}"
                                            Padding="9,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8EA;" FontSize="12" />
                                                <TextBlock Text="发送当前分组到手机" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- 1B) Other Entity Index (Artists / Composers / Conductors / Classical / Genres / Folders) -->
                                    <ListView
                                        x:Name="EntityBrowserListView"
                                        ItemsSource="{x:Bind ViewModel.CurrentEntityGroups, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedEntityGroup, Mode=OneWay}"
                                        SelectionChanged="OnEntityGroupSelectionChanged"
                                        RightTapped="OnEntityBrowserRightTapped"
                                        Visibility="{x:Bind VisibleWhenFirstAndNotSecond(ViewModel.IsEntityBrowserVisible, ViewModel.IsAlbumsGridMode), Mode=OneWay}"
                                        MaxHeight="204"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="固定到 quickplay" Click="OnContextPinEntityGroupToQuickplayClick">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="发送到手机" Click="OnContextSendEntityGroupToPhoneClick">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EA;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </ListView.ContextFlyout>
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="2" />
                                                <Setter Property="Margin" Value="0,0,8,6" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:EntityGroupItem">
                                                <Border
                                                    Width="228"
                                                    Padding="10,7"
                                                    Background="{ThemeResource ZuneSurfaceElevatedBrush}"
                                                    BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                                    BorderThickness="1"
                                                    AutomationProperties.Name="{x:Bind Title}">
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind BadgeText}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- 2) Scenes Preset / AutoDJ / Rule Studio / Energy Arc Deck -->
                            <Border
                                Style="{StaticResource StudioCardStyle}"
                                Visibility="{x:Bind ViewModel.IsScenesDeckVisible, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0,2" Tag="presets" Click="OnScenesModeSwitchClick">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="预设场景" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" Opacity="{x:Bind PivotInkOpacity(ViewModel.IsScenesPresetSubTab), Mode=OneWay}" />
                                                    <Rectangle Height="2" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsScenesPresetSubTab, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="0,2" Tag="autodj" Click="OnScenesModeSwitchClick">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="AutoDJ" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" Opacity="{x:Bind PivotInkOpacity(ViewModel.IsScenesAutoDjSubTab), Mode=OneWay}" />
                                                    <Rectangle Height="2" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsScenesAutoDjSubTab, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="0,2" Tag="studio" Click="OnScenesModeSwitchClick">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="规则编排" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" Opacity="{x:Bind PivotInkOpacity(ViewModel.IsScenesStudioSubTab), Mode=OneWay}" />
                                                    <Rectangle Height="2" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsScenesStudioSubTab, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="0,2" Tag="arc" Click="OnScenesModeSwitchClick">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="能量曲线" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" Opacity="{x:Bind PivotInkOpacity(ViewModel.IsScenesArcSubTab), Mode=OneWay}" />
                                                    <Rectangle Height="2" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsScenesArcSubTab, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource GoldActionButtonStyle}"
                                            Content="将当前结果保存为歌单"
                                            Command="{x:Bind ViewModel.SnapshotSceneToPlaylistCommand}" />
                                    </Grid>

                                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsScenesPresetSubTab, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Command="{x:Bind ViewModel.ActivateDtdDeepFocusSceneCommand}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="深度专注" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneStatusSuccessBrush}" />
                                                <TextBlock Text="专注 · 排除人声 · 低能量" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Command="{x:Bind ViewModel.ActivateCodingQuickSceneCommand}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="心流编程" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneStatusInfoBrush}" />
                                                <TextBlock Text="编程 · 排除人声" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Command="{x:Bind ViewModel.ActivateDtdAfternoonRelaxSceneCommand}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="午后休憩" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                                <TextBlock Text="放松 · 含人声 · 平静温暖" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Command="{x:Bind ViewModel.ActivateDtdNightSleepSceneCommand}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="深夜助眠" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneStatusPurpleBrush}" />
                                                <TextBlock Text="能量逐首递减" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- AutoDJ SubTab -->
                                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsScenesAutoDjSubTab, Mode=OneWay}">
                                        <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="12,10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="编排策略：70% 经常播放 (35首) + 30% 未播放或较少播放 (15首) · 按当前时段匹配能量、情绪与邻曲平滑过渡" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ViewModel.AutoDjSummaryText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneStatusSuccessBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource GoldActionButtonStyle}" Content="基于当前时间生成并载入 50 首 AutoDJ 列表" Command="{x:Bind ViewModel.GenerateAutoDjPlaylistCommand}" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="从首曲起播当前序列" Command="{x:Bind ViewModel.PlayFilteredFromStartCommand}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Rule Studio SubTab -->
                                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsScenesStudioSubTab, Mode=OneWay}">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <DropDownButton Style="{StaticResource FilterPillDropDownStyle}">
                                                    <DropDownButton.Content>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Rectangle Width="6" Height="6" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind ViewModel.IsGenreFilterActive, Mode=OneWay}" />
                                                            <TextBlock Text="{x:Bind ViewModel.GenreFilterChipLabel, Mode=OneWay}" FontWeight="{x:Bind FilterChipFontWeight(ViewModel.IsGenreFilterActive), Mode=OneWay}" />
                                                        </StackPanel>
                                                    </DropDownButton.Content>
                                                    <DropDownButton.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnGenreFilterFlyoutOpening">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Background" Value="{ThemeResource ZuneSurfaceElevatedBrush}" />
