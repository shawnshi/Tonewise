                                                                    <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="84" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.AutoEqRuleBand7Db, Mode=TwoWay}" AutomationProperties.Name="规则 4k Hz" /><TextBlock Text="4k" FontSize="11" Foreground="{ThemeResource ZuneInkSecondaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.AutoEqRuleBand7Db), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ZuneInkPrimaryBrush}" HorizontalAlignment="Center" /></StackPanel>
