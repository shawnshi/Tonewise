<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tonewise.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Tonewise.Desktop.Models"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="Tonewise Desktop — Structured for works. Built for scenes.">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Three-Pane Main Workspace -->
        <Grid Grid.Row="0" Padding="16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Library & 5D Scene Filters -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tonewise Library" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Button Content="Open Music Folder..." Click="OnOpenFolderClick" HorizontalAlignment="Stretch" />

                    <TextBlock Text="Scene" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterScene, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="All Scenes" Tag="all" />
                        <ComboBoxItem Content="Focus" Tag="focus" />
                        <ComboBoxItem Content="Coding" Tag="coding" />
                        <ComboBoxItem Content="Relax" Tag="relax" />
                        <ComboBoxItem Content="Energy" Tag="energy" />
                        <ComboBoxItem Content="Pop" Tag="pop" />
                    </ComboBox>

                    <TextBlock Text="Energy" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterEnergy, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="All Energy" Tag="all" />
                        <ComboBoxItem Content="Low" Tag="low" />
                        <ComboBoxItem Content="Medium" Tag="medium" />
                        <ComboBoxItem Content="High" Tag="high" />
                        <ComboBoxItem Content="Unknown" Tag="unknown" />
                    </ComboBox>

                    <TextBlock Text="Vocals" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterVocals, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="All" Tag="all" />
                        <ComboBoxItem Content="Instrumental" Tag="instrumental" />
                        <ComboBoxItem Content="Vocal" Tag="vocal" />
                        <ComboBoxItem Content="Unknown" Tag="unknown" />
                    </ComboBox>

                    <TextBlock Text="Mood Cluster (5-Cluster)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterMoodCluster, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="All Moods" Tag="all" />
                        <ComboBoxItem Content="Calm &amp; Relaxed" Tag="calm_relaxed" />
                        <ComboBoxItem Content="Bright &amp; Joyful" Tag="bright_joyful" />
                        <ComboBoxItem Content="Deep &amp; Introspective" Tag="deep_introspective" />
                        <ComboBoxItem Content="Warm &amp; Romantic" Tag="warm_romantic" />
                        <ComboBoxItem Content="High Tension" Tag="high_tension" />
                    </ComboBox>

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </Border>

            <!-- Center Pane: Track List -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <ListView x:Name="TrackListView"
                          ItemsSource="{x:Bind ViewModel.FilteredTracks}"
                          IsItemClickEnabled="True"
                          ItemClick="OnTrackClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TrackItem">
                            <Grid Padding="6,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ArtistsDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SpecsDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind DurationDisplay}" VerticalAlignment="Center"
                                           Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Right Pane: Classical Metadata & Acoustic Signal Path -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="Acoustic Output &amp; Signal Path" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch Header="WASAPI Exclusive (Event-Driven)"
                                  IsOn="{x:Bind ViewModel.PreferWasapiExclusive, Mode=TwoWay}" />

                    <ComboBox Header="Output Endpoint"
                              ItemsSource="{x:Bind ViewModel.OutputEndpoints}"
                              SelectedItem="{x:Bind ViewModel.SelectedEndpoint, Mode=TwoWay}"
                              DisplayMemberPath="FriendlyName"
                              HorizontalAlignment="Stretch" />

                    <Button Content="Load EqualizerAPO .txt..." Click="OnLoadEqClick" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveEqSummary, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
                        <TextBlock Text="{x:Bind ViewModel.SignalPathSummary, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Work &amp; Credits" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.WorkDisplay, Mode=OneWay, FallbackValue='--'}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ComposersDisplay, Mode=OneWay, FallbackValue=''}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ConductorsDisplay, Mode=OneWay, FallbackValue=''}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8" />

                    <Button Content="Toggle LAN Sync Host (HTTP/2 + mDNS)"
                            Command="{x:Bind ViewModel.ToggleLanSyncHostCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.LanSyncStatus, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Bar: 150-Point SkiaSharp Waveform + Transport Controls -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay, FallbackValue='No Track Selected'}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                </StackPanel>

                <skia:SKXamlCanvas x:Name="WaveformCanvas"
                                   Grid.Column="1"
                                   Height="44"
                                   PaintSurface="OnPaintWaveform"
                                   PointerPressed="OnWaveformPointerPressed" />

                <Button Grid.Column="2"
                        Content="Play / Pause"
                        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
