<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tonewise.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    xmlns:local="using:Tonewise.Desktop"
    xmlns:models="using:Tonewise.Desktop.Models"
    xmlns:playlists="using:Tonewise.SyncHost.Playlists"
    xmlns:audio="using:Tonewise.Audio"
    xmlns:interop="using:Tonewise.Interop"
    mc:Ignorable="d"
    Title="Tonewise">

    <Grid
        x:Name="RootWorkbench"
        Background="Transparent"
        KeyDown="RootWorkbench_KeyDown"
        SizeChanged="OnRootWorkbenchSizeChanged">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnFocusGlobalSearchShortcut" />
            <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="OnToggleInspectorShortcut" />
            <KeyboardAccelerator Key="T" Modifiers="None" Invoked="OnOpenLexiconTagShortcut" />
            <KeyboardAccelerator Key="F2" Modifiers="None" Invoked="OnF2BasicMetadataShortcut" />
            <KeyboardAccelerator Key="Number1" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="Number2" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="Number3" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="Number4" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="Number5" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="I" Modifiers="Menu" Invoked="OnPrimaryNavShortcut" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnTogglePlayShortcut" />
            <KeyboardAccelerator Key="K" Modifiers="Control,Shift" Invoked="OnCodingQuickSceneShortcut" />
            <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="OnPrevTrackShortcut" />
            <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="OnNextTrackShortcut" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <local:SecondsToClockConverter x:Key="SecondsToClockConverter" />
            <Style x:Key="DomainHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TwFg64748BBrush}" />
                <Setter Property="Margin" Value="12,10,12,4" />
            </Style>
            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="Margin" Value="6,1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TwFgE2E8F0Brush}" />
            </Style>
            <Style x:Key="StudioChipButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource TwBg1B2230Brush}" />
                <Setter Property="Foreground" Value="{ThemeResource TwFgE2E8F0Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TwLine2A3447Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="GoldActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource TwBgD9B372Brush}" />
                <Setter Property="Foreground" Value="{ThemeResource TwFg131720Brush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="StudioCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TwBg141923Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TwLine242E42Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
        </Grid.RowDefinitions>

        <!-- ROW 0: CUSTOM TITLEBAR (brand + search + inspector toggle only; drag region isolated) -->
        <Grid
            Grid.Row="0"
            Background="Transparent"
            Padding="8,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <!-- Pane Toggle + Brand + Open Library -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Width="40"
                    Height="36"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnTogglePaneClick"
                    AutomationProperties.Name="展开或折叠导航栏"
                    ToolTipService.ToolTip="展开 / 折叠导航栏">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                </Button>
                <Viewbox
                    Width="22"
                    Height="22"
                    Margin="2,0,2,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw">
                    <Canvas Width="32" Height="32">
                        <Rectangle Canvas.Left="1.8" Canvas.Top="12.6" Width="2.2" Height="5.6" RadiusX="1.1" RadiusY="1.1" Fill="{ThemeResource TwFgCBD5E1Brush}" Opacity="0.78" />
                        <Rectangle Canvas.Left="5.4" Canvas.Top="10.0" Width="2.2" Height="10.8" RadiusX="1.1" RadiusY="1.1" Fill="{ThemeResource TwFgCBD5E1Brush}" Opacity="0.78" />
                        <Rectangle Canvas.Left="9.0" Canvas.Top="10.0" Width="2.2" Height="14.2" RadiusX="1.1" RadiusY="1.1" Fill="{ThemeResource TwFgCBD5E1Brush}" Opacity="0.86" />
                        <Rectangle Canvas.Left="20.8" Canvas.Top="10.0" Width="2.2" Height="14.2" RadiusX="1.1" RadiusY="1.1" Fill="{ThemeResource TwFgCBD5E1Brush}" Opacity="0.86" />
                        <Rectangle Canvas.Left="24.4" Canvas.Top="10.0" Width="2.2" Height="10.8" RadiusX="1.1" RadiusY="1.1" Fill="{ThemeResource TwFgCBD5E1Brush}" Opacity="0.78" />
                        <Rectangle Canvas.Left="28.0" Canvas.Top="12.6" Width="2.2" Height="5.6" RadiusX="1.1" RadiusY="1.1" Fill="{ThemeResource TwFgCBD5E1Brush}" Opacity="0.78" />
                        <Path Data="F0 M 7,4.6 H 25 V 7.2 H 19.4 V 18.5 C 19.4,20.8 18.0,21.9 17.3,22.8 V 27.4 H 14.7 V 22.8 C 14.0,21.9 12.6,20.8 12.6,18.5 V 7.2 H 7 Z M 15.0,7.4 V 19.2 C 15.0,19.9 15.4,20.4 16.0,20.4 C 16.6,20.4 17.0,19.9 17.0,19.2 V 7.4 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                    <GradientStop Color="#F0D492" Offset="0" />
                                    <GradientStop Color="#D9B372" Offset="0.55" />
                                    <GradientStop Color="#B88E48" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Canvas>
                </Viewbox>
                <TextBlock
                    Text="Tonewise"
                    FontSize="14"
                    FontWeight="SemiBold"
                    CharacterSpacing="20"
                    Foreground="{ThemeResource TwFgD9B372Brush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Global AutoSuggestBox (isolated from TitleBar drag region) -->
            <AutoSuggestBox
                x:Name="GlobalSearchBox"
                Grid.Column="1"
                Width="360"
                Margin="14,0,8,0"
                VerticalAlignment="Center"
                QueryIcon="Find"
                ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                Text="{x:Bind ViewModel.SearchBoxText, Mode=TwoWay}"
                TextChanged="OnGlobalSearchTextChanged"
                SuggestionChosen="OnGlobalSearchSuggestionChosen"
                QuerySubmitted="OnGlobalSearchQuerySubmitted"
                AutomationProperties.Name="全局搜索"
                PlaceholderText="搜索曲目、作品、艺人，或输入 scene:focus (Ctrl+K)" />

            <!-- Dedicated TitleBar Drag Region -->
            <Border
                x:Name="AppTitleBarDragRegion"
                Grid.Column="2"
                Background="Transparent"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch" />

            <!-- Inspector Pane Toggle -->
            <ToggleButton
                Grid.Column="3"
                Width="40"
                Height="36"
                Padding="0"
                Margin="0,0,4,0"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Center"
                x:Name="InspectorToggleButton"
                Click="OnToggleInspectorClick"
                AutomationProperties.Name="显示或隐藏右侧属性检查器"
                ToolTipService.ToolTip="属性检查器 (Ctrl+I)">
                <FontIcon Glyph="&#xE8A0;" FontSize="16" />
            </ToggleButton>
        </Grid>

        <!-- ROW 1: NATIVE NAVIGATIONVIEW (COLLECTION / CURATION + Footer governance + native Settings) hosting SplitView inspector -->
        <NavigationView
            x:Name="MainNavigationView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="248"
            CompactModeThresholdWidth="720"
            ExpandedModeThresholdWidth="1100"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            AlwaysShowHeader="False"
            DisplayModeChanged="OnNavigationDisplayModeChanged"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="曲库" />
                <NavigationViewItem x:Name="NavItemLibrary" Content="曲库" Tag="library" ToolTipService.ToolTip="曲库 (Alt+1)：曲目 / 专辑 / 流派 / 文件夹">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemArtists" Content="艺人" Tag="artists" ToolTipService.ToolTip="艺人 (Alt+2)：专辑艺人 / 全部演奏者">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemClassical" Content="古典" Tag="classical" SelectsOnInvoked="True" ToolTipService.ToolTip="古典 (Alt+3)：作品 / 作曲家 / 指挥家 / 乐团">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="编排" />
                <NavigationViewItem x:Name="NavItemScenes" Content="场景" Tag="scenes" ToolTipService.ToolTip="场景 (Alt+4)：预设场景 / 五维规则 / 能量曲线">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemPlaylists" Content="歌单" Tag="playlists" ToolTipService.ToolTip="歌单 (Alt+5)：新建 / 编辑 / 导入">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemInbox" Content="入库审校" Tag="inbox" ToolTipService.ToolTip="入库审校 (Alt+I)：待审变更 / 五维与 BPM 回填 / 封面与传记">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{x:Bind ViewModel.InboxAuditBadgeDisplayValue, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasInboxAuditBadge, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemSync" Content="同步与记录" Tag="sync" ToolTipService.ToolTip="同步与记录：局域网设备 / Last.fm / USB 导出">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <SplitView
                x:Name="InspectorSplitView"
                PanePlacement="Right"
                OpenPaneLength="360"
                CompactPaneLength="0"
                DisplayMode="Inline"
                PaneClosed="OnInspectorPaneClosed"
                PaneBackground="{ThemeResource TwBgDF11151EBrush}">
                <SplitView.Content>
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- SINGLE-ROW STUDIO HEADER RIBBON -->
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource TwBg9910141DBrush}"
                    BorderBrush="{ThemeResource TwLine1F2937Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,6,18,6">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SelectorBar
                                x:Name="PrimarySubSelectorBar"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                SelectionChanged="OnSubSelectorBarSelectionChanged" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentViewHeader, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveFilterPillsSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <CommandBar
                                x:Name="WorkbenchCommandBar"
                                Grid.Column="2"
                                Background="Transparent"
                                DefaultLabelPosition="Right"
                                IsDynamicOverflowEnabled="False"
                                VerticalAlignment="Center">
                                <AppBarToggleButton
                                    x:Name="FilterDrawerToggleButton"
                                    Label="筛选"
                                    IsChecked="{x:Bind ViewModel.IsFilterStripExpanded, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.IsFiveDimFilterStripVisible, Mode=OneWay}"
                                    AutomationProperties.Name="展开或收起五维筛选"
                                    ToolTipService.ToolTip="展开或收起场景/能量/节奏筛选面板">
                                    <AppBarToggleButton.Icon>
                                        <FontIcon Glyph="&#xE71C;" />
                                    </AppBarToggleButton.Icon>
                                </AppBarToggleButton>
                                <AppBarToggleButton
                                    x:Name="MultiSelectToggleButton"
                                    Label="批量多选"
                                    IsChecked="{x:Bind ViewModel.IsMultiSelectMode, Mode=TwoWay}"
                                    Click="OnMultiSelectToggleClick"
                                    AutomationProperties.Name="开启列表复选框多选"
                                    ToolTipService.ToolTip="开启列表复选框以单击勾选多首曲目并批量编辑属性">
                                    <AppBarToggleButton.Icon>
                                        <FontIcon Glyph="&#xE762;" />
                                    </AppBarToggleButton.Icon>
                                </AppBarToggleButton>
                                <AppBarButton
                                    Label="全选"
                                    Click="OnSelectAllTracksClick"
                                    AutomationProperties.Name="全选当前列表曲目"
                                    ToolTipService.ToolTip="全选当前列表曲目以批量编辑属性">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8B3;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="LexiconTagToolbarButton"
                                    Label="五维打标"
                                    Click="OnOpenLexiconTagMatrixClick"
                                    AutomationProperties.Name="为选中曲目打五维标签"
                                    ToolTipService.ToolTip="为选中曲目打五维标签 (T)">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8EC;" />
                                    </AppBarButton.Icon>
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout x:Name="LexiconTagMatrixFlyout" Placement="BottomEdgeAlignedRight">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Background" Value="{ThemeResource TwBg151B26Brush}" />
                                                    <Setter Property="BorderBrush" Value="{ThemeResource TwLine55D9B372Brush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="MaxWidth" Value="640" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </AppBarButton>
                                <AppBarButton
                                    Label="编辑属性"
                                    Click="OnOpenF2BasicMetadataClick"
                                    AutomationProperties.Name="在属性检查器中编辑选中曲目"
                                    ToolTipService.ToolTip="在属性检查器中编辑选中曲目 (F2)">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    Label="发送到手机"
                                    Click="OnToolbarSendToPhoneClick"
                                    AutomationProperties.Name="将选中曲目发送到手机"
                                    ToolTipService.ToolTip="将当前选中的一首或多首曲目发送到手机">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8EA;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    Label="清空筛选"
                                    Command="{x:Bind ViewModel.ResetAllFiltersCommand}"
                                    Visibility="{x:Bind ViewModel.IsFiveDimFilterStripVisible, Mode=OneWay}"
                                    AutomationProperties.Name="清空全部筛选条件">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE894;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <CommandBar.SecondaryCommands>
                                    <AppBarButton Label="OLED 副屏挂件" Click="OnOpenOledWidgetClick">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE7F4;" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                        </Grid>

                        <!-- GLOBAL FEEDBACK CHANNEL: result InfoBar + long-running task progress -->
                        <InfoBar
                            x:Name="GlobalNotificationBar"
                            IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                            Severity="{x:Bind SeverityFromLevel(ViewModel.NotificationLevel), Mode=OneWay}"
                            IsClosable="True"
                            AutomationProperties.LiveSetting="Polite" />
                        <Grid
                            ColumnSpacing="10"
                            Margin="0,2,0,4"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TwFgCBD5E1Brush}"
                                    TextTrimming="CharacterEllipsis"
                                    AutomationProperties.LiveSetting="Polite" />
                                <ProgressBar
                                    IsIndeterminate="{x:Bind ViewModel.IsBusyIndeterminate, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.BusyProgressValue, Mode=OneWay}"
                                    Maximum="100"
                                    AutomationProperties.Name="后台任务进度" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="取消"
                                Command="{x:Bind ViewModel.CancelBusyCommand}"
                                Visibility="{x:Bind ViewModel.CanCancelBusy, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CONTEXTUAL DECKS ROW -->
                <StackPanel Grid.Row="1" Spacing="8" Padding="18,10,18,6">

                    <!-- 1) Entity Browser Deck (master index without engineering caption) -->
                    <Border
                        Style="{StaticResource StudioCardStyle}"
                        Padding="10"
                        Visibility="{x:Bind ViewModel.IsEntityBrowserVisible, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="右键卡片或选择分组后点击右侧按钮可发送到手机（流派/艺人自动设为订阅）"
                                    FontSize="11"
                                    Foreground="{ThemeResource TwFg94A3B8Brush}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource StudioChipButtonStyle}"
                                    Click="OnSendSelectedEntityGroupToPhoneClick"
                                    Visibility="{x:Bind ViewModel.HasSelectedEntityGroup, Mode=OneWay}"
                                    Padding="9,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8EA;" FontSize="12" />
                                        <TextBlock Text="发送当前分组到手机" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ListView
                                x:Name="EntityBrowserListView"
                                ItemsSource="{x:Bind ViewModel.CurrentEntityGroups, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedEntityGroup, Mode=OneWay}"
                                SelectionChanged="OnEntityGroupSelectionChanged"
                                RightTapped="OnEntityBrowserRightTapped"
                                MaxHeight="204"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="发送到手机" Click="OnContextSendEntityGroupToPhoneClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8EA;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="2" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:EntityGroupItem">
                                        <Border
                                            Width="220"
                                            Padding="10,7"
                                            Background="{ThemeResource TwBg1A2130Brush}"
                                            BorderBrush="{ThemeResource TwLine2A3447Brush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{ThemeResource TwBg252D3FBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind BadgeText}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 2) Scenes Preset / AutoDJ / Studio Rule / Energy Arc Cards + Snapshot -->
                    <Border
                        Style="{StaticResource StudioCardStyle}"
                        Padding="10"
                        Visibility="{x:Bind ViewModel.IsScenesDeckVisible, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="预设场景" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsScenesPresetSubTab, Mode=OneWay}" />
                                <TextBlock Grid.Column="0" Text="AutoDJ 智能时段编排" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg34D399Brush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsScenesAutoDjSubTab, Mode=OneWay}" />
                                <TextBlock Grid.Column="0" Text="规则推演工坊" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsScenesStudioSubTab, Mode=OneWay}" />
                                <TextBlock Grid.Column="0" Text="能量曲线编排" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg60A5FABrush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsScenesArcSubTab, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource GoldActionButtonStyle}"
                                    Content="将当前结果保存为歌单"
                                    Command="{x:Bind ViewModel.SnapshotSceneToPlaylistCommand}" />
                            </Grid>

                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsScenesPresetSubTab, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Command="{x:Bind ViewModel.ActivateDtdDeepFocusSceneCommand}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="深度专注" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg34D399Brush}" />
                                        <TextBlock Text="专注 · 排除人声 · 低能量" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Command="{x:Bind ViewModel.ActivateCodingQuickSceneCommand}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="心流编程" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg60A5FABrush}" />
                                        <TextBlock Text="编程 · 排除人声" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Command="{x:Bind ViewModel.ActivateDtdAfternoonRelaxSceneCommand}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="午后休憩" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                        <TextBlock Text="放松 · 含人声 · 平静温暖" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Command="{x:Bind ViewModel.ActivateDtdNightSleepSceneCommand}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="深夜助眠" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgA78BFABrush}" />
                                        <TextBlock Text="能量逐首递减" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- AutoDJ SubTab -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsScenesAutoDjSubTab, Mode=OneWay}">
                                <Border Background="{ThemeResource TwBg141923Brush}" BorderBrush="{ThemeResource TwLine242E42Brush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="编排策略：70% 经常播放 (35首) + 30% 未播放或较少播放 (15首) · 按当前时段匹配能量、情绪与邻曲平滑过渡" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.AutoDjSummaryText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg34D399Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource GoldActionButtonStyle}" Content="基于当前时间生成并载入 50 首 AutoDJ 列表" Command="{x:Bind ViewModel.GenerateAutoDjPlaylistCommand}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="从首曲起播当前序列" Command="{x:Bind ViewModel.PlayFilteredFromStartCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Rule Studio SubTab -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsScenesStudioSubTab, Mode=OneWay}">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox Width="126" Header="场景域" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterScene, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="全部场景" Tag="all" />
                                            <ComboBoxItem Content="专注" Tag="focus" />
                                            <ComboBoxItem Content="编程" Tag="coding" />
                                            <ComboBoxItem Content="放松" Tag="relax" />
                                            <ComboBoxItem Content="活力" Tag="energy" />
                                            <ComboBoxItem Content="流行" Tag="pop" />
                                        </ComboBox>
                                        <ComboBox Width="116" Header="能量等级" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterEnergy, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="全部能量" Tag="all" />
                                            <ComboBoxItem Content="低" Tag="low" />
                                            <ComboBoxItem Content="中" Tag="medium" />
                                            <ComboBoxItem Content="高" Tag="high" />
                                        </ComboBox>
                                        <ComboBox Width="128" Header="人声门控" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterVocals, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="全部人声" Tag="all" />
                                            <ComboBoxItem Content="纯器乐" Tag="instrumental" />
                                            <ComboBoxItem Content="含人声" Tag="vocal" />
                                            <ComboBoxItem Content="未知" Tag="unknown" />
                                        </ComboBox>
                                        <ComboBox Width="124" Header="节奏分档" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterTempoBucket, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="全部节奏" Tag="all" />
                                            <ComboBoxItem Content="Very Slow" Tag="Very Slow" />
                                            <ComboBoxItem Content="Slow" Tag="Slow" />
                                            <ComboBoxItem Content="Moderate" Tag="Moderate" />
                                            <ComboBoxItem Content="Fast" Tag="Fast" />
                                            <ComboBoxItem Content="Very Fast" Tag="Very Fast" />
                                        </ComboBox>
                                        <ComboBox Width="140" Header="情绪簇" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterMoodCluster, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="全部情绪" Tag="all" />
                                            <ComboBoxItem Content="平静舒缓" Tag="calm_relaxed" />
                                            <ComboBoxItem Content="温暖浪漫" Tag="warm_romantic" />
                                            <ComboBoxItem Content="沉思专注" Tag="focus_deep" />
                                            <ComboBoxItem Content="明快振奋" Tag="bright_energetic" />
                                            <ComboBoxItem Content="忧郁深沉" Tag="melancholic_dark" />
                                        </ComboBox>
                                        <CheckBox
                                            Content="排除人声"
                                            IsChecked="{x:Bind ViewModel.ExcludeVocal, Mode=TwoWay}"
                                            VerticalAlignment="Bottom"
                                            Margin="2,0,4,3"
                                            FontSize="12"
                                            Foreground="{ThemeResource TwFgD9B372Brush}" />
                                        <ToggleSwitch
                                            Header="Tempo 未知透传"
                                            IsOn="{x:Bind ViewModel.ScenesTempoNullPassthrough, Mode=TwoWay}"
                                            OnContent="透传"
                                            OffContent="严格"
                                            FontSize="12" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Background="{ThemeResource TwBg141923Brush}" BorderBrush="{ThemeResource TwLine242E42Brush}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="实时逻辑推演表达式 (Rule DSL)" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ScenesRuleDslPreview, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource TwFgD9B372Brush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource GoldActionButtonStyle}" Content="从首曲播放推演结果" Command="{x:Bind ViewModel.PlayFilteredFromStartCommand}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="重置规则条件" Command="{x:Bind ViewModel.ResetAllFiltersCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Energy Arc SubTab -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsScenesArcSubTab, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Tag="flat" Click="OnSelectEnergyArcClick">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="均衡原序 (Flat)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                                            <TextBlock Text="保持曲库自然检索序" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                            <TextBlock Text="● 当前已选" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" Visibility="{x:Bind ViewModel.IsArcFlat, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Tag="energy_asc" Click="OnSelectEnergyArcClick">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="渐强唤醒 (Ascending)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg34D399Brush}" />
                                            <TextBlock Text="低 → 中 → 高能递进" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                            <TextBlock Text="● 当前已选" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" Visibility="{x:Bind ViewModel.IsArcAsc, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Tag="energy_desc_sleep" Click="OnSelectEnergyArcClick">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="深夜助眠 (Sleep Arc)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgA78BFABrush}" />
                                            <TextBlock Text="能量与 BPM 逐级衰减" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                            <TextBlock Text="● 当前已选" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" Visibility="{x:Bind ViewModel.IsArcSleep, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource StudioChipButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8" Tag="rediscovery_90d" Click="OnSelectEnergyArcClick">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="90天未听再发现" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg60A5FABrush}" />
                                            <TextBlock Text="优先捞取低曝光沉睡曲目" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                            <TextBlock Text="● 当前已选" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" Visibility="{x:Bind ViewModel.IsArcRediscovery, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ScenesEnergyDistributionText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Style="{StaticResource GoldActionButtonStyle}" Content="按当前能量曲线起播" Command="{x:Bind ViewModel.PlayFilteredFromStartCommand}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3) Five-Dim Focus Filter Strip (Collapsible Drawer in Library Tracks, Always Visible in Scenes Presets) -->
                    <Border
                        Style="{StaticResource StudioCardStyle}"
                        Padding="10,8"
                        Visibility="{x:Bind ViewModel.IsFilterDrawerOpen, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox Width="132" Header="场景" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterScene, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="全部场景" Tag="all" />
                                        <ComboBoxItem Content="专注" Tag="focus" />
                                        <ComboBoxItem Content="编程" Tag="coding" />
                                        <ComboBoxItem Content="放松" Tag="relax" />
                                        <ComboBoxItem Content="活力" Tag="energy" />
                                        <ComboBoxItem Content="流行" Tag="pop" />
                                    </ComboBox>
                                    <ComboBox Width="122" Header="能量" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterEnergy, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="全部能量" Tag="all" />
                                        <ComboBoxItem Content="低" Tag="low" />
                                        <ComboBoxItem Content="中" Tag="medium" />
                                        <ComboBoxItem Content="高" Tag="high" />
                                    </ComboBox>
                                    <ComboBox Width="136" Header="人声" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterVocals, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="全部人声" Tag="all" />
                                        <ComboBoxItem Content="纯器乐" Tag="instrumental" />
                                        <ComboBoxItem Content="含人声" Tag="vocal" />
                                        <ComboBoxItem Content="未知" Tag="unknown" />
                                    </ComboBox>
                                    <CheckBox
                                        Content="排除人声"
                                        IsChecked="{x:Bind ViewModel.ExcludeVocal, Mode=TwoWay}"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0,4,3"
                                        FontSize="12"
                                        Foreground="{ThemeResource TwFgD9B372Brush}" />
                                    <ComboBox Width="128" Header="节奏" SelectedValue="{x:Bind ViewModel.FilterTempoBucket, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="全部节奏" Tag="all" />
                                        <ComboBoxItem Content="Very Slow" Tag="Very Slow" />
                                        <ComboBoxItem Content="Slow" Tag="Slow" />
                                        <ComboBoxItem Content="Moderate" Tag="Moderate" />
                                        <ComboBoxItem Content="Fast" Tag="Fast" />
                                        <ComboBoxItem Content="Very Fast" Tag="Very Fast" />
                                    </ComboBox>
                                    <ComboBox Width="152" Header="情绪" FontSize="12" SelectedValue="{x:Bind ViewModel.FilterMoodCluster, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="全部情绪" Tag="all" />
                                        <ComboBoxItem Content="平静舒缓" Tag="calm_relaxed" />
                                        <ComboBoxItem Content="温暖浪漫" Tag="warm_romantic" />
                                        <ComboBoxItem Content="沉思专注" Tag="focus_deep" />
                                        <ComboBoxItem Content="明快振奋" Tag="bright_energetic" />
                                        <ComboBoxItem Content="忧郁深沉" Tag="melancholic_dark" />
                                    </ComboBox>
                                    <ComboBox Width="152" Header="能量曲线" FontSize="12" SelectedValue="{x:Bind ViewModel.SelectedEnergyArc, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="默认顺序" Tag="flat" />
                                        <ComboBoxItem Content="能量渐强" Tag="energy_asc" />
                                        <ComboBoxItem Content="助眠渐弱" Tag="energy_desc_sleep" />
                                        <ComboBoxItem Content="90天未听优先" Tag="rediscovery_90d" />
                                    </ComboBox>
                                </StackPanel>
                            </ScrollViewer>

                            <InfoBar
                                IsOpen="{x:Bind ViewModel.HasMissingTempoBanner, Mode=OneWay}"
                                Severity="Warning"
                                IsClosable="False"
                                Title="Tempo 待回填"
                                Message="{x:Bind ViewModel.MissingMetadataBannerText, Mode=OneWay}">
                                <InfoBar.ActionButton>
                                    <Button Content="去入库审校" Tag="inbox" Click="OnPrimaryNavClick" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>
                    </Border>

                    <!-- 4) Playlists Management Deck -->
                    <Border
                        Style="{StaticResource StudioCardStyle}"
                        Padding="10"
                        Visibility="{x:Bind ViewModel.IsPlaylistsDeckVisible, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource GoldActionButtonStyle}" Click="OnNewPlaylistClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="新建歌单" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnImportPlaylistClick" ToolTipService.ToolTip="从 Spotify / Apple Music / Billboard / Kworb 链接或文本文件导入">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock Text="导入歌单" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnEditPlaylistClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="14" /><TextBlock Text="编辑" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnRematchPlaylistsClick" ToolTipService.ToolTip="按最新匹配算法重新匹配歌单中的未匹配曲目与失效路径，并将更新写回 .m3u8">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="重匹曲库" /></StackPanel>
                                    </Button>
                                    <ToggleButton
                                        x:Name="PlaylistMultiSelectToggleButton"
                                        IsChecked="{x:Bind ViewModel.IsPlaylistMultiSelectMode, Mode=TwoWay}"
                                        Click="OnPlaylistMultiSelectToggleClick"
                                        Padding="10,5"
                                        FontSize="12"
                                        CornerRadius="6"
                                        ToolTipService.ToolTip="开启多选以同时选择多个歌单发送到手机">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE762;" FontSize="14" /><TextBlock Text="多选歌单" /></StackPanel>
                                    </ToggleButton>
                                    <Button
                                        Style="{StaticResource StudioChipButtonStyle}"
                                        Content="全选歌单"
                                        Click="OnSelectAllPlaylistsClick"
                                        Visibility="{x:Bind ViewModel.IsPlaylistMultiSelectMode, Mode=OneWay}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnSendPlaylistToPhoneClick" ToolTipService.ToolTip="将选中的一个或多个歌单加入手机同步队列（订阅）">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8EA;" FontSize="14" /><TextBlock Text="{x:Bind ViewModel.SendPlaylistToPhoneButtonLabel, Mode=OneWay}" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GoldActionButtonStyle}" Command="{x:Bind ViewModel.SaveCurrentPlaylistOrderCommand}" Visibility="{x:Bind ViewModel.IsViewingPlaylist, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock Text="保存排序" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnDeletePlaylistClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="删除" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="返回曲库" Command="{x:Bind ViewModel.ShowAllLibraryTracksCommand}" />
                                </StackPanel>
                            </ScrollViewer>

                            <ListView
                                x:Name="PlaylistsListView"
                                ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                                SelectionMode="Single"
                                SelectionChanged="OnPlaylistsSelectionChanged"
                                RightTapped="OnPlaylistsRightTapped"
                                MaxHeight="168"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="发送到手机（订阅）" Click="OnContextSendPlaylistCardToPhoneClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8EA;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="重匹本地曲库并保存" Click="OnContextRematchPlaylistCardClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="删除歌单" Click="OnContextDeletePlaylistCardClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="2" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="playlists:PlaylistSummary">
                                        <Border
                                            Padding="10,6"
                                            Background="{ThemeResource TwBg1A2232Brush}"
                                            BorderBrush="{ThemeResource TwLine2E3A50Brush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                                                <TextBlock Text="{x:Bind CountBadge}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 5) Inbox & Audit Deck -->
                    <Border
                        Style="{StaticResource StudioCardStyle}"
                        Padding="10"
                        Visibility="{x:Bind ViewModel.IsInboxAuditDeckVisible, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺流派" Tag="audit_missing_genre" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺作曲" Tag="audit_missing_composer" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺指挥" Tag="audit_missing_conductor" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺专辑" Tag="audit_missing_album" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺厂牌" Tag="audit_missing_publisher" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺场景" Tag="audit_missing_scene" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺节奏" Tag="audit_missing_tempo" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺封面" Tag="audit_missing_cover" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="缺人声标签" Tag="audit_missing_vocals" Click="OnNavModeClick" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="90天未听" Tag="rediscovery_90d" Click="OnNavModeClick" />
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource GoldActionButtonStyle}" Content="扫描元数据缺口" Command="{x:Bind ViewModel.RunFillMissingScanCommand}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="补全当前列表基础信息" Command="{x:Bind ViewModel.FetchMissingBasicInfoForCurrentListCommand}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="补全当前列表五维标签" Command="{x:Bind ViewModel.FetchMissing5DTagsForCurrentListCommand}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="抓取缺失封面与传记" Command="{x:Bind ViewModel.EnrichLibraryCoversAndBiosCommand}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="批准高置信度 (≥80%)…" Click="OnApproveAllHighConfidenceClick" />
                                    <Button Style="{StaticResource GoldActionButtonStyle}" Content="应用已批准的变更" Command="{x:Bind ViewModel.CommitStagingBatchCommand}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="撤回上一批次" Command="{x:Bind ViewModel.RollbackLastBatchCommand}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="清除待审…" Click="OnClearPendingStagingClick" />
                                </StackPanel>
                            </ScrollViewer>

                            <TextBlock Text="{x:Bind ViewModel.StagingSummaryText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />

                            <ListView
                                ItemsSource="{x:Bind ViewModel.StagingProposalItems, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasStagingProposals, Mode=OneWay}"
                                MaxHeight="170">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:StagingProposalViewItem">
                                        <Grid ColumnSpacing="8" Padding="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind TrackDisplay}" FontSize="12" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FieldName}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ValueTransition}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind SourceBadge}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Padding="8,4" Tag="{x:Bind ProposalId}" Click="OnApproveProposalClick" AutomationProperties.Name="批准此变更提案" ToolTipService.ToolTip="批准">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="5" Padding="8,4" Tag="{x:Bind ProposalId}" Click="OnRejectProposalClick" AutomationProperties.Name="驳回此变更提案" ToolTipService.ToolTip="驳回">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- CENTER STAGE ROW 2: STREAMLINED 8-COLUMN TRACK TABLE / SYNC HUB / SETTINGS HUB -->
                <Grid Grid.Row="2" Padding="18,0,18,8">
                    <!-- A) Streamlined 8-Column Track Table -->
                    <Grid Visibility="{x:Bind ViewModel.IsTrackTableVisible, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Clickable Sortable Column Header -->
                        <Border Grid.Row="0" Background="{ThemeResource TwBg141923Brush}" BorderBrush="{ThemeResource TwLine242E42Brush}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="10,0">
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.7*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{x:Bind ViewModel.HeaderTitleText, Mode=OneWay}" Tag="title" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" ToolTipService.ToolTip="点击按曲目 / 专辑名称排序" />
                                <Button Grid.Column="1" Content="{x:Bind ViewModel.HeaderArtistText, Mode=OneWay}" Tag="artist" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" ToolTipService.ToolTip="点击按艺人排序" />
                                <Button Grid.Column="2" Content="{x:Bind ViewModel.HeaderComposerText, Mode=OneWay}" Tag="composer" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" ToolTipService.ToolTip="点击按作曲 / 作品排序" />
                                <Button Grid.Column="3" Content="{x:Bind ViewModel.HeaderYearText, Mode=OneWay}" Tag="year" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" ToolTipService.ToolTip="点击按发行年份排序" />
                                <Button Grid.Column="4" Content="{x:Bind ViewModel.HeaderSceneText, Mode=OneWay}" Tag="scene" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" ToolTipService.ToolTip="点击按场景 / 情绪排序" />
                                <Button Grid.Column="5" Content="{x:Bind ViewModel.HeaderEnergyText, Mode=OneWay}" Tag="energy" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" ToolTipService.ToolTip="点击按能量 / 节奏排序" />
                                <Button Grid.Column="6" Content="{x:Bind ViewModel.HeaderPlayCountText, Mode=OneWay}" Tag="playcount" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" ToolTipService.ToolTip="点击按播放次数与喜爱排序" />
                                <Button Grid.Column="7" Content="{x:Bind ViewModel.HeaderDurationText, Mode=OneWay}" Tag="duration" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" ToolTipService.ToolTip="点击按曲目时长排序" />
                            </Grid>
                        </Border>

                        <!-- TrackListView (CommandBarFlyout + DragReorder in Playlist + x:Phase Progressive Rendering) -->
                        <Border Grid.Row="1" Background="{ThemeResource TwBgBB10141DBrush}" BorderBrush="{ThemeResource TwLine242E42Brush}" BorderThickness="1" CornerRadius="0,0,6,6">
                            <ListView
                                x:Name="TrackListView"
                                ItemsSource="{x:Bind ViewModel.FilteredTracks, Mode=OneWay}"
                                SelectionMode="Extended"
                                IsDoubleTapEnabled="True"
                                CanReorderItems="{x:Bind ViewModel.IsViewingPlaylist, Mode=OneWay}"
                                AllowDrop="{x:Bind ViewModel.IsViewingPlaylist, Mode=OneWay}"
                                ContainerContentChanging="OnTrackListContainerContentChanging"
                                SelectionChanged="OnTrackSelectionChanged"
                                DoubleTapped="OnTrackDoubleTapped"
                                RightTapped="OnTrackListRightTapped">
                                <ListView.ContextFlyout>
                                    <CommandBarFlyout>
                                        <AppBarButton Icon="Play" Label="播放" Click="OnContextPlayTrackClick" AutomationProperties.Name="立即播放所选曲目" />
                                        <AppBarButton Icon="Add" Label="下一首" Click="OnContextEnqueueNextClick" AutomationProperties.Name="加入下一首播放" />
                                        <AppBarButton Label="追加队尾" Click="OnContextEnqueueEndClick" AutomationProperties.Name="追加到播放列表末尾">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE90B;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton Label="喜爱" Click="OnContextToggleLovedClick" AutomationProperties.Name="切换喜爱并同步至 Last.fm">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xEB51;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton Icon="Tag" Label="T · 打标" Click="OnContextTagMatrixClick" AutomationProperties.Name="打开 Lexicon 五维胶囊打标矩阵" />
                                        <AppBarButton Icon="Edit" Label="F2 · 编辑" Click="OnContextF2BasicMetadataClick" AutomationProperties.Name="在右侧属性检查器中精修基本属性" />
                                        <AppBarButton Label="发送到手机" Click="OnContextSendTracksToPhoneClick" AutomationProperties.Name="将所选一首或多首曲目发送到手机">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE8EA;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <CommandBarFlyout.SecondaryCommands>
                                            <AppBarButton Icon="MusicInfo" Label="添加到当前歌单" Click="OnContextAddToPlaylistClick" />
                                            <AppBarButton Icon="Folder" Label="打开文件所在目录" Click="OnContextRevealInExplorerClick" />
                                        </CommandBarFlyout.SecondaryCommands>
                                    </CommandBarFlyout>
                                </ListView.ContextFlyout>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TrackItem">
                                        <Grid ColumnSpacing="10" Padding="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.7*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1.45*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="68" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" ColumnSpacing="10" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="40"
                                                    Height="40"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource TwBg141A26Brush}"
                                                    BorderBrush="{ThemeResource TwLine242E42Brush}"
                                                    BorderThickness="1">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource TwFg64748BBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image x:Name="RowCoverImage" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Album}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ArtistsDisplay}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock x:Phase="1" Text="{x:Bind ComposersDisplay}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Phase="1" Text="{x:Bind WorkAndConductorSubline}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" x:Phase="1" Text="{x:Bind YearDisplay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="4" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock x:Phase="2" Text="{x:Bind SceneBadge}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Phase="2" Text="{x:Bind MoodBadge}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock x:Phase="2" Text="{x:Bind EnergyBadge}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" />
                                                <TextBlock x:Phase="2" Text="{x:Bind TempoDisplay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="6" x:Phase="1" Text="{x:Bind PlayCountDisplay}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="7" x:Phase="2" Text="{x:Bind DurationDisplay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- B) Sync & Scrobble Full Page -->
                    <ScrollViewer Visibility="{x:Bind ViewModel.IsSyncScrobbleViewVisible, Mode=OneWay}">
                        <StackPanel Spacing="12" Padding="0,8,0,16">

                            <!-- Sub-Tab: LAN & USB Devices & Persistent Session Slots -->
                            <Border Style="{StaticResource StudioCardStyle}" Visibility="{x:Bind ViewModel.IsSyncLanSubTab, Mode=OneWay}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="局域网与 USB 手机双向同步" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Style="{StaticResource GoldActionButtonStyle}" Content="开启 / 关闭局域网同步服务" Command="{x:Bind ViewModel.ToggleLanSyncHostCommand}" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="刷新配对码" Command="{x:Bind ViewModel.RegenerateLanPairingCodeCommand}" />
                                        <TextBlock Text="{x:Bind ViewModel.LanSyncStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Background="{ThemeResource TwBg192130Brush}" BorderBrush="{ThemeResource TwLine263147Brush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="USB 自动双向同步（目标目录：手机 Music/）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.UsbAdbStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource GoldActionButtonStyle}" Content="立即 USB 同步" Command="{x:Bind ViewModel.TriggerUsbSyncNowCommand}" IsEnabled="{x:Bind ViewModel.HasConnectedUsbDevice, Mode=OneWay}" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Style="{StaticResource StudioChipButtonStyle}" Content="取消" Command="{x:Bind ViewModel.CancelUsbSyncCommand}" Visibility="{x:Bind ViewModel.IsUsbSyncRunning, Mode=OneWay}" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="24">
                                                <ToggleSwitch Header="连接手机自动 USB 同步" IsOn="{x:Bind ViewModel.IsUsbAutoSyncEnabled, Mode=TwoWay}" />
                                                <ToggleSwitch Header="自动删除手机 Music 中不在列表的歌曲" IsOn="{x:Bind ViewModel.IsMirrorPruneEnabled, Mode=TwoWay}" />
                                            </StackPanel>
                                            <ProgressBar IsIndeterminate="False" Value="{x:Bind ViewModel.UsbSyncProgressPercent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ViewModel.IsUsbSyncRunning, Mode=OneWay}" AutomationProperties.Name="USB 同步进度" />
                                            <TextBlock Text="{x:Bind ViewModel.UsbSyncProgressText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TwFgCBD5E1Brush}" TextWrapping="Wrap" />
                                            <Border Background="{ThemeResource TwBg141A26Brush}" BorderBrush="{ThemeResource TwFgD9B372Brush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Visibility="{x:Bind ViewModel.HasPendingLargePruneConfirmation, Mode=OneWay}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PendingLargePruneMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Style="{StaticResource GoldActionButtonStyle}" Content="确认执行删除" Command="{x:Bind ViewModel.ConfirmLargeUsbPruneCommand}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Style="{StaticResource StudioChipButtonStyle}" Content="本次跳过" Command="{x:Bind ViewModel.DismissLargeUsbPruneCommand}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{ThemeResource TwBg192130Brush}" BorderBrush="{ThemeResource TwLine263147Brush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="本机局域网服务地址（同一 Wi-Fi 下的手机可自动发现或手动填写）" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                <TextBlock Text="{x:Bind ViewModel.LanHostUrlsText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource TwFgE2E8F0Brush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                                <TextBlock Text="提示：首次开启时请在 Windows 防火墙弹窗允许专用网络通信（端口 45820）" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="6 位配对码" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind ViewModel.LanPairingCode, Mode=OneWay}" FontSize="22" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI" CharacterSpacing="120" Foreground="{ThemeResource TwFgD9B372Brush}" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Outbox Queue -->
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="发送队列（发送到手机）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                                                <TextBlock Text="{x:Bind ViewModel.LanOutboxSummaryText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource StudioChipButtonStyle}" Content="清空队列" Command="{x:Bind ViewModel.ClearLanOutboxCommand}" Visibility="{x:Bind ViewModel.HasLanOutboxItems, Mode=OneWay}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SyncOutboxItems, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SyncOutboxViewItem">
                                                    <Border Background="{ThemeResource TwBg192130Brush}" BorderBrush="{ThemeResource TwLine263147Brush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,2">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{ThemeResource TwBg252D3FBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind KindLabel}" FontSize="11" Foreground="{ThemeResource TwFgD9B372Brush}" FontWeight="SemiBold" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind DetailText}" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="{ThemeResource TwBg141A26Brush}" BorderBrush="{ThemeResource TwLine2A3447Brush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind ModeBadge}" FontSize="11" Foreground="{ThemeResource TwFgCBD5E1Brush}" />
                                                            </Border>
                                                            <Button Grid.Column="3" Content="移除" Padding="8,4" FontSize="11" Tag="{x:Bind Id}" Click="OnRemoveLanOutboxItemClick" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Paired Mobile Devices -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasPairedDevices, Mode=OneWay}">
                                        <TextBlock Text="已配对手机设备" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.PairedDevices, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PairedDeviceViewItem">
                                                    <Border Background="{ThemeResource TwBg192130Brush}" BorderBrush="{ThemeResource TwLine263147Brush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,2">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DeviceName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                                                                <TextBlock Text="{x:Bind LastSyncDisplay}" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="解除配对" Padding="8,4" FontSize="11" Tag="{x:Bind DeviceId}" Click="OnUnpairLanDeviceClick" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Text="5 个持久化场景队列槽位 (跨设备零延迟接续)" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" Margin="0,4,0,0" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SessionSlots, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="interop:SessionSlotDto">
                                                <Border Background="{ThemeResource TwBg192130Brush}" BorderBrush="{ThemeResource TwLine263147Brush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,2">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind SlotIndex}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                                                            <TextBlock Text="{x:Bind SceneId}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="保存当前队列" Padding="10,4" FontSize="12" Tag="{x:Bind SlotIndex}" Click="OnSaveSessionSlotClick" />
                                                        <Button Grid.Column="3" Content="恢复并播放" Padding="10,4" FontSize="12" Tag="{x:Bind SlotIndex}" Click="OnRestoreSessionSlotClick" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Sub-Tab: Last.fm Ledger -->
                            <Border Style="{StaticResource StudioCardStyle}" Visibility="{x:Bind ViewModel.IsSyncLastFmSubTab, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Last.fm 播放记录与 Loved tracks 双向同步" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                    <Border Background="{ThemeResource TwBg192130Brush}" BorderBrush="{ThemeResource TwLine263147Brush}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                        <TextBlock Text="{x:Bind ViewModel.LastFmAuthModeBadge, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{x:Bind ViewModel.LastFmLedgerStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource GoldActionButtonStyle}" Content="配置 / 浏览器授权 Last.fm…" Click="OnLastFmSetupClick" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="立即同步" Command="{x:Bind ViewModel.SyncLastFmLedgerCommand}" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="将本地 5 星回推至 Loved tracks" Command="{x:Bind ViewModel.BackfillLocalLovedToLastFmCommand}" IsEnabled="{x:Bind ViewModel.HasLastFmWriteSession, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Text="播放开始时自动上报 Now Playing，播满 50% 或 4 分钟（曲长 ≥ 30 秒）自动记录并推送 track.scrobble；点击红心或调整 5 星评分自动推送 track.love / track.unlove；离线记录最长保留 14 天待补传。" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Sub-Tab: USB Export -->
                            <Border Style="{StaticResource StudioCardStyle}" Visibility="{x:Bind ViewModel.IsSyncUsbSubTab, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="USB 车载导出" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                    <TextBlock Text="把当前筛选的曲目连同 .m3u8 歌单和车机兼容尺寸的封面，导出到 U 盘目录。" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource GoldActionButtonStyle}" Content="选择目标 U 盘 / 目录并立即导出..." Click="OnExportUsbCarClick" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- C) Settings Full Page -->
                    <ScrollViewer Visibility="{x:Bind ViewModel.IsSettingsViewVisible, Mode=OneWay}">
                        <StackPanel Spacing="12" Padding="0,8,0,16">

                            <!-- Sub-Tab: Audio & DSP -->
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsSettingsAudioSubTab, Mode=OneWay}">
                                <Border Style="{StaticResource StudioCardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="音频输出硬件与文件冲激" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                        <Grid ColumnSpacing="24" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="0" Header="锁定 DAC 硬件设置" IsOn="{x:Bind ViewModel.IsDacHardwareLocked, Mode=TwoWay}" />
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" Header="WASAPI 独占" IsOn="{x:Bind ViewModel.PreferWasapiExclusive, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDacHardwareUnlocked, Mode=OneWay}" />
                                            <ToggleSwitch Grid.Row="1" Grid.Column="0" Header="ISO 226 等响度补偿" IsOn="{x:Bind ViewModel.IsIso226Enabled, Mode=TwoWay}" />
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="24-bit TPDF 抖动" IsOn="{x:Bind ViewModel.IsTpdfDitherEnabled, Mode=TwoWay}" />
                                        </Grid>

                                        <ComboBox
                                            Width="420"
                                            Header="输出设备（按设备自动记忆 DSP 配置）"
                                            ItemsSource="{x:Bind ViewModel.OutputEndpoints, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedEndpoint, Mode=TwoWay}"
                                            DisplayMemberPath="FriendlyName"
                                            IsEnabled="{x:Bind ViewModel.IsDacHardwareUnlocked, Mode=OneWay}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="加载 Equalizer APO (.txt)" Click="OnLoadEqClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="加载 FIR / SOFA 卷积脉冲" Click="OnLoadFirClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="清除 FIR" Command="{x:Bind ViewModel.ClearFirImpulseCommand}" />
                                            <TextBlock Text="{x:Bind ViewModel.ActiveEqSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.FirImpulseFileName, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Spacing="4" MaxWidth="420">
                                            <TextBlock Text="数字衰减精调 (dB，与播放栏音量同步)" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                            <Slider Minimum="-60" Maximum="0" StepFrequency="0.5" Value="{x:Bind ViewModel.VolumeAttenuationDb, Mode=TwoWay}" AutomationProperties.Name="数字衰减 (dB)" />
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind ViewModel.SignalPathSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg10B981Brush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.SystemApoWarningText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgF59E0BBrush}" Visibility="{x:Bind ViewModel.HasSystemApoConflict, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <!-- Built-in 64-bit DSP + Crossfeed + Limiter + A/B -->
                                <Border Style="{StaticResource StudioCardStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="内置 64-Bit 参数均衡、耳机声场与 A/B 盲测" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1" Header="启用内置 DSP" IsOn="{x:Bind ViewModel.IsDspEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                                            <ToggleSwitch Grid.Column="2" Header="等响度 A/B 旁路" IsOn="{x:Bind ViewModel.IsGainMatchedBypass, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDspEnabled, Mode=OneWay}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="平直 (Flat)" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="Flat" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="开放耳机补偿" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="OpenEarBluetooth" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="深夜专注" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="FocusNight" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="古典 Crossfeed" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="ClassicalCrossfeed" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="归零 10 段 EQ" Command="{x:Bind ViewModel.ResetTenBandEqCommand}" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand0Db, Mode=TwoWay}" AutomationProperties.Name="31 Hz" /><TextBlock Text="31" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand0Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand1Db, Mode=TwoWay}" AutomationProperties.Name="62 Hz" /><TextBlock Text="62" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand1Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand2Db, Mode=TwoWay}" AutomationProperties.Name="125 Hz" /><TextBlock Text="125" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand2Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand3Db, Mode=TwoWay}" AutomationProperties.Name="250 Hz" /><TextBlock Text="250" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand3Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand4Db, Mode=TwoWay}" AutomationProperties.Name="500 Hz" /><TextBlock Text="500" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand4Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="5" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand5Db, Mode=TwoWay}" AutomationProperties.Name="1k Hz" /><TextBlock Text="1k" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand5Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand6Db, Mode=TwoWay}" AutomationProperties.Name="2k Hz" /><TextBlock Text="2k" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand6Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand7Db, Mode=TwoWay}" AutomationProperties.Name="4k Hz" /><TextBlock Text="4k" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand7Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="8" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand8Db, Mode=TwoWay}" AutomationProperties.Name="8k Hz" /><TextBlock Text="8k" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand8Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                            <StackPanel Grid.Column="9" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand9Db, Mode=TwoWay}" AutomationProperties.Name="16k Hz" /><TextBlock Text="16k" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand9Db), Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" /></StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="24" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="DSP 前级增益 Preamp (dB)" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                <Slider Minimum="-15" Maximum="6" StepFrequency="0.5" Value="{x:Bind ViewModel.DspPreampDb, Mode=TwoWay}" AutomationProperties.Name="DSP Preamp" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="左右声道平衡 (-L / +R dB)" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                <Slider Minimum="-6" Maximum="6" StepFrequency="0.5" Value="{x:Bind ViewModel.DspBalanceDb, Mode=TwoWay}" AutomationProperties.Name="左右声道平衡" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="Crossfeed 馈送强度 (dB)" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                <Slider Minimum="1.5" Maximum="9.5" StepFrequency="0.5" Value="{x:Bind ViewModel.CrossfeedFeedDb, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsCrossfeedEnabled, Mode=OneWay}" AutomationProperties.Name="Crossfeed 馈送" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="24">
                                            <ToggleSwitch Header="Bauer 耳机交叉馈送 (Crossfeed)" IsOn="{x:Bind ViewModel.IsCrossfeedEnabled, Mode=TwoWay}" />
                                            <ToggleSwitch Header="单声道折叠 (Mono)" IsOn="{x:Bind ViewModel.IsMonoFoldEnabled, Mode=TwoWay}" />
                                            <ToggleSwitch Header="防削波限幅器 (-0.2 dBFS)" IsOn="{x:Bind ViewModel.IsLimiterEnabled, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ReplayGain & Playback Behavior -->
                                <Border Style="{StaticResource StudioCardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="ReplayGain 回放增益与播放行为" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Header="ReplayGain 模式" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.ReplayGainMode, Mode=TwoWay}">
                                                <ComboBoxItem Content="动态智能（专辑用 Album / 其余 Track）" Tag="dynamic" />
                                                <ComboBoxItem Content="单曲增益 (Track)" Tag="track" />
                                                <ComboBoxItem Content="专辑增益 (Album)" Tag="album" />
                                                <ComboBoxItem Content="关闭 (Off)" Tag="off" />
                                            </ComboBox>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="含 RG 标签 PreAmp (dB)" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                <Slider Minimum="-15" Maximum="15" StepFrequency="0.5" Value="{x:Bind ViewModel.ReplayGainPreAmpWithTagDb, Mode=TwoWay}" AutomationProperties.Name="有标签 PreAmp" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="无 RG 标签 PreAmp (dB)" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                                <Slider Minimum="-15" Maximum="15" StepFrequency="0.5" Value="{x:Bind ViewModel.ReplayGainPreAmpWithoutTagDb, Mode=TwoWay}" AutomationProperties.Name="无标签 PreAmp" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="24" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="0" Header="上一曲优先重播当前曲（播放超过 3 秒时）" IsOn="{x:Bind ViewModel.RewindOnPrevious, Mode=TwoWay}" />
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" Header="切歌 / 点选队列时保持暂停状态" IsOn="{x:Bind ViewModel.RememberPauseOnSkip, Mode=TwoWay}" />
                                            <ToggleSwitch Grid.Row="1" Grid.Column="0" Header="单曲循环播完一次后自动暂停" IsOn="{x:Bind ViewModel.PauseOnSingleRepeat, Mode=TwoWay}" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Width="260" Header="WASAPI 独占暂停空闲自动释放声卡" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.ExclusiveIdleReleaseTag, Mode=TwoWay}">
                                                <ComboBoxItem Content="不自动释放" Tag="0" />
                                                <ComboBoxItem Content="暂停 5 分钟后释放" Tag="5" />
                                                <ComboBoxItem Content="暂停 15 分钟后释放（推荐）" Tag="15" />
                                                <ComboBoxItem Content="暂停 30 分钟后释放" Tag="30" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Sub-Tab: Storage -->
                            <Border Style="{StaticResource StudioCardStyle}" Visibility="{x:Bind ViewModel.IsSettingsStorageSubTab, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="曲库存储" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                    <TextBlock Text="{x:Bind ViewModel.MusicRootDisplayPath, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgE2E8F0Brush}" IsTextSelectionEnabled="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource GoldActionButtonStyle}" Content="切换 / 打开本地音乐目录..." Click="OnOpenFolderClick" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="重建曲库索引" Command="{x:Bind ViewModel.RebuildLibraryManifestCommand}" AutomationProperties.Name="重建曲库索引" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="文件夹整理" Command="{x:Bind ViewModel.OrganizeLibraryFoldersCommand}" AutomationProperties.Name="文件夹整理" ToolTipService.ToolTip="按 &lt;Album Artist&gt;\&lt;Album&gt;\&lt;Disc-Track#&gt; &lt;Title&gt; 整理散落与超长路径文件" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.StorageOrganizeStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                    <Border Height="1" Background="{ThemeResource TwBg242E42Brush}" Margin="0,2" />
                                    <ToggleSwitch
                                        Header="自动监测曲库文件变更"
                                        IsOn="{x:Bind ViewModel.EnableAutoWatchLibrary, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.FileWatcherStatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Sub-Tab: Metadata APIs & UI -->
                            <Border Style="{StaticResource StudioCardStyle}" Visibility="{x:Bind ViewModel.IsSettingsApisUiSubTab, Mode=OneWay}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="外观与导航" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                    <ComboBox
                                        x:Name="AppThemeCombo"
                                        Header="应用主题"
                                        MinWidth="220"
                                        SelectedValuePath="Tag"
                                        SelectedValue="{x:Bind ViewModel.AppTheme, Mode=TwoWay}">
                                        <ComboBoxItem Content="深色（默认）" Tag="dark" />
                                        <ComboBoxItem Content="浅色" Tag="light" />
                                        <ComboBoxItem Content="跟随系统" Tag="system" />
                                    </ComboBox>
                                    <TextBlock Text="Windows 对比度主题开启时自动切换为系统高对比度配色。" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                    <ToggleSwitch
                                        Header="始终在导航栏展开古典子项（作品 / 作曲家 / 指挥家）"
                                        IsOn="{x:Bind ViewModel.AlwaysExpandClassicalSubItems, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.ClassicalRatioText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />

                                    <Border Height="1" Background="{ThemeResource TwBg242E42Brush}" />
                                    <TextBlock Text="键盘快捷键" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgCBD5E1Brush}" />
                                    <TextBlock
                                        Text="Alt+1 曲库  |  Alt+2 艺人  |  Alt+3 古典  |  Alt+4 场景  |  Alt+5 歌单&#x0a;Alt+I 入库审校  |  Ctrl+, 设置  |  Ctrl+I 属性检查器  |  Ctrl+K 搜索&#x0a;T 五维打标  |  F2 编辑属性  |  Esc 还原未保存修改  |  Ctrl+P 播放/暂停  |  Ctrl+←/→ 上一曲/下一曲"
                                        FontSize="12"
                                        Foreground="{ThemeResource TwFg94A3B8Brush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
                </SplitView.Content>

                <!-- SPLITVIEW RIGHT PANE: GLOBAL SELECTION-BOUND PROPERTY INSPECTOR + INLINE F2 EDITOR -->
                <SplitView.Pane>
                    <Border BorderBrush="{ThemeResource TwLine222B3BBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="属性检查器" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnOpenLexiconTagMatrixClick" ToolTipService.ToolTip="五维打标 (T)" AutomationProperties.Name="打开五维打标浮层">
                                            <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                                        </Button>
                                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCloseInspectorClick" ToolTipService.ToolTip="关闭检查器 (Ctrl+I)" AutomationProperties.Name="关闭属性检查器">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Calm Empty State when nothing is selected -->
                                <Border
                                    Style="{StaticResource StudioCardStyle}"
                                    Padding="18,22"
                                    Visibility="{x:Bind ViewModel.HasNoInspectedTrack, Mode=OneWay}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="26" Foreground="{ThemeResource TwFg64748BBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="未选中曲目" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TwFgCBD5E1Brush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="选择左侧曲库中的任意曲目以检视声学参数、古典乐章信息并编辑标签" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Selected Track Core Details & 84x84 Artwork -->
                                <Border Style="{StaticResource StudioCardStyle}" Padding="10" Visibility="{x:Bind ViewModel.HasInspectedTrack, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Width="84"
                                                Height="84"
                                                Background="{ThemeResource TwBg141A26Brush}"
                                                BorderBrush="{ThemeResource TwLine293448Brush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                VerticalAlignment="Top">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{ThemeResource TwFg64748BBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image x:Name="InspectedCoverImage" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.InspectorHeaderTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ViewModel.InspectorHeaderSubtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ViewModel.InspectorHeaderSubline, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="InlineTrackTechSummaryText" Text="{x:Bind ViewModel.InspectedTrack.SpecsDisplay, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.InspectedTrack.RelPath, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <Border Background="{ThemeResource TwBg1A2232Brush}" BorderBrush="{ThemeResource TwLine2A3447Brush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="{x:Bind NonEmptyVisibility(ViewModel.InspectedTrack.SceneBadge), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.InspectedTrack.SceneBadge, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                            </Border>
                                            <Border Background="{ThemeResource TwBg1A2232Brush}" BorderBrush="{ThemeResource TwLine2A3447Brush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="{x:Bind NonEmptyVisibility(ViewModel.InspectedTrack.EnergyBadge), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.InspectedTrack.EnergyBadge, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" />
                                            </Border>
                                            <Border Background="{ThemeResource TwBg1A2232Brush}" BorderBrush="{ThemeResource TwLine2A3447Brush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="{x:Bind NonEmptyVisibility(ViewModel.InspectedTrack.TempoDisplay), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.InspectedTrack.TempoDisplay, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Inline Metadata & 5D Tags Editor: grouped Expanders, native NumberBox / RatingControl, dirty tracking -->
                                <Border x:Name="InspectorInlineEditorCard" Style="{StaticResource StudioCardStyle}" Padding="10" KeyDown="OnInspectorEditorKeyDown" Visibility="{x:Bind ViewModel.HasInspectedTrack, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="InlineEditModeText" Text="未选中曲目" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" TextWrapping="Wrap" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="InlineFetchBasicInfoButton"
                                                Grid.Column="0"
                                                Style="{StaticResource StudioChipButtonStyle}"
                                                Content="获取缺失基础信息"
                                                Click="OnFetchMissingBasicInfoClick"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="从路径及公开源仅补全选中曲目缺失的基础属性与封面（不覆盖已有值）" />
                                            <Button
                                                x:Name="InlineFetch5DTagsButton"
                                                Grid.Column="1"
                                                Style="{StaticResource StudioChipButtonStyle}"
                                                Content="获取缺失五维标签"
                                                Click="OnFetchMissing5DTagsClick"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="本地声学分析并仅补全选中曲目缺失的 BPM / 能量 / 人声 / 情绪 / 场景" />
                                        </Grid>

                                        <Expander x:Name="InlineBasicExpander" Header="基础信息" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="8">
                                                <TextBox x:Name="InlineTitleBox" Header="标题" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                <TextBox x:Name="InlineArtistsBox" Header="艺人（多人用 ; 或 / 分隔）" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                <TextBox x:Name="InlineAlbumBox" Header="专辑" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="InlineYearBox" Grid.Column="0" Header="年份" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                    <TextBox x:Name="InlineGenreBox" Grid.Column="1" Header="流派" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                </Grid>
                                                <TextBox x:Name="InlinePublisherBox" Header="唱片厂牌" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Name="InlineClassicalExpander" Header="古典信息" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="8">
                                                <TextBox x:Name="InlineComposersBox" Header="作曲家（; 分隔）" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                <TextBox x:Name="InlineConductorsBox" Header="指挥家（; 分隔）" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                <TextBox x:Name="InlineWorkBox" Header="作品" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                <TextBox x:Name="InlineMovementBox" Header="乐章" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Name="InlineCurationExpander" Header="五维标签" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <NumberBox
                                                        x:Name="InlineTempoBpmBox"
                                                        Grid.Column="0"
                                                        Header="BPM"
                                                        Minimum="20"
                                                        Maximum="300"
                                                        SmallChange="1"
                                                        LargeChange="10"
                                                        SpinButtonPlacementMode="Compact"
                                                        ValidationMode="InvalidInputOverwritten"
                                                        ValueChanged="OnInlineNumberBoxValueChanged" />
                                                    <ComboBox x:Name="InlineTempoBucketCombo" Grid.Column="1" Header="节奏分档" HorizontalAlignment="Stretch" SelectionChanged="OnInlineFieldSelectionChanged">
                                                        <ComboBoxItem x:Name="InlineTempoBucketKeepItem" Content="（保持原值）" Tag="__keep__" />
                                                        <ComboBoxItem Content="（未设置）" Tag="" />
                                                        <ComboBoxItem Content="Very Slow" Tag="Very Slow" />
                                                        <ComboBoxItem Content="Slow" Tag="Slow" />
                                                        <ComboBoxItem Content="Moderate" Tag="Moderate" />
                                                        <ComboBoxItem Content="Fast" Tag="Fast" />
                                                        <ComboBoxItem Content="Very Fast" Tag="Very Fast" />
                                                    </ComboBox>
                                                </Grid>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="InlineVocalsCombo" Grid.Column="0" Header="人声" HorizontalAlignment="Stretch" SelectionChanged="OnInlineFieldSelectionChanged">
                                                        <ComboBoxItem x:Name="InlineVocalsKeepItem" Content="（保持原值）" Tag="__keep__" />
                                                        <ComboBoxItem Content="未知" Tag="unknown" />
                                                        <ComboBoxItem Content="纯器乐" Tag="instrumental" />
                                                        <ComboBoxItem Content="含人声" Tag="vocal" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="InlineEnergyCombo" Grid.Column="1" Header="能量" HorizontalAlignment="Stretch" SelectionChanged="OnInlineFieldSelectionChanged">
                                                        <ComboBoxItem x:Name="InlineEnergyKeepItem" Content="（保持原值）" Tag="__keep__" />
                                                        <ComboBoxItem Content="（未设置）" Tag="" />
                                                        <ComboBoxItem Content="低" Tag="low" />
                                                        <ComboBoxItem Content="中" Tag="medium" />
                                                        <ComboBoxItem Content="高" Tag="high" />
                                                    </ComboBox>
                                                </Grid>

                                                <AutoSuggestBox
                                                    x:Name="InlineSceneBox"
                                                    Header="场景（; 分隔，输入时联想已有标签）"
                                                    TextChanged="OnInlineTagBoxTextChanged"
                                                    SuggestionChosen="OnInlineTagBoxSuggestionChosen"
                                                    QuerySubmitted="OnInlineTagBoxQuerySubmitted" />
                                                <AutoSuggestBox
                                                    x:Name="InlineMoodBox"
                                                    Header="情绪（; 分隔，输入时联想已有标签）"
                                                    TextChanged="OnInlineTagBoxTextChanged"
                                                    SuggestionChosen="OnInlineTagBoxSuggestionChosen"
                                                    QuerySubmitted="OnInlineTagBoxQuerySubmitted" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="星级" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" />
                                                    <RatingControl
                                                        x:Name="InlineRatingControl"
                                                        MaxRating="5"
                                                        IsClearEnabled="True"
                                                        HorizontalAlignment="Left"
                                                        AutomationProperties.Name="星级"
                                                        ValueChanged="OnInlineRatingValueChanged" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="InlineSaveButton"
                                                Grid.Column="0"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Content="保存"
                                                IsEnabled="False"
                                                HorizontalAlignment="Stretch"
                                                Click="OnSaveInlineInspectorMetadataClick" />
                                            <Button
                                                x:Name="InlineRevertButton"
                                                Grid.Column="1"
                                                Content="还原"
                                                IsEnabled="False"
                                                ToolTipService.ToolTip="放弃未保存的修改 (Esc)"
                                                Click="OnRevertInlineInspectorClick" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Valence Credit Chips -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="相关人物（点击筛选）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Content="{x:Bind ViewModel.InspectedComposerChip, Mode=OneWay}"
                                            Tag="{x:Bind ViewModel.InspectedComposerChip, Mode=OneWay}"
                                            Click="OnCreditChipClick"
                                            Visibility="{x:Bind ViewModel.HasInspectedComposer, Mode=OneWay}" />
                                        <Button
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Content="{x:Bind ViewModel.InspectedConductorChip, Mode=OneWay}"
                                            Tag="{x:Bind ViewModel.InspectedConductorChip, Mode=OneWay}"
                                            Click="OnCreditChipClick"
                                            Visibility="{x:Bind ViewModel.HasInspectedConductor, Mode=OneWay}" />
                                        <Button
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Content="{x:Bind ViewModel.InspectedPublisherChip, Mode=OneWay}"
                                            Tag="{x:Bind ViewModel.InspectedPublisherChip, Mode=OneWay}"
                                            Click="OnCreditChipClick"
                                            Visibility="{x:Bind ViewModel.HasInspectedPublisher, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Alternate Classical Recordings A/B Comparison -->
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasAlternateRecordings, Mode=OneWay}">
                                    <TextBlock Text="同乐章多录音版本 · 原位 A/B 切换" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AlternateRecordings, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TrackItem">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="{ThemeResource TwBg172030Brush}"
                                                    BorderBrush="{ThemeResource TwLine2C384FBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9,6"
                                                    Margin="0,2"
                                                    Tag="{x:Bind TrackUid}"
                                                    Click="OnSwitchAlternateRecordingClick">
                                                    <TextBlock Text="{x:Bind AlternateVersionLabel}" FontSize="12" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextWrapping="Wrap" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Local Encyclopedia Summary -->
                                <Border Style="{StaticResource StudioCardStyle}" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="百科传记" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFg94A3B8Brush}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentBiographySummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgCBD5E1Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Digital Booklet PDF Preview -->
                                <Border Style="{StaticResource StudioCardStyle}" Padding="10" Visibility="{x:Bind ViewModel.HasBookletPdf, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BookletPageStatusText" Grid.Column="0" Text="数字册页" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Padding="6,4" Click="OnBookletPrevClick" AutomationProperties.Name="上一页数字册页" ToolTipService.ToolTip="上一页">
                                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="2" Padding="6,4" Margin="4,0" Click="OnBookletNextClick" AutomationProperties.Name="下一页数字册页" ToolTipService.ToolTip="下一页">
                                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="3" Content="剧场大图" Padding="8,2" FontSize="12" Click="OnOpenBookletTheaterClick" AutomationProperties.Name="打开数字册页剧场大图" />
                                        </Grid>
                                        <Image x:Name="BookletPageImage" MaxHeight="240" Stretch="Uniform" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </SplitView.Pane>
            </SplitView>
        </NavigationView>

        <!-- ROW 2: OBSIDIAN MASTER TRANSPORT BAR -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource TwBgCC090C12Brush}"
            BorderBrush="{ThemeResource TwLine222B3BBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="336" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Now Playing Artwork + Clickable Info + Heart Love -->
                <Grid Grid.Column="0" Width="328" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="52"
                        Height="52"
                        Padding="0"
                        Background="{ThemeResource TwBg141A26Brush}"
                        BorderBrush="{ThemeResource TwLine293448Brush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Click="OnTransportTrackInfoClick"
                        ToolTipService.ToolTip="定位当前曲目并查看属性">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{ThemeResource TwFg64748BBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="TransportCoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Click="OnTransportTrackInfoClick"
                            ToolTipService.ToolTip="检视当前曲目与所属专辑">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay, FallbackValue='未在播放'}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Click="OnTransportArtistClick"
                            ToolTipService.ToolTip="筛选此艺人的全部曲目">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ArtistsDisplay, Mode=OneWay, FallbackValue='双击任意曲目开始播放'}" FontSize="12" Foreground="{ThemeResource TwFg94A3B8Brush}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrackSpecsSubline, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFgD9B372Brush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="17"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleCurrentTrackLovedCommand}"
                        AutomationProperties.Name="喜爱或取消喜爱当前曲目"
                        ToolTipService.ToolTip="喜爱 / 取消喜爱（实时推送至 Last.fm Loved tracks）">
                        <FontIcon
                            Glyph="{x:Bind HeartGlyph(ViewModel.CurrentTrackLoved), Mode=OneWay}"
                            FontSize="16"
                            Foreground="{x:Bind HeartForeground(ViewModel.CurrentTrackLoved), Mode=OneWay}" />
                    </Button>
                </Grid>

                <!-- DJ Freeze Capsule + Queue Flyout + Signal Purity LED / Acoustic Rack Flyout -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button
                        Visibility="{x:Bind ViewModel.HasFreezeCapsule, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleDjFreezeCommand}"
                        Background="{x:Bind FreezePillBackground(ViewModel.IsDjFreezeActive), Mode=OneWay}"
                        BorderBrush="{x:Bind FreezePillBorder(ViewModel.IsDjFreezeActive), Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="一键锁定当前氛围展开临时队列，再点还原原队列">
                        <TextBlock Text="{x:Bind ViewModel.CurrentFreezeCapsuleLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                    </Button>

                    <Button
                        x:Name="PlaybackQueueButton"
                        Click="OnOpenPlaybackQueueClick"
                        Background="{ThemeResource TwBg141A26Brush}"
                        BorderBrush="{ThemeResource TwLine293448Brush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="查看当前播放列表"
                        ToolTipService.ToolTip="查看、拖拽排序或管理当前播放队列">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="PlaybackQueueFlyout" Placement="TopEdgeAlignedRight">
                                <StackPanel Spacing="8" Width="420">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PlaybackQueueSummary, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.ShuffleModeLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleShuffleCommand}" Padding="8,4" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.RepeatModeLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CycleRepeatModeCommand}" Padding="8,4" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- 5 Persistent Scene Slots Quick Switcher -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.QueueSlotChips, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:QueueSlotChipItem">
                                                <Button
                                                    Padding="8,3"
                                                    CornerRadius="12"
                                                    Background="{ThemeResource TwBg141A26Brush}"
                                                    BorderBrush="{ThemeResource TwLine293448Brush}"
                                                    BorderThickness="1"
                                                    Tag="{x:Bind SlotIndex}"
                                                    ToolTipService.ToolTip="{x:Bind TooltipText}"
                                                    Click="OnQuickQueueSlotChipClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource TwFgD9B372Brush}" Visibility="{x:Bind IsActive}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind Label}" FontSize="11" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Style="{StaticResource GoldActionButtonStyle}" Content="载入当前筛选列表" Command="{x:Bind ViewModel.LoadCurrentViewToQueueCommand}" Padding="10,5" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="清空队列" Command="{x:Bind ViewModel.ClearPlaybackQueueCommand}" Padding="10,5" />
                                    </StackPanel>
                                    <ListView
                                        x:Name="PlaybackQueueListView"
                                        ItemsSource="{x:Bind ViewModel.PlaybackQueue, Mode=OneWay}"
                                        CanReorderItems="True"
                                        AllowDrop="True"
                                        ContainerContentChanging="OnQueueListContainerContentChanging"
                                        DragItemsCompleted="OnPlaybackQueueDragItemsCompleted"
                                        MaxHeight="340"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TrackItem">
                                                <Grid ColumnSpacing="8" Padding="2,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon x:Name="QueuePlayingGlyph" Grid.Column="0" Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource TwFgD9B372Brush}" Visibility="Collapsed" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock x:Name="QueueTitleText" Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind ArtistsDisplay}" FontSize="11" Foreground="{ThemeResource TwFg94A3B8Brush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Padding="6,4" Background="Transparent" BorderThickness="0" Click="OnPlayQueueTrackClick" ToolTipService.ToolTip="立即播放" AutomationProperties.Name="从队列播放此曲目">
                                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                    </Button>
                                                    <Button Grid.Column="3" Padding="6,4" Background="Transparent" BorderThickness="0" Click="OnRemoveQueueTrackClick" ToolTipService.ToolTip="从队列移除" AutomationProperties.Name="从队列移除此曲目">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE90B;" FontSize="13" Foreground="{ThemeResource TwFgD9B372Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PlaybackQueueSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SignalPathRackButton"
                        Click="OnOpenAcousticRackClick"
                        Background="{ThemeResource TwBg141A26Brush}"
                        BorderBrush="{ThemeResource TwLine293448Brush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="打开声学信号链路与 DSP 机架面板">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="AcousticRackFlyout">
                                <StackPanel Spacing="10" Width="360">
                                    <TextBlock Text="信号链路与快速声学机架" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TwFgD9B372Brush}" />
                                    <ToggleSwitch Header="锁定 DAC 硬件设置" IsOn="{x:Bind ViewModel.IsDacHardwareLocked, Mode=TwoWay}" />
                                    <ToggleSwitch Header="WASAPI 独占（绕过系统混音）" IsOn="{x:Bind ViewModel.PreferWasapiExclusive, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDacHardwareUnlocked, Mode=OneWay}" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        Header="输出设备"
                                        ItemsSource="{x:Bind ViewModel.OutputEndpoints, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedEndpoint, Mode=TwoWay}"
                                        DisplayMemberPath="FriendlyName"
                                        IsEnabled="{x:Bind ViewModel.IsDacHardwareUnlocked, Mode=OneWay}" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        Header="ReplayGain 模式"
                                        SelectedValuePath="Tag"
                                        SelectedValue="{x:Bind ViewModel.ReplayGainMode, Mode=TwoWay}">
                                        <ComboBoxItem Content="动态智能 (Dynamic)" Tag="dynamic" />
                                        <ComboBoxItem Content="单曲增益 (Track)" Tag="track" />
                                        <ComboBoxItem Content="专辑增益 (Album)" Tag="album" />
                                        <ComboBoxItem Content="关闭 (Off)" Tag="off" />
                                    </ComboBox>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch Grid.Column="0" Header="内置 DSP" IsOn="{x:Bind ViewModel.IsDspEnabled, Mode=TwoWay}" />
                                        <ToggleSwitch Grid.Column="1" Header="等响度 A/B 旁路" IsOn="{x:Bind ViewModel.IsGainMatchedBypass, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDspEnabled, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch Grid.Column="0" Header="耳机 Crossfeed" IsOn="{x:Bind ViewModel.IsCrossfeedEnabled, Mode=TwoWay}" />
                                        <ToggleSwitch Grid.Column="1" Header="ISO 226 等响度" IsOn="{x:Bind ViewModel.IsIso226Enabled, Mode=TwoWay}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="Flat" Padding="8,4" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="Flat" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="开放耳机" Padding="8,4" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="OpenEarBluetooth" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="深夜" Padding="8,4" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="FocusNight" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="古典声场" Padding="8,4" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="ClassicalCrossfeed" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="加载 EQ (.txt)" Click="OnLoadEqClick" />
                                        <Button Content="加载 FIR / SOFA" Click="OnLoadFirClick" />
                                        <Button Content="清除 FIR" Command="{x:Bind ViewModel.ClearFirImpulseCommand}" />
                                    </StackPanel>
                                    <ToggleSwitch Header="24-bit TPDF 抖动" IsOn="{x:Bind ViewModel.IsTpdfDitherEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SignalPathSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TwFg10B981Brush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="SignalPurityDot" Width="8" Height="8" Fill="{ThemeResource TwFg10B981Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SignalPurityLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TwFgE2E8F0Brush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Transport Controls (Shuffle / Prev / PlayPause / Next / Repeat) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        x:Name="ShuffleModeButton"
                        Width="34"
                        Height="36"
                        Padding="0"
                        CornerRadius="17"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                        Opacity="{x:Bind ShuffleOpacity(ViewModel.IsShuffleEnabled), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.ShuffleModeLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ShuffleModeLabel, Mode=OneWay}">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource TwFgD9B372Brush}" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.IsShuffleEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.PreviousTrackCommand}" AutomationProperties.Name="上一曲" ToolTipService.ToolTip="上一曲 (Ctrl+←)">
                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                    </Button>
                    <Button
                        Width="44"
                        Height="44"
                        Padding="0"
                        CornerRadius="22"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        AutomationProperties.Name="{x:Bind PlayPauseAutomationName(ViewModel.IsPlaying), Mode=OneWay}"
                        ToolTipService.ToolTip="播放 / 暂停 (Ctrl+P)">
                        <FontIcon Glyph="{x:Bind PlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="18" />
                    </Button>
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.NextTrackCommand}" AutomationProperties.Name="下一曲" ToolTipService.ToolTip="下一曲 (Ctrl+→)">
                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                    </Button>
                    <Button
                        x:Name="RepeatModeButton"
                        Width="34"
                        Height="36"
                        Padding="0"
                        CornerRadius="17"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.CycleRepeatModeCommand}"
                        Opacity="{x:Bind RepeatOpacity(ViewModel.RepeatMode), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.RepeatModeLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RepeatModeLabel, Mode=OneWay}">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind RepeatGlyph(ViewModel.RepeatMode), Mode=OneWay}" FontSize="14" />
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource TwFgD9B372Brush}" HorizontalAlignment="Center" Visibility="{x:Bind IsRepeatIndicatorVisible(ViewModel.RepeatMode), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Waveform + keyboard-accessible Seek Slider overlay + Time -->
                <Grid Grid.Column="2" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Height="44">
                        <Border Background="{ThemeResource TwBg121722Brush}" BorderBrush="{ThemeResource TwLine202838Brush}" BorderThickness="1" CornerRadius="6" Padding="4,2">
                            <skia:SKXamlCanvas
                                x:Name="WaveformCanvas"
                                IsHitTestVisible="False"
                                PaintSurface="OnPaintWaveform" />
                        </Border>
                        <Slider
                            x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="1"
                            SmallChange="5"
                            LargeChange="30"
                            VerticalAlignment="Center"
                            Margin="4,0"
                            IsThumbToolTipEnabled="True"
                            ThumbToolTipValueConverter="{StaticResource SecondsToClockConverter}"
                            ValueChanged="OnSeekSliderValueChanged"
                            AutomationProperties.Name="播放进度（秒）"
                            ToolTipService.ToolTip="拖动或用方向键定位播放进度（←/→ 5 秒，PgUp/PgDn 30 秒）">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource TwFg94A3B8Brush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Sleep Timer + Mute + Volume (0-100%, dB in tooltip) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        Padding="8,4"
                        CornerRadius="12"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource TwLine202838Brush}"
                        AutomationProperties.Name="睡眠定时"
                        ToolTipService.ToolTip="睡眠定时（倒计时 / 本曲 / 本作品结束）">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="关闭睡眠定时" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="off" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="15 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="15" />
                                <MenuFlyoutItem Text="30 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="30" />
                                <MenuFlyoutItem Text="45 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="45" />
                                <MenuFlyoutItem Text="60 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="60" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="本曲结束后暂停" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="track" />
                                <MenuFlyoutItem Text="本古典作品结束后暂停" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="work" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE708;" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.SleepTimerBadge, Mode=OneWay}"
                                       FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                       Foreground="{ThemeResource TwFgD9B372Brush}"
                                       Visibility="{x:Bind ViewModel.IsSleepTimerActive, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{x:Bind ViewModel.IsMuted, Mode=TwoWay}"
                        AutomationProperties.Name="静音"
                        ToolTipService.ToolTip="{x:Bind ViewModel.VolumeToolTip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind VolumeGlyph(ViewModel.IsMuted, ViewModel.VolumePercent), Mode=OneWay}" FontSize="16" />
                    </ToggleButton>
                    <Slider
                        Width="110"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="1"
                        SmallChange="2"
                        LargeChange="10"
                        VerticalAlignment="Center"
                        Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}"
                        AutomationProperties.Name="音量（百分比）"
                        ToolTipService.ToolTip="{x:Bind ViewModel.VolumeToolTip, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
