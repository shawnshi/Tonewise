                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.SignalPathBadge, Mode=OneWay}"
                                            FontSize="12"
                                            FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                            Foreground="{ThemeResource ZuneStatusSuccessBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border
                                    BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button
                                            Style="{StaticResource ZuneGalleryActionButtonStyle}"
                                            Click="OnTransportArtistClick"
                                            AutomationProperties.Name="查看艺人"
                                            ToolTipService.ToolTip="在馆藏中查看艺人">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" />
                                                <TextBlock Text="查看艺人" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="NowPlayingComposerButton"
                                            Style="{StaticResource ZuneGalleryActionButtonStyle}"
                                            Click="OnTransportComposerClick"
                                            Visibility="{x:Bind ViewModel.ShowNowPlayingComposerAction, Mode=OneWay}"
                                            AutomationProperties.Name="查看作曲"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.NowPlayingComposerTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" />
                                                <TextBlock Text="查看作曲" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="NowPlayingConductorButton"
                                            Style="{StaticResource ZuneGalleryActionButtonStyle}"
                                            Click="OnTransportConductorClick"
                                            Visibility="{x:Bind ViewModel.ShowNowPlayingConductorAction, Mode=OneWay}"
                                            AutomationProperties.Name="查看指挥"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.NowPlayingConductorTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7F6;" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" />
                                                <TextBlock Text="查看指挥" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource ZuneGalleryActionButtonStyle}"
                                            Click="OnTransportTrackInfoClick"
                                            AutomationProperties.Name="编辑属性"
                                            ToolTipService.ToolTip="检视与编辑属性 (Ctrl+I)">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                <TextBlock Text="编辑属性" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource ZuneGalleryActionButtonStyle}"
                                            Command="{x:Bind ViewModel.PinCurrentTrackAlbumToQuickplayCommand}"
                                            AutomationProperties.Name="固定到 quickplay"
                                            ToolTipService.ToolTip="固定到 quickplay">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE718;" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                <TextBlock Text="固定" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource ZuneGalleryActionButtonStyle}"
                                            Click="OnOpenBookletTheaterClick"
                                            Visibility="{x:Bind ViewModel.HasBookletPdf, Mode=OneWay}"
                                            AutomationProperties.Name="剧场数字册页"
                                            ToolTipService.ToolTip="剧场数字册页">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE82D;" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                <TextBlock Text="数字册页" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right Translucent Gallery Panel: Up Next / Booklet / Alternate Recordings (Collapsible) -->
                            <Border
                                x:Name="NowPlayingQueuePanel"
                                Grid.Column="1"
                                Width="360"
                                Background="{ThemeResource ZuneSurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                BorderThickness="1"
                                Opacity="0.90"
                                Padding="16"
                                Visibility="{x:Bind ViewModel.IsNowPlayingQueueOpen, Mode=OneWay}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="upnext" Click="OnNowPlayingPanelTabClick">
                                                <TextBlock Text="up next" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" Opacity="{x:Bind PivotInkOpacity(ViewModel.IsNowPlayingUpNextTab), Mode=OneWay}" />
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="booklet" Click="OnNowPlayingPanelTabClick" Visibility="{x:Bind ViewModel.HasBookletPdf, Mode=OneWay}">
                                                <TextBlock Text="booklet" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" Opacity="{x:Bind PivotInkOpacity(ViewModel.IsNowPlayingBookletTab), Mode=OneWay}" />
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="alternates" Click="OnNowPlayingPanelTabClick" Visibility="{x:Bind ViewModel.HasAlternateRecordings, Mode=OneWay}">
                                                <TextBlock Text="recordings" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" Opacity="{x:Bind PivotInkOpacity(ViewModel.IsNowPlayingAlternatesTab), Mode=OneWay}" />
                                            </Button>
                                        </StackPanel>
                                        <Button
                                            x:Name="NowPlayingQueueCollapseButton"
                                            Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ViewModel.ToggleNowPlayingQueueCommand}"
                                            AutomationProperties.Name="收起播放列表"
                                            ToolTipService.ToolTip="收起播放列表">
                                            <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                        </Button>
                                    </Grid>

                                    <ListView
                                        x:Name="NowPlayingUpNextListView"
                                        Grid.Row="1"
                                        ItemsSource="{x:Bind ViewModel.PlaybackQueue, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsNowPlayingUpNextTab, Mode=OneWay}"
                                        ContainerContentChanging="OnQueueListContainerContentChanging"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TrackItem">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="4,6"
                                                    Click="OnPlayQueueTrackClick"
                                                    AutomationProperties.Name="{x:Bind AccessibilitySummary}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon x:Name="QueuePlayingGlyph" Grid.Column="0" Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource ZuneAccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock x:Name="QueueTitleText" Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind ArtistsDisplay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind DurationDisplay}" FontSize="12" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource ZuneInkTertiaryBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.IsNowPlayingBookletTab, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource ZuneFlatButtonStyle}" Content="上一页" Click="OnBookletPrevClick" />
                                            <Button Style="{StaticResource ZuneFlatButtonStyle}" Content="下一页" Click="OnBookletNextClick" />
                                            <TextBlock x:Name="NowPlayingBookletStatusText" Text="数字册页" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Image x:Name="NowPlayingBookletImage" MaxHeight="380" Stretch="Uniform" />
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" Visibility="{x:Bind ViewModel.IsNowPlayingAlternatesTab, Mode=OneWay}">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AlternateRecordings, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="6" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:TrackItem">
                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Style="{StaticResource ZuneFlatButtonStyle}"
                                                        Tag="{x:Bind TrackUid}"
                                                        Click="OnSwitchAlternateRecordingClick"
                                                        AutomationProperties.Name="{x:Bind AlternateVersionLabel}">
                                                        <TextBlock Text="{x:Bind AlternateVersionLabel}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Floating Queue Expand Pill when Collapsed -->
                        <Button
                            x:Name="NowPlayingQueueExpandButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,24,24,0"
                            Style="{StaticResource ZuneFlatButtonStyle}"
                            Opacity="0.92"
                            Visibility="{x:Bind NegateToVisibility(ViewModel.IsNowPlayingQueueOpen), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleNowPlayingQueueCommand}"
                            AutomationProperties.Name="展开播放列表"
                            ToolTipService.ToolTip="展开播放列表">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" />
                                <TextBlock Text="up next" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PlaybackQueueSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </SplitView.Content>

            <!-- SPLITVIEW RIGHT PANE: GLOBAL SELECTION-BOUND PROPERTY INSPECTOR + INLINE F2 EDITOR -->
            <SplitView.Pane>
                <Border BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="属性检查器" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="InspectorLexiconTagButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnOpenLexiconTagMatrixClick" ToolTipService.ToolTip="五维打标 (T)" AutomationProperties.Name="打开五维打标浮层">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                                    </Button>
                                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCloseInspectorClick" ToolTipService.ToolTip="关闭检查器 (Ctrl+I)" AutomationProperties.Name="关闭属性检查器">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border
                                Style="{StaticResource StudioCardStyle}"
                                Padding="12,18"
                                Visibility="{x:Bind ViewModel.HasNoInspectedTrack, Mode=OneWay}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="26" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="未选中曲目" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="选择曲库中的任意曲目以检视声学参数、古典乐章信息并编辑标签" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StudioCardStyle}" Padding="0,10,0,10" Visibility="{x:Bind ViewModel.HasInspectedTrack, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="84"
                                            Height="84"
                                            Background="{ThemeResource ZuneSurfaceElevatedBrush}"
                                            BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Top">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image x:Name="InspectedCoverImage" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.InspectorHeaderTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.InspectorHeaderSubtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.InspectorHeaderSubline, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="InlineTrackTechSummaryText" Text="{x:Bind ViewModel.InspectedTrack.SpecsDisplay, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.InspectedTrack.RelPath, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                        <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="6,2" Visibility="{x:Bind NonEmptyVisibility(ViewModel.InspectedTrack.SceneBadge), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.InspectedTrack.SceneBadge, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" />
                                        </Border>
                                        <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="6,2" Visibility="{x:Bind NonEmptyVisibility(ViewModel.InspectedTrack.EnergyBadge), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.InspectedTrack.EnergyBadge, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                        </Border>
                                        <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="6,2" Visibility="{x:Bind NonEmptyVisibility(ViewModel.InspectedTrack.TempoDisplay), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.InspectedTrack.TempoDisplay, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="InspectorInlineEditorCard" Style="{StaticResource StudioCardStyle}" Padding="0,10,0,10" KeyDown="OnInspectorEditorKeyDown" Visibility="{x:Bind ViewModel.HasInspectedTrack, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="InlineEditModeText" Text="未选中曲目" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="InlineFetchBasicInfoButton"
                                            Grid.Column="0"
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Content="获取缺失基础信息"
                                            Click="OnFetchMissingBasicInfoClick"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="从路径及公开源仅补全选中曲目缺失的基础属性与封面（不覆盖已有值）" />
                                        <Button
                                            x:Name="InlineFetch5DTagsButton"
                                            Grid.Column="1"
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Content="获取缺失五维标签"
                                            Click="OnFetchMissing5DTagsClick"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="本地声学分析并仅补全选中曲目缺失的 BPM / 能量 / 人声 / 情绪 / 场景" />
                                    </Grid>

                                    <Expander x:Name="InlineBasicExpander" Header="基础信息" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBox x:Name="InlineTitleBox" Header="标题" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            <TextBox x:Name="InlineArtistsBox" Header="艺人（多人用 ; 或 / 分隔）" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            <TextBox x:Name="InlineAlbumBox" Header="专辑" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="InlineYearBox" Grid.Column="0" Header="年份" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                                <TextBox x:Name="InlineGenreBox" Grid.Column="1" Header="流派" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            </Grid>
                                            <TextBox x:Name="InlinePublisherBox" Header="唱片厂牌" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="InlineClassicalExpander" Header="古典信息" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBox x:Name="InlineComposersBox" Header="作曲家（; 分隔）" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            <TextBox x:Name="InlineConductorsBox" Header="指挥家（; 分隔）" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            <TextBox x:Name="InlineWorkBox" Header="作品" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                            <TextBox x:Name="InlineMovementBox" Header="乐章" KeyDown="OnInlineEditorFieldKeyDown" TextChanged="OnInlineFieldTextChanged" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="InlineCurationExpander" Header="五维标签" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox
                                                    x:Name="InlineTempoBpmBox"
                                                    Grid.Column="0"
                                                    Header="BPM"
                                                    Minimum="20"
                                                    Maximum="300"
                                                    SmallChange="1"
                                                    LargeChange="10"
                                                    SpinButtonPlacementMode="Compact"
                                                    ValidationMode="InvalidInputOverwritten"
                                                    ValueChanged="OnInlineNumberBoxValueChanged" />
                                                <ComboBox x:Name="InlineTempoBucketCombo" Grid.Column="1" Header="节奏分档" HorizontalAlignment="Stretch" SelectionChanged="OnInlineFieldSelectionChanged">
                                                    <ComboBoxItem x:Name="InlineTempoBucketKeepItem" Content="（保持原值）" Tag="__keep__" />
                                                    <ComboBoxItem Content="（未设置）" Tag="" />
                                                    <ComboBoxItem Content="Very Slow" Tag="Very Slow" />
                                                    <ComboBoxItem Content="Slow" Tag="Slow" />
                                                    <ComboBoxItem Content="Moderate" Tag="Moderate" />
                                                    <ComboBoxItem Content="Fast" Tag="Fast" />
                                                    <ComboBoxItem Content="Very Fast" Tag="Very Fast" />
                                                </ComboBox>
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="InlineVocalsCombo" Grid.Column="0" Header="人声" HorizontalAlignment="Stretch" SelectionChanged="OnInlineFieldSelectionChanged">
                                                    <ComboBoxItem x:Name="InlineVocalsKeepItem" Content="（保持原值）" Tag="__keep__" />
                                                    <ComboBoxItem Content="未知" Tag="unknown" />
                                                    <ComboBoxItem Content="纯器乐" Tag="instrumental" />
                                                    <ComboBoxItem Content="含人声" Tag="vocal" />
                                                </ComboBox>
                                                <ComboBox x:Name="InlineEnergyCombo" Grid.Column="1" Header="能量" HorizontalAlignment="Stretch" SelectionChanged="OnInlineFieldSelectionChanged">
                                                    <ComboBoxItem x:Name="InlineEnergyKeepItem" Content="（保持原值）" Tag="__keep__" />
                                                    <ComboBoxItem Content="（未设置）" Tag="" />
                                                    <ComboBoxItem Content="低" Tag="low" />
                                                    <ComboBoxItem Content="中" Tag="medium" />
                                                    <ComboBoxItem Content="高" Tag="high" />
                                                </ComboBox>
                                            </Grid>

                                            <AutoSuggestBox
                                                x:Name="InlineSceneBox"
                                                Header="场景（; 分隔，输入时联想已有标签）"
                                                TextChanged="OnInlineTagBoxTextChanged"
                                                SuggestionChosen="OnInlineTagBoxSuggestionChosen"
                                                QuerySubmitted="OnInlineTagBoxQuerySubmitted" />
                                            <AutoSuggestBox
                                                x:Name="InlineMoodBox"
                                                Header="情绪（; 分隔，输入时联想已有标签）"
                                                TextChanged="OnInlineTagBoxTextChanged"
                                                SuggestionChosen="OnInlineTagBoxSuggestionChosen"
                                                QuerySubmitted="OnInlineTagBoxQuerySubmitted" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="星级" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                                <RatingControl
                                                    x:Name="InlineRatingControl"
                                                    MaxRating="5"
                                                    IsClearEnabled="True"
                                                    HorizontalAlignment="Left"
                                                    AutomationProperties.Name="星级"
                                                    ValueChanged="OnInlineRatingValueChanged" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="InlineSaveButton"
                                            Grid.Column="0"
                                            Style="{StaticResource GoldActionButtonStyle}"
                                            Content="保存"
                                            IsEnabled="False"
                                            HorizontalAlignment="Stretch"
                                            Click="OnSaveInlineInspectorMetadataClick" />
                                        <Button
                                            x:Name="InlineRevertButton"
                                            Grid.Column="1"
                                            Style="{StaticResource StudioChipButtonStyle}"
                                            Content="还原"
                                            IsEnabled="False"
                                            ToolTipService.ToolTip="放弃未保存的修改 (Esc)"
                                            Click="OnRevertInlineInspectorClick" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="6">
                                <TextBlock Text="相关人物（点击筛选）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.InspectedComposerChip, Mode=OneWay}" Tag="{x:Bind ViewModel.InspectedComposerChip, Mode=OneWay}" Click="OnCreditChipClick" Visibility="{x:Bind ViewModel.HasInspectedComposer, Mode=OneWay}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.InspectedConductorChip, Mode=OneWay}" Tag="{x:Bind ViewModel.InspectedConductorChip, Mode=OneWay}" Click="OnCreditChipClick" Visibility="{x:Bind ViewModel.HasInspectedConductor, Mode=OneWay}" />
                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.InspectedPublisherChip, Mode=OneWay}" Tag="{x:Bind ViewModel.InspectedPublisherChip, Mode=OneWay}" Click="OnCreditChipClick" Visibility="{x:Bind ViewModel.HasInspectedPublisher, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasAlternateRecordings, Mode=OneWay}">
                                <TextBlock Text="同乐章多录音版本 · 原位 A/B 切换" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AlternateRecordings, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:TrackItem">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Style="{StaticResource StudioChipButtonStyle}"
                                                Padding="9,6"
                                                Tag="{x:Bind TrackUid}"
                                                Click="OnSwitchAlternateRecordingClick"
                                                AutomationProperties.Name="{x:Bind AlternateVersionLabel}">
                                                <TextBlock Text="{x:Bind AlternateVersionLabel}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <Border Style="{StaticResource StudioCardStyle}" Padding="0,10,0,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="百科传记" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentBiographySummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StudioCardStyle}" Padding="0,10,0,10" Visibility="{x:Bind ViewModel.HasBookletPdf, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BookletPageStatusText" Grid.Column="0" Text="数字册页" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" MinWidth="28" MinHeight="28" Padding="6,4" Click="OnBookletPrevClick" AutomationProperties.Name="上一页数字册页" ToolTipService.ToolTip="上一页">
                                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="2" MinWidth="28" MinHeight="28" Padding="6,4" Margin="4,0" Click="OnBookletNextClick" AutomationProperties.Name="下一页数字册页" ToolTipService.ToolTip="下一页">
                                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="3" Content="剧场大图" MinHeight="28" Padding="8,4" FontSize="12" Click="OnOpenBookletTheaterClick" AutomationProperties.Name="打开数字册页剧场大图" />
                                    </Grid>
                                    <Image x:Name="BookletPageImage" MaxHeight="240" Stretch="Uniform" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Pane>
        </SplitView>

        <!-- ROW 2: COMPRESSED ZUNE RECTILINEAR TRANSPORT BAR (64px) -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource ZuneTransportBrush}"
            BorderBrush="{ThemeResource ZuneHairlineBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,6">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Now Playing Artwork + Clickable Info + Heart Love -->
                <Grid Grid.Column="0" Width="312" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="46"
                        Height="46"
                        Padding="0"
                        Background="{ThemeResource ZuneSurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource ZuneHairlineBrush}"
                        BorderThickness="1"
                        Click="OnTransportCoverClick"
                        AutomationProperties.Name="打开 now playing 全屏画廊"
                        ToolTipService.ToolTip="打开 now playing 全屏画廊">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="TransportCoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Click="OnTransportTrackInfoClick"
                            AutomationProperties.Name="检视当前曲目与所属专辑"
                            ToolTipService.ToolTip="检视当前曲目与所属专辑">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay, FallbackValue='未在播放'}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Click="OnTransportArtistClick"
                            AutomationProperties.Name="筛选此艺人的全部曲目"
                            ToolTipService.ToolTip="筛选此艺人的全部曲目">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ArtistsDisplay, Mode=OneWay, FallbackValue='双击任意曲目开始播放'}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrackSpecsSubline, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasCurrentTrack, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleCurrentTrackLovedCommand}"
                        AutomationProperties.Name="{x:Bind HeartAutomationName(ViewModel.CurrentTrackLoved), Mode=OneWay}"
                        ToolTipService.ToolTip="喜爱 / 取消喜爱（实时推送至 Last.fm Loved tracks）">
                        <FontIcon
                            x:Name="TransportHeartIcon"
                            Glyph="{x:Bind HeartGlyph(ViewModel.CurrentTrackLoved), Mode=OneWay}"
                            FontSize="15"
                            Foreground="{x:Bind HeartForeground(ViewModel.CurrentTrackLoved), Mode=OneWay}" />
                    </Button>
                </Grid>

                <!-- Sharp Zune Transport Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        x:Name="ShuffleModeButton"
                        Width="32"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                        Opacity="{x:Bind ShuffleOpacity(ViewModel.IsShuffleEnabled), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.ShuffleModeLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ShuffleModeLabel, Mode=OneWay}">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            <Rectangle Width="10" Height="2" Fill="{ThemeResource ZuneAccentBrush}" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.IsShuffleEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.PreviousTrackCommand}" AutomationProperties.Name="上一曲" ToolTipService.ToolTip="上一曲 (Ctrl+←)">
                        <FontIcon Glyph="&#xE892;" FontSize="15" />
                    </Button>
                    <Button
                        Width="38"
                        Height="38"
                        Padding="0"
                        Style="{StaticResource GoldActionButtonStyle}"
                        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        AutomationProperties.Name="{x:Bind PlayPauseAutomationName(ViewModel.IsPlaying), Mode=OneWay}"
                        ToolTipService.ToolTip="播放 / 暂停 (Ctrl+P)">
                        <FontIcon Glyph="{x:Bind PlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="16" />
                    </Button>
                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.NextTrackCommand}" AutomationProperties.Name="下一曲" ToolTipService.ToolTip="下一曲 (Ctrl+→)">
                        <FontIcon Glyph="&#xE893;" FontSize="15" />
                    </Button>
                    <Button
                        x:Name="RepeatModeButton"
                        Width="32"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.CycleRepeatModeCommand}"
                        Opacity="{x:Bind RepeatOpacity(ViewModel.RepeatMode), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.RepeatModeLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RepeatModeLabel, Mode=OneWay}">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind RepeatGlyph(ViewModel.RepeatMode), Mode=OneWay}" FontSize="14" />
                            <Rectangle Width="10" Height="2" Fill="{ThemeResource ZuneAccentBrush}" HorizontalAlignment="Center" Visibility="{x:Bind IsRepeatIndicatorVisible(ViewModel.RepeatMode), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Rectilinear Waveform + SeekSlider overlay + Time -->
                <Grid Grid.Column="2" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Height="40">
                        <Border Background="{ThemeResource ZuneSurfaceSubtleBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="4,2">
                            <skia:SKXamlCanvas
                                x:Name="WaveformCanvas"
                                IsHitTestVisible="False"
                                PaintSurface="OnPaintWaveform" />
                        </Border>
                        <Slider
                            x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="1"
                            SmallChange="5"
                            LargeChange="30"
                            VerticalAlignment="Center"
                            Margin="4,0"
                            IsThumbToolTipEnabled="True"
                            ThumbToolTipValueConverter="{StaticResource SecondsToClockConverter}"
                            ValueChanged="OnSeekSliderValueChanged"
                            AutomationProperties.Name="播放进度（秒）"
                            ToolTipService.ToolTip="拖动或用方向键定位播放进度（←/→ 5 秒，PgUp/PgDn 30 秒）">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource ZuneInkSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- DJ Freeze + Playback Queue + 6px Hardware Purity LED -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button
                        x:Name="DjFreezeButton"
                        Visibility="{x:Bind ViewModel.HasFreezeCapsule, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleDjFreezeCommand}"
                        Background="{x:Bind FreezePillBackground(ViewModel.IsDjFreezeActive), Mode=OneWay}"
                        BorderBrush="{x:Bind FreezePillBorder(ViewModel.IsDjFreezeActive), Mode=OneWay}"
                        BorderThickness="1"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="一键锁定当前氛围展开临时队列，再点还原原队列">
                        <TextBlock Text="{x:Bind ViewModel.CurrentFreezeCapsuleLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                    </Button>

                    <Button
                        x:Name="PlaybackQueueButton"
                        Click="OnOpenPlaybackQueueClick"
                        Style="{StaticResource StudioChipButtonStyle}"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="查看当前播放列表"
                        ToolTipService.ToolTip="查看、拖拽排序或管理当前播放队列">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="PlaybackQueueFlyout" Placement="TopEdgeAlignedRight">
                                <StackPanel Spacing="8" Width="420">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PlaybackQueueSummary, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.ShuffleModeLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleShuffleCommand}" Padding="8,4" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.RepeatModeLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CycleRepeatModeCommand}" Padding="8,4" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.QueueSlotChips, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:QueueSlotChipItem">
                                                <Button
                                                    Padding="8,3"
                                                    Style="{StaticResource StudioChipButtonStyle}"
                                                    Tag="{x:Bind SlotIndex}"
                                                    ToolTipService.ToolTip="{x:Bind TooltipText}"
                                                    Click="OnQuickQueueSlotChipClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Rectangle Width="6" Height="6" Fill="{ThemeResource ZuneAccentBrush}" Visibility="{x:Bind IsActive}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Style="{StaticResource GoldActionButtonStyle}" Content="载入当前筛选列表" Command="{x:Bind ViewModel.LoadCurrentViewToQueueCommand}" Padding="10,5" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="清空队列" Click="OnClearPlaybackQueueClick" Padding="10,5" />
                                    </StackPanel>
                                    <ListView
                                        x:Name="PlaybackQueueListView"
                                        ItemsSource="{x:Bind ViewModel.PlaybackQueue, Mode=OneWay}"
                                        CanReorderItems="True"
                                        AllowDrop="True"
                                        ContainerContentChanging="OnQueueListContainerContentChanging"
                                        DragItemsCompleted="OnPlaybackQueueDragItemsCompleted"
                                        MaxHeight="340"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TrackItem">
                                                <Grid ColumnSpacing="8" Padding="2,4" AutomationProperties.Name="{x:Bind AccessibilitySummary}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon x:Name="QueuePlayingGlyph" Grid.Column="0" Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource ZuneAccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock x:Name="QueueTitleText" Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind ArtistsDisplay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" MinWidth="28" MinHeight="28" Padding="6,4" Background="Transparent" BorderThickness="0" Click="OnPlayQueueTrackClick" ToolTipService.ToolTip="立即播放" AutomationProperties.Name="从队列播放此曲目">
                                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                    </Button>
                                                    <Button Grid.Column="3" MinWidth="28" MinHeight="28" Padding="6,4" Background="Transparent" BorderThickness="0" Click="OnRemoveQueueTrackClick" ToolTipService.ToolTip="从队列移除" AutomationProperties.Name="从队列移除此曲目">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE90B;" FontSize="13" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PlaybackQueueSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SignalPathRackButton"
                        Click="OnOpenAcousticRackClick"
                        Style="{StaticResource StudioChipButtonStyle}"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="打开声学信号链路与 DSP 机架面板">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="AcousticRackFlyout">
                                <StackPanel Spacing="10" Width="360">
                                    <TextBlock Text="信号链路与快速声学机架" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                    <ToggleSwitch Header="锁定 DAC 硬件设置" IsOn="{x:Bind ViewModel.IsDacHardwareLocked, Mode=TwoWay}" />
                                    <ToggleSwitch Header="WASAPI 独占（绕过系统混音）" IsOn="{x:Bind ViewModel.PreferWasapiExclusive, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDacHardwareUnlocked, Mode=OneWay}" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        Header="输出设备"
                                        ItemsSource="{x:Bind ViewModel.OutputEndpoints, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedEndpoint, Mode=TwoWay}"
                                        DisplayMemberPath="FriendlyName"
                                        IsEnabled="{x:Bind ViewModel.IsDacHardwareUnlocked, Mode=OneWay}" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        Header="ReplayGain 模式"
                                        SelectedValuePath="Tag"
                                        SelectedValue="{x:Bind ViewModel.ReplayGainMode, Mode=TwoWay}">
                                        <ComboBoxItem Content="动态智能 (Dynamic)" Tag="dynamic" />
                                        <ComboBoxItem Content="单曲增益 (Track)" Tag="track" />
                                        <ComboBoxItem Content="专辑增益 (Album)" Tag="album" />
                                        <ComboBoxItem Content="关闭 (Off)" Tag="off" />
                                    </ComboBox>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch Grid.Column="0" Header="内置 DSP" IsOn="{x:Bind ViewModel.IsDspEnabled, Mode=TwoWay}" />
                                        <ToggleSwitch Grid.Column="1" Header="等响度 A/B 旁路" IsOn="{x:Bind ViewModel.IsGainMatchedBypass, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDspEnabled, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch Grid.Column="0" Header="耳机 Crossfeed" IsOn="{x:Bind ViewModel.IsCrossfeedEnabled, Mode=TwoWay}" />
                                        <ToggleSwitch Grid.Column="1" Header="ISO 226 等响度" IsOn="{x:Bind ViewModel.IsIso226Enabled, Mode=TwoWay}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="Flat" Padding="8,4" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="Flat" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="开放耳机" Padding="8,4" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="OpenEarBluetooth" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="深夜" Padding="8,4" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="FocusNight" />
                                        <Button Style="{StaticResource StudioChipButtonStyle}" Content="古典声场" Padding="8,4" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="ClassicalCrossfeed" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="加载 EQ (.txt)" Click="OnLoadEqClick" />
                                        <Button Content="加载 FIR / SOFA" Click="OnLoadFirClick" />
                                        <Button Content="清除 FIR" Command="{x:Bind ViewModel.ClearFirImpulseCommand}" />
                                    </StackPanel>
                                    <ToggleSwitch Header="24-bit TPDF 抖动" IsOn="{x:Bind ViewModel.IsTpdfDitherEnabled, Mode=TwoWay}" />
                                    <ToggleSwitch Header="流派 + 人声自动内容 EQ (串联叠加)" IsOn="{x:Bind ViewModel.IsAutoEqEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveAutoEqBadge, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ZuneAccentBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SignalPathSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneStatusSuccessBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="SignalPurityDot" Width="7" Height="7" Fill="{ThemeResource ZuneStatusSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SignalPurityLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sleep Timer + Mute + Volume -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        Padding="8,4"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ZuneHairlineBrush}"
                        AutomationProperties.Name="睡眠定时"
                        ToolTipService.ToolTip="睡眠定时（倒计时 / 本曲 / 本作品结束）">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="关闭睡眠定时" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="off" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="15 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="15" />
                                <MenuFlyoutItem Text="30 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="30" />
                                <MenuFlyoutItem Text="45 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="45" />
                                <MenuFlyoutItem Text="60 分钟" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="60" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="本曲结束后暂停" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="track" />
                                <MenuFlyoutItem Text="本古典作品结束后暂停" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="work" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE708;" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.SleepTimerBadge, Mode=OneWay}"
                                       FontSize="12"
                                       FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                       Foreground="{ThemeResource ZuneAccentBrush}"
                                       Visibility="{x:Bind ViewModel.IsSleepTimerActive, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{x:Bind ViewModel.IsMuted, Mode=TwoWay}"
                        AutomationProperties.Name="静音"
                        ToolTipService.ToolTip="{x:Bind ViewModel.VolumeToolTip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind VolumeGlyph(ViewModel.IsMuted, ViewModel.VolumePercent), Mode=OneWay}" FontSize="15" />
                    </ToggleButton>
                    <Slider
                        Width="104"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="1"
                        SmallChange="2"
                        LargeChange="10"
                        VerticalAlignment="Center"
                        Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}"
                        AutomationProperties.Name="音量（百分比）"
                        ToolTipService.ToolTip="{x:Bind ViewModel.VolumeToolTip, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
