                                                ToolTipService.ToolTip="清空全部筛选条件">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                    <TextBlock Text="清空" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <InfoBar
                                        IsOpen="{x:Bind ViewModel.HasMissingTempoBanner, Mode=OneWay}"
                                        Severity="Warning"
                                        IsClosable="False"
                                        Title="Tempo 待回填"
                                        Message="{x:Bind ViewModel.MissingMetadataBannerText, Mode=OneWay}">
                                        <InfoBar.ActionButton>
                                            <Button Content="去入库审校" Tag="studio:inbox" Click="OnPrimaryNavClick" />
                                        </InfoBar.ActionButton>
                                    </InfoBar>
                                </StackPanel>
                            </Border>

                            <!-- 4) Playlists Management Deck -->
                            <Border
                                Style="{StaticResource StudioCardStyle}"
                                Visibility="{x:Bind ViewModel.IsPlaylistsDeckVisible, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Style="{StaticResource GoldActionButtonStyle}" Click="OnNewPlaylistClick">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="新建歌单" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnImportPlaylistClick" ToolTipService.ToolTip="从 Spotify / Apple Music / Billboard / Kworb 链接或文本文件导入">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock Text="导入歌单" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnEditPlaylistClick">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="14" /><TextBlock Text="编辑" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnRematchPlaylistsClick" ToolTipService.ToolTip="按最新匹配算法重新匹配歌单中的未匹配曲目与失效路径，并将更新写回 .m3u8">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="重匹曲库" /></StackPanel>
                                            </Button>
                                            <ToggleButton
                                                x:Name="PlaylistMultiSelectToggleButton"
                                                IsChecked="{x:Bind ViewModel.IsPlaylistMultiSelectMode, Mode=TwoWay}"
                                                Click="OnPlaylistMultiSelectToggleClick"
                                                Padding="10,5"
                                                FontSize="12"
                                                ToolTipService.ToolTip="开启多选以同时选择多个歌单发送到手机">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE762;" FontSize="14" /><TextBlock Text="多选歌单" /></StackPanel>
                                            </ToggleButton>
                                            <Button
                                                Style="{StaticResource StudioChipButtonStyle}"
                                                Content="全选歌单"
                                                Click="OnSelectAllPlaylistsClick"
                                                Visibility="{x:Bind ViewModel.IsPlaylistMultiSelectMode, Mode=OneWay}" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnSendPlaylistToPhoneClick" ToolTipService.ToolTip="将选中的一个或多个歌单加入手机同步队列（订阅）">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8EA;" FontSize="14" /><TextBlock Text="{x:Bind ViewModel.SendPlaylistToPhoneButtonLabel, Mode=OneWay}" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnPinPlaylistToQuickplayClick" ToolTipService.ToolTip="将当前歌单固定到 quickplay 首屏">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE718;" FontSize="14" /><TextBlock Text="固定到 quickplay" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GoldActionButtonStyle}" Command="{x:Bind ViewModel.SaveCurrentPlaylistOrderCommand}" Visibility="{x:Bind ViewModel.IsViewingPlaylist, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock Text="保存排序" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Click="OnDeletePlaylistClick">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="删除" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="返回曲库" Command="{x:Bind ViewModel.ShowAllLibraryTracksCommand}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.PlaylistsCountBadge, Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="{ThemeResource ZuneInkSecondaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="6,0,2,0" />
                                            <Button
                                                x:Name="PlaylistsExpandToggleButton"
                                                Style="{StaticResource StudioChipButtonStyle}"
                                                Command="{x:Bind ViewModel.TogglePlaylistsExpandedCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="{x:Bind PlaylistsExpandToggleGlyph(ViewModel.IsPlaylistsExpanded), Mode=OneWay}" FontSize="12" />
                                                    <TextBlock Text="{x:Bind PlaylistsExpandToggleLabel(ViewModel.IsPlaylistsExpanded), Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ListView
                                        x:Name="PlaylistsListView"
                                        ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnPlaylistsSelectionChanged"
                                        RightTapped="OnPlaylistsRightTapped"
                                        MaxHeight="{x:Bind PlaylistsDeckMaxHeight(ViewModel.IsPlaylistsExpanded), Mode=OneWay}"
                                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                                        ScrollViewer.VerticalScrollMode="Enabled"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="固定到 quickplay" Click="OnContextPinPlaylistToQuickplayClick">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="发送到手机（订阅）" Click="OnContextSendPlaylistCardToPhoneClick">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EA;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="重匹本地曲库并保存" Click="OnContextRematchPlaylistCardClick">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="删除歌单" Click="OnContextDeletePlaylistCardClick">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </ListView.ContextFlyout>
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="2" />
                                                <Setter Property="Margin" Value="0,0,8,8" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="playlists:PlaylistSummary">
                                                <Border
                                                    Width="224"
                                                    Height="68"
                                                    Padding="12,8"
                                                    Background="{ThemeResource ZuneSurfaceElevatedBrush}"
                                                    BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                                    BorderThickness="1"
                                                    ToolTipService.ToolTip="{x:Bind Name}"
                                                    AutomationProperties.Name="{x:Bind Name}">
                                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind CountBadge}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- 5) Inbox & Audit Deck -->
                            <Border
                                Style="{StaticResource StudioCardStyle}"
                                Visibility="{x:Bind ViewModel.IsInboxAuditDeckVisible, Mode=OneWay}">
                                <StackPanel Spacing="6">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                                        <StackPanel x:Name="InboxAuditChipsPanel" Orientation="Horizontal" Spacing="6">
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingGenreLabel, Mode=OneWay}" Tag="audit_missing_genre" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingComposerLabel, Mode=OneWay}" Tag="audit_missing_composer" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingConductorLabel, Mode=OneWay}" Tag="audit_missing_conductor" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingAlbumLabel, Mode=OneWay}" Tag="audit_missing_album" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingPublisherLabel, Mode=OneWay}" Tag="audit_missing_publisher" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingSceneLabel, Mode=OneWay}" Tag="audit_missing_scene" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingTempoLabel, Mode=OneWay}" Tag="audit_missing_tempo" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingCoverLabel, Mode=OneWay}" Tag="audit_missing_cover" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditMissingVocalsLabel, Mode=OneWay}" Tag="audit_missing_vocals" Click="OnNavModeClick" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="{x:Bind ViewModel.AuditRediscovery90dLabel, Mode=OneWay}" Tag="rediscovery_90d" Click="OnNavModeClick" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Style="{StaticResource GoldActionButtonStyle}" Content="扫描元数据缺口" Command="{x:Bind ViewModel.RunFillMissingScanCommand}" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="补全当前列表基础信息" Command="{x:Bind ViewModel.FetchMissingBasicInfoForCurrentListCommand}" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="补全当前列表五维标签" Command="{x:Bind ViewModel.FetchMissing5DTagsForCurrentListCommand}" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="抓取缺失封面与传记" Command="{x:Bind ViewModel.EnrichLibraryCoversAndBiosCommand}" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="批准高置信度 (≥80%)…" Click="OnApproveAllHighConfidenceClick" />
                                            <Button Style="{StaticResource GoldActionButtonStyle}" Content="应用已批准的变更" Command="{x:Bind ViewModel.CommitStagingBatchCommand}" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="撤回上一批次" Command="{x:Bind ViewModel.RollbackLastBatchCommand}" />
                                            <Button Style="{StaticResource StudioChipButtonStyle}" Content="清除待审…" Click="OnClearPendingStagingClick" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <TextBlock
                                        x:Name="InboxAuditResultSummaryBlock"
                                        Text="{x:Bind ViewModel.InboxAuditResultSummaryText, Mode=OneWay}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource ZuneAccentBrush}"
                                        TextWrapping="Wrap" />

                                    <TextBlock Text="{x:Bind ViewModel.StagingSummaryText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />

                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.StagingProposalItems, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasStagingProposals, Mode=OneWay}"
                                        MaxHeight="170">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:StagingProposalViewItem">
                                                <Grid ColumnSpacing="8" Padding="4,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind TrackDisplay}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind FieldName}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind ValueTransition}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind SourceBadge}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="4" Padding="8,4" Tag="{x:Bind ProposalId}" Click="OnApproveProposalClick" AutomationProperties.Name="批准此变更提案" ToolTipService.ToolTip="批准">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                                    </Button>
                                                    <Button Grid.Column="5" Padding="8,4" Tag="{x:Bind ProposalId}" Click="OnRejectProposalClick" AutomationProperties.Name="驳回此变更提案" ToolTipService.ToolTip="驳回">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- CENTER STAGE ROW 1: FRAMELESS 8-COLUMN TRACK TABLE / SYNC HUB / SETTINGS HUB -->
                        <Grid Grid.Row="1" Padding="18,0,18,8">
                            <!-- A0) Full-Canvas Albums Zero-Radius Cover Art Gallery -->
                            <ListView
                                x:Name="AlbumsCoverGridView"
                                ItemsSource="{x:Bind ViewModel.CurrentEntityGroups, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedEntityGroup, Mode=OneWay}"
                                SelectionChanged="OnEntityGroupSelectionChanged"
                                RightTapped="OnEntityBrowserRightTapped"
                                ContainerContentChanging="OnEntityCoverListContainerContentChanging"
                                Visibility="{x:Bind ViewModel.IsAlbumsWallExpanded, Mode=OneWay}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="固定到 quickplay" Click="OnContextPinEntityGroupToQuickplayClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="发送到手机" Click="OnContextSendEntityGroupToPhoneClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EA;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="2" />
                                        <Setter Property="Margin" Value="0,0,12,14" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:EntityGroupItem">
                                        <StackPanel Width="148" Spacing="5" AutomationProperties.Name="{x:Bind Title}">
                                            <Border Width="148" Height="148" Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image x:Name="EntityCoverImage" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- A) Frameless 8-Column Track Table -->
                            <Grid Visibility="{x:Bind ViewModel.IsTrackTableVisible, Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.7*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.45*" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="68" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{x:Bind ViewModel.HeaderTitleText, Mode=OneWay}" Tag="title" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" ToolTipService.ToolTip="点击按曲目 / 专辑名称排序" />
                                        <Button Grid.Column="1" Content="{x:Bind ViewModel.HeaderArtistText, Mode=OneWay}" Tag="artist" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" ToolTipService.ToolTip="点击按艺人排序" />
                                        <Button Grid.Column="2" Content="{x:Bind ViewModel.HeaderComposerText, Mode=OneWay}" Tag="composer" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" ToolTipService.ToolTip="点击按作曲 / 作品排序" />
                                        <Button Grid.Column="3" Content="{x:Bind ViewModel.HeaderYearText, Mode=OneWay}" Tag="year" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" ToolTipService.ToolTip="点击按发行年份排序" />
                                        <Button Grid.Column="4" Content="{x:Bind ViewModel.HeaderSceneText, Mode=OneWay}" Tag="scene" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" ToolTipService.ToolTip="点击按场景 / 情绪排序" />
                                        <Button Grid.Column="5" Content="{x:Bind ViewModel.HeaderEnergyText, Mode=OneWay}" Tag="energy" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" ToolTipService.ToolTip="点击按能量 / 节奏排序" />
                                        <Button Grid.Column="6" Content="{x:Bind ViewModel.HeaderPlayCountText, Mode=OneWay}" Tag="playcount" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" ToolTipService.ToolTip="点击按播放次数与喜爱排序" />
                                        <Button Grid.Column="7" Content="{x:Bind ViewModel.HeaderDurationText, Mode=OneWay}" Tag="duration" Click="OnTrackColumnHeaderClick" Background="Transparent" BorderThickness="0" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkSecondaryBrush}" ToolTipService.ToolTip="点击按曲目时长排序" />
                                    </Grid>
                                </Border>

                                <ListView
                                    x:Name="TrackListView"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.FilteredTracks, Mode=OneWay}"
                                    SelectionMode="Extended"
                                    IsDoubleTapEnabled="True"
                                    CanReorderItems="{x:Bind ViewModel.IsViewingPlaylist, Mode=OneWay}"
                                    AllowDrop="{x:Bind ViewModel.IsViewingPlaylist, Mode=OneWay}"
                                    ContainerContentChanging="OnTrackListContainerContentChanging"
                                    SelectionChanged="OnTrackSelectionChanged"
                                    DoubleTapped="OnTrackDoubleTapped"
                                    RightTapped="OnTrackListRightTapped">
                                    <ListView.ContextFlyout>
                                        <CommandBarFlyout>
                                            <AppBarButton Icon="Play" Label="播放" Click="OnContextPlayTrackClick" AutomationProperties.Name="立即播放所选曲目" />
                                            <AppBarButton Icon="Add" Label="下一首" Click="OnContextEnqueueNextClick" AutomationProperties.Name="加入下一首播放" />
                                            <AppBarButton Label="追加队尾" Click="OnContextEnqueueEndClick" AutomationProperties.Name="追加到播放列表末尾">
                                                <AppBarButton.Icon><FontIcon Glyph="&#xE90B;" /></AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton Label="喜爱" Click="OnContextToggleLovedClick" AutomationProperties.Name="切换喜爱并同步至 Last.fm">
                                                <AppBarButton.Icon><FontIcon Glyph="&#xEB51;" /></AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton Icon="Tag" Label="T · 打标" Click="OnContextTagMatrixClick" AutomationProperties.Name="打开 Lexicon 五维胶囊打标矩阵" />
                                            <AppBarButton Icon="Edit" Label="F2 · 编辑" Click="OnContextF2BasicMetadataClick" AutomationProperties.Name="在右侧属性检查器中精修基本属性" />
                                            <AppBarButton Label="发送到手机" Click="OnContextSendTracksToPhoneClick" AutomationProperties.Name="将所选一首或多首曲目发送到手机">
                                                <AppBarButton.Icon><FontIcon Glyph="&#xE8EA;" /></AppBarButton.Icon>
                                            </AppBarButton>
                                            <CommandBarFlyout.SecondaryCommands>
                                                <AppBarButton Icon="MusicInfo" Label="添加到当前歌单" Click="OnContextAddToPlaylistClick" />
                                                <AppBarButton Icon="Folder" Label="打开文件所在目录" Click="OnContextRevealInExplorerClick" />
                                            </CommandBarFlyout.SecondaryCommands>
                                        </CommandBarFlyout>
                                    </ListView.ContextFlyout>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TrackItem">
                                            <Grid ColumnSpacing="10" Padding="6,7" AutomationProperties.Name="{x:Bind AccessibilitySummary}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.7*" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="1.45*" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="68" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" ColumnSpacing="10" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="40"
                                                        Height="40"
                                                        Background="{ThemeResource ZuneSurfaceElevatedBrush}"
                                                        BorderBrush="{ThemeResource ZuneHairlineBrush}"
                                                        BorderThickness="1">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource ZuneInkTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image x:Name="RowCoverImage" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Album}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ArtistsDisplay}" FontSize="13" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Phase="1" Text="{x:Bind ComposersDisplay}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Phase="1" Text="{x:Bind WorkAndConductorSubline}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" x:Phase="1" Text="{x:Bind YearDisplay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Phase="2" Text="{x:Bind SceneBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Phase="2" Text="{x:Bind MoodBadge}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="5" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Phase="2" Text="{x:Bind EnergyBadge}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                                    <TextBlock x:Phase="2" Text="{x:Bind TempoDisplay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="6" x:Phase="1" Text="{x:Bind PlayCountDisplay}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="7" x:Phase="2" Text="{x:Bind DurationDisplay}" FontSize="12" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource ZuneInkSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- B) Sync & Scrobble Full Page (inside studio hub) -->
                            <ScrollViewer Visibility="{x:Bind ViewModel.IsSyncScrobbleViewVisible, Mode=OneWay}">
                                <StackPanel Spacing="16" Padding="0,8,0,24">

                                    <!-- Sub-Tab: LAN & USB Devices & Persistent Session Slots -->
                                    <Border Style="{StaticResource StudioCardStyle}" Padding="16" Visibility="{x:Bind ViewModel.IsSyncLanSubTab, Mode=OneWay}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="局域网与 USB 手机双向同步" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button Style="{StaticResource GoldActionButtonStyle}" Content="开启 / 关闭局域网同步服务" Command="{x:Bind ViewModel.ToggleLanSyncHostCommand}" />
                                                <Button Style="{StaticResource StudioChipButtonStyle}" Content="刷新配对码" Command="{x:Bind ViewModel.RegenerateLanPairingCodeCommand}" />
                                                <TextBlock Text="{x:Bind ViewModel.LanSyncStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="12,10">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="USB 自动双向同步（目标目录：手机 Music/）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.UsbAdbStatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource GoldActionButtonStyle}" Content="立即 USB 同步" Command="{x:Bind ViewModel.TriggerUsbSyncNowCommand}" IsEnabled="{x:Bind ViewModel.HasConnectedUsbDevice, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Style="{StaticResource StudioChipButtonStyle}" Content="取消" Command="{x:Bind ViewModel.CancelUsbSyncCommand}" Visibility="{x:Bind ViewModel.IsUsbSyncRunning, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                                        <ToggleSwitch Header="连接手机自动 USB 同步" IsOn="{x:Bind ViewModel.IsUsbAutoSyncEnabled, Mode=TwoWay}" />
                                                        <ToggleSwitch x:Name="MirrorPruneToggleSwitch" Header="自动删除手机 Music 中不在列表的歌曲" IsOn="{x:Bind ViewModel.IsMirrorPruneEnabled, Mode=TwoWay}" Toggled="OnMirrorPruneSwitchToggled" />
                                                    </StackPanel>
                                                    <ProgressBar IsIndeterminate="False" Value="{x:Bind ViewModel.UsbSyncProgressPercent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ViewModel.IsUsbSyncRunning, Mode=OneWay}" AutomationProperties.Name="USB 同步进度" />
                                                    <TextBlock Text="{x:Bind ViewModel.UsbSyncProgressText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" />
                                                    <Border Background="{ThemeResource ZuneSurfaceSubtleBrush}" BorderBrush="{ThemeResource ZuneAccentBrush}" BorderThickness="1" Padding="10,8" Visibility="{x:Bind ViewModel.HasPendingLargePruneConfirmation, Mode=OneWay}">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PendingLargePruneMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Style="{StaticResource GoldActionButtonStyle}" Content="确认执行删除" Command="{x:Bind ViewModel.ConfirmLargeUsbPruneCommand}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="2" Style="{StaticResource StudioChipButtonStyle}" Content="本次跳过" Command="{x:Bind ViewModel.DismissLargeUsbPruneCommand}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="12,10">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="本机局域网服务地址（同一 Wi-Fi 下的手机可自动发现或手动填写）" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind ViewModel.LanHostUrlsText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource ZuneInkPrimaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                                        <TextBlock Text="提示：首次开启时请在 Windows 防火墙弹窗允许专用网络通信（端口 45820）" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="6 位配对码" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{x:Bind ViewModel.LanPairingCode, Mode=OneWay}" FontSize="24" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI" CharacterSpacing="120" Foreground="{ThemeResource ZuneAccentBrush}" IsTextSelectionEnabled="True" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <StackPanel Spacing="6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="发送队列（发送到手机）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind ViewModel.LanOutboxSummaryText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource StudioChipButtonStyle}" Content="清空队列" Click="OnClearLanOutboxClick" Visibility="{x:Bind ViewModel.HasLanOutboxItems, Mode=OneWay}" />
                                                </Grid>
                                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SyncOutboxItems, Mode=OneWay}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SyncOutboxViewItem">
                                                            <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="10,7">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{x:Bind KindLabel}" FontSize="12" Foreground="{ThemeResource ZuneAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{x:Bind DetailText}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{x:Bind ModeBadge}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="3" Content="移除" MinWidth="28" MinHeight="28" Padding="8,4" FontSize="12" Tag="{x:Bind Id}" Click="OnRemoveLanOutboxItemClick" AutomationProperties.Name="移除发送队列项" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>

                                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasPairedDevices, Mode=OneWay}">
                                                <TextBlock Text="已配对手机设备" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.PairedDevices, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PairedDeviceViewItem">
                                                            <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="10,7" Margin="0,2">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind DeviceName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                                                        <TextBlock Text="{x:Bind LastSyncDisplay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="解除配对" MinWidth="28" MinHeight="28" Padding="8,4" FontSize="12" Tag="{x:Bind DeviceId}" Click="OnUnpairLanDeviceClick" AutomationProperties.Name="解除设备配对" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <TextBlock Text="5 个持久化场景队列槽位 (跨设备零延迟接续)" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" Margin="0,4,0,0" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.SessionSlots, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="interop:SessionSlotDto">
                                                        <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="10,7" Margin="0,2">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{x:Bind SlotIndex}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" />
                                                                    <TextBlock Text="{x:Bind SceneId}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Content="保存当前队列" Padding="10,4" FontSize="12" Tag="{x:Bind SlotIndex}" Click="OnSaveSessionSlotClick" />
                                                                <Button Grid.Column="3" Content="恢复并播放" Padding="10,4" FontSize="12" Tag="{x:Bind SlotIndex}" Click="OnRestoreSessionSlotClick" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sub-Tab: Last.fm Ledger -->
                                    <Border Style="{StaticResource StudioCardStyle}" Padding="16" Visibility="{x:Bind ViewModel.IsSyncLastFmSubTab, Mode=OneWay}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Last.fm 播放记录与 Loved tracks 双向同步" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                            <Border Background="{ThemeResource ZuneSurfaceElevatedBrush}" BorderBrush="{ThemeResource ZuneHairlineBrush}" BorderThickness="1" Padding="10,7">
                                                <TextBlock Text="{x:Bind ViewModel.LastFmAuthModeBadge, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Text="{x:Bind ViewModel.LastFmLedgerStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkPrimaryBrush}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Style="{StaticResource GoldActionButtonStyle}" Content="配置 / 浏览器授权 Last.fm…" Click="OnLastFmSetupClick" />
                                                <Button Style="{StaticResource StudioChipButtonStyle}" Content="立即同步" Command="{x:Bind ViewModel.SyncLastFmLedgerCommand}" />
                                                <Button Style="{StaticResource StudioChipButtonStyle}" Content="将本地 5 星回推至 Loved tracks" Command="{x:Bind ViewModel.BackfillLocalLovedToLastFmCommand}" IsEnabled="{x:Bind ViewModel.HasLastFmWriteSession, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Text="播放开始时自动上报 Now Playing，播满 50% 或 4 分钟（曲长 ≥ 30 秒）自动记录并推送 track.scrobble；点击红心或调整 5 星评分自动推送 track.love / track.unlove；离线记录最长保留 14 天待补传。" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Sub-Tab: USB Export -->
                                    <Border Style="{StaticResource StudioCardStyle}" Padding="16" Visibility="{x:Bind ViewModel.IsSyncUsbSubTab, Mode=OneWay}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="USB 车载导出" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                            <TextBlock Text="把当前筛选的曲目连同 .m3u8 歌单和车机兼容尺寸的封面，导出到 U 盘目录。" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" TextWrapping="Wrap" />
                                            <Button Style="{StaticResource GoldActionButtonStyle}" Content="选择目标 U 盘 / 目录并立即导出..." Click="OnExportUsbCarClick" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- C) Settings Full Page -->
                            <ScrollViewer Visibility="{x:Bind ViewModel.IsSettingsViewVisible, Mode=OneWay}">
                                <StackPanel Spacing="16" Padding="0,8,0,24">

                                    <!-- Sub-Tab: Audio & DSP -->
                                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsSettingsAudioSubTab, Mode=OneWay}">
                                        <Border Style="{StaticResource StudioCardStyle}" Padding="16">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="音频输出硬件与文件冲激" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" />
                                                <Grid ColumnSpacing="24" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ToggleSwitch Grid.Row="0" Grid.Column="0" Header="锁定 DAC 硬件设置" IsOn="{x:Bind ViewModel.IsDacHardwareLocked, Mode=TwoWay}" />
                                                    <ToggleSwitch Grid.Row="0" Grid.Column="1" Header="WASAPI 独占" IsOn="{x:Bind ViewModel.PreferWasapiExclusive, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDacHardwareUnlocked, Mode=OneWay}" />
                                                    <ToggleSwitch Grid.Row="1" Grid.Column="0" Header="ISO 226 等响度补偿" IsOn="{x:Bind ViewModel.IsIso226Enabled, Mode=TwoWay}" />
                                                    <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="24-bit TPDF 抖动" IsOn="{x:Bind ViewModel.IsTpdfDitherEnabled, Mode=TwoWay}" />
                                                </Grid>

                                                <ComboBox
                                                    Width="420"
                                                    Header="输出设备（按设备自动记忆 DSP 配置）"
                                                    ItemsSource="{x:Bind ViewModel.OutputEndpoints, Mode=OneWay}"
                                                    SelectedItem="{x:Bind ViewModel.SelectedEndpoint, Mode=TwoWay}"
                                                    DisplayMemberPath="FriendlyName"
                                                    IsEnabled="{x:Bind ViewModel.IsDacHardwareUnlocked, Mode=OneWay}" />

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="加载 Equalizer APO (.txt)" Click="OnLoadEqClick" />
                                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="加载 FIR / SOFA 卷积脉冲" Click="OnLoadFirClick" />
                                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="清除 FIR" Command="{x:Bind ViewModel.ClearFirImpulseCommand}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ActiveEqSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind ViewModel.FirImpulseFileName, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Spacing="4" MaxWidth="420">
                                                    <TextBlock Text="数字衰减精调 (dB，与播放栏音量同步)" FontSize="12" Foreground="{ThemeResource ZuneInkSecondaryBrush}" />
                                                    <Slider Minimum="-60" Maximum="0" StepFrequency="0.5" Value="{x:Bind ViewModel.VolumeAttenuationDb, Mode=TwoWay}" AutomationProperties.Name="数字衰减 (dB)" />
                                                </StackPanel>

                                                <TextBlock Text="{x:Bind ViewModel.SignalPathSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneStatusSuccessBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ViewModel.SystemApoWarningText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ZuneStatusWarnBrush}" Visibility="{x:Bind ViewModel.HasSystemApoConflict, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource StudioCardStyle}" Padding="16">
                                            <StackPanel Spacing="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="内置 64-Bit 参数均衡、耳机声场与 A/B 盲测" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ZuneAccentBrush}" VerticalAlignment="Center" />
                                                    <ToggleSwitch Grid.Column="1" Header="启用内置 DSP" IsOn="{x:Bind ViewModel.IsDspEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                                                    <ToggleSwitch Grid.Column="2" Header="等响度 A/B 旁路" IsOn="{x:Bind ViewModel.IsGainMatchedBypass, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDspEnabled, Mode=OneWay}" />
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="平直 (Flat)" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="Flat" />
                                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="开放耳机补偿" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="OpenEarBluetooth" />
                                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="深夜专注" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="FocusNight" />
                                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="古典 Crossfeed" Command="{x:Bind ViewModel.SelectDspPresetCommand}" CommandParameter="ClassicalCrossfeed" />
                                                    <Button Style="{StaticResource StudioChipButtonStyle}" Content="归零 10 段 EQ" Command="{x:Bind ViewModel.ResetTenBandEqCommand}" />
                                                </StackPanel>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand0Db, Mode=TwoWay}" AutomationProperties.Name="31 Hz" /><TextBlock Text="31" FontSize="11" Foreground="{ThemeResource ZuneInkSecondaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand0Db), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ZuneInkPrimaryBrush}" HorizontalAlignment="Center" /></StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand1Db, Mode=TwoWay}" AutomationProperties.Name="62 Hz" /><TextBlock Text="62" FontSize="11" Foreground="{ThemeResource ZuneInkSecondaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand1Db), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ZuneInkPrimaryBrush}" HorizontalAlignment="Center" /></StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand2Db, Mode=TwoWay}" AutomationProperties.Name="125 Hz" /><TextBlock Text="125" FontSize="11" Foreground="{ThemeResource ZuneInkSecondaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand2Db), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ZuneInkPrimaryBrush}" HorizontalAlignment="Center" /></StackPanel>
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand3Db, Mode=TwoWay}" AutomationProperties.Name="250 Hz" /><TextBlock Text="250" FontSize="11" Foreground="{ThemeResource ZuneInkSecondaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand3Db), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ZuneInkPrimaryBrush}" HorizontalAlignment="Center" /></StackPanel>
                                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="96" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqBand4Db, Mode=TwoWay}" AutomationProperties.Name="500 Hz" /><TextBlock Text="500" FontSize="11" Foreground="{ThemeResource ZuneInkSecondaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.EqBand4Db), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ZuneInkPrimaryBrush}" HorizontalAlignment="Center" /></StackPanel>
