<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tonewise.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Tonewise.Desktop.Models"
    xmlns:curation="using:Tonewise.SyncHost.Curation"
    xmlns:interop="using:Tonewise.Interop"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="Tonewise Desktop — Studio Master Workbench">

    <Grid x:Name="RootWorkbench" Background="#131720" RequestedTheme="Dark">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="OnTogglePlayShortcut" />
            <KeyboardAccelerator Modifiers="Menu" Key="C" Invoked="OnCodingQuickSceneShortcut" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="OnPrevTrackShortcut" />
            <KeyboardAccelerator Modifiers="Menu" Key="Right" Invoked="OnNextTrackShortcut" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Bar: Library Actions + Resident 5D Orthogonal Matrix + Widget Toggle -->
        <Border Grid.Row="0" Background="#1A202C" BorderBrush="#2D3748" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="TONEWISE" Foreground="#D9B372" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center" CharacterSpacing="120" Margin="0,0,6,0" />
                    <Button Content="Open Music Folder..." Click="OnOpenFolderClick"
                            Background="#242C3B" Foreground="#E2E8F0" BorderBrush="#3A4559" />
                </StackPanel>

                <!-- 5D Filter Matrix -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox Width="118" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterScene, Mode=TwoWay}">
                            <ComboBoxItem Content="Scene: All" Tag="all" />
                            <ComboBoxItem Content="Focus" Tag="focus" />
                            <ComboBoxItem Content="Coding" Tag="coding" />
                            <ComboBoxItem Content="Relax" Tag="relax" />
                            <ComboBoxItem Content="Energy" Tag="energy" />
                            <ComboBoxItem Content="Pop" Tag="pop" />
                        </ComboBox>

                        <ComboBox Width="116" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterEnergy, Mode=TwoWay}">
                            <ComboBoxItem Content="Energy: All" Tag="all" />
                            <ComboBoxItem Content="Low" Tag="low" />
                            <ComboBoxItem Content="Medium" Tag="medium" />
                            <ComboBoxItem Content="High" Tag="high" />
                            <ComboBoxItem Content="Unknown" Tag="unknown" />
                        </ComboBox>

                        <ComboBox Width="122" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterVocals, Mode=TwoWay}">
                            <ComboBoxItem Content="Vocals: All" Tag="all" />
                            <ComboBoxItem Content="Instrumental" Tag="instrumental" />
                            <ComboBoxItem Content="Vocal" Tag="vocal" />
                            <ComboBoxItem Content="Unknown" Tag="unknown" />
                        </ComboBox>

                        <ToggleSwitch MinWidth="0" OnContent="NOT Vocal" OffContent="Any Vocal"
                                      IsOn="{x:Bind ViewModel.ExcludeVocal, Mode=TwoWay}" VerticalAlignment="Center" />

                        <ComboBox Width="126" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterTempoBucket, Mode=TwoWay}">
                            <ComboBoxItem Content="Tempo: All" Tag="all" />
                            <ComboBoxItem Content="Very Slow" Tag="Very Slow" />
                            <ComboBoxItem Content="Slow" Tag="Slow" />
                            <ComboBoxItem Content="Moderate" Tag="Moderate" />
                            <ComboBoxItem Content="Fast" Tag="Fast" />
                            <ComboBoxItem Content="Very Fast" Tag="Very Fast" />
                        </ComboBox>

                        <ComboBox Width="148" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.FilterMoodCluster, Mode=TwoWay}">
                            <ComboBoxItem Content="Mood: All" Tag="all" />
                            <ComboBoxItem Content="Calm &amp; Relaxed" Tag="calm_relaxed" />
                            <ComboBoxItem Content="Bright &amp; Joyful" Tag="bright_joyful" />
                            <ComboBoxItem Content="Deep &amp; Introspective" Tag="deep_introspective" />
                            <ComboBoxItem Content="Warm &amp; Romantic" Tag="warm_romantic" />
                            <ComboBoxItem Content="High Tension" Tag="high_tension" />
                        </ComboBox>

                        <ComboBox Width="144" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.SelectedEnergyArc, Mode=TwoWay}">
                            <ComboBoxItem Content="Arc: Flat" Tag="flat" />
                            <ComboBoxItem Content="Energy Asc ↑" Tag="energy_asc" />
                            <ComboBoxItem Content="Sleep Desc ↓" Tag="energy_desc_sleep" />
                            <ComboBoxItem Content="90d Rediscovery" Tag="rediscovery_90d" />
                            <ComboBoxItem Content="Work Shuffle" Tag="work_shuffle" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="OLED Widget" Click="OnOpenOledWidgetClick"
                            Background="#242C3B" BorderBrush="#D9B372" BorderThickness="1" Foreground="#D9B372" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Three-Pane Studio Workbench -->
        <Grid Grid.Row="1" Padding="14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: 5 Persistent Session Slots + Curation & Ledger Controls -->
            <Border Grid.Column="0" Background="#1A202C" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Persistent Session Slots" Foreground="#D9B372" FontWeight="SemiBold" FontSize="13" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SessionSlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="interop:SessionSlotDto">
                                    <Grid Margin="0,2" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="#222938" Foreground="#E2E8F0" Padding="8,5"
                                                Tag="{x:Bind SlotIndex}" Click="OnRestoreSessionSlotClick">
                                            <TextBlock Text="{x:Bind Name}" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="1" Content="Save" Padding="8,5" FontSize="11"
                                                Background="#2D3748" Foreground="#D9B372"
                                                Tag="{x:Bind SlotIndex}" Click="OnSaveSessionSlotClick" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#2D3748" Margin="0,4" />

                        <TextBlock Text="Metadata &amp; Ledger Hub" Foreground="#D9B372" FontWeight="SemiBold" FontSize="13" />
                        <Button Content="Rebuild Audio Library Index"
                                Command="{x:Bind ViewModel.RebuildLibraryManifestCommand}"
                                HorizontalAlignment="Stretch" Background="#222938" Foreground="#E2E8F0" />
                        <Button Content="Scan Missing (Fill-Missing Only)"
                                Command="{x:Bind ViewModel.RunFillMissingScanCommand}"
                                HorizontalAlignment="Stretch" Background="#222938" Foreground="#E2E8F0" />
                        <Button Content="Fetch Missing Covers &amp; Bios"
                                Command="{x:Bind ViewModel.EnrichLibraryCoversAndBiosCommand}"
                                HorizontalAlignment="Stretch" Background="#222938" Foreground="#E2E8F0" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Sync Last.fm"
                                    Command="{x:Bind ViewModel.SyncLastFmLedgerCommand}"
                                    HorizontalAlignment="Stretch" Background="#222938" Foreground="#E2E8F0" />
                            <Button Grid.Column="1" Content="Setup..."
                                    Click="OnLastFmSetupClick"
                                    Background="#2D3748" Foreground="#D9B372" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.LastFmLedgerStatus, Mode=OneWay}"
                                   Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                        <Button Content="Export USB Car .m3u8..."
                                Click="OnExportUsbCarClick"
                                HorizontalAlignment="Stretch" Background="#222938" Foreground="#E2E8F0" />

                        <Button Content="Toggle LAN Sync Host (HTTP/2)"
                                Command="{x:Bind ViewModel.ToggleLanSyncHostCommand}"
                                HorizontalAlignment="Stretch" Background="#222938" Foreground="#D9B372" BorderBrush="#66D9B372" />
                        <TextBlock Text="{x:Bind ViewModel.LanSyncStatus, Mode=OneWay}"
                                   Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                        <Border Background="#131720" CornerRadius="6" Padding="8">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Pane: Missing-Tempo Banner + High-Density Track List + Staging Diff Drawer -->
            <Border Grid.Column="1" Background="#1A202C" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Missing Tempo Non-Blocking Banner -->
                    <Border Grid.Row="0" Visibility="{x:Bind ViewModel.HasMissingTempoBanner, Mode=OneWay}"
                            Background="#26D9B372" BorderBrush="#66D9B372" BorderThickness="1" CornerRadius="8" Padding="10,7">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.MissingMetadataBannerText, Mode=OneWay}"
                                       Foreground="#FDE68A" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Scan Missing" Padding="10,4" FontSize="11"
                                    Background="#D9B372" Foreground="#131720" FontWeight="SemiBold"
                                    Command="{x:Bind ViewModel.RunFillMissingScanCommand}" />
                        </Grid>
                    </Border>

                    <!-- Track Table -->
                    <ListView x:Name="TrackListView"
                              Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FilteredTracks}"
                              IsItemClickEnabled="True"
                              ItemClick="OnTrackClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackItem">
                                <Grid Padding="8,7" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ArtistsDisplay}" Foreground="#94A3B8" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SpecsDisplay}" Foreground="#D9B372" FontSize="11" FontFamily="Consolas" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DurationDisplay}" VerticalAlignment="Center"
                                               Foreground="#94A3B8" FontSize="12" FontFamily="Consolas" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Staging Diff Review Drawer -->
                    <Border Grid.Row="2" Visibility="{x:Bind ViewModel.HasStagingProposals, Mode=OneWay}"
                            Background="#131720" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StagingSummaryText, Mode=OneWay}"
                                           Foreground="#D9B372" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Commit Batch" Padding="10,4" FontSize="11"
                                        Background="#D9B372" Foreground="#131720" FontWeight="SemiBold"
                                        Command="{x:Bind ViewModel.CommitStagingBatchCommand}" />
                                <Button Grid.Column="2" Content="Rollback Batch" Padding="10,4" FontSize="11"
                                        Background="#242C3B" Foreground="#FDA4AF"
                                        Command="{x:Bind ViewModel.RollbackLastBatchCommand}" />
                            </Grid>

                            <ListView MaxHeight="140" ItemsSource="{x:Bind ViewModel.StagingProposals}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="curation:TagDiffProposal">
                                        <Grid ColumnSpacing="8" Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind FieldName}" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SuggestedValue}" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SourceTag}" Foreground="#D9B372" FontSize="10" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Approve" Padding="6,2" FontSize="10"
                                                    Tag="{x:Bind ProposalId}" Click="OnApproveProposalClick" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Pane: 64-Bit Acoustic Rack + Classical Serif Credits + A/B Switch + Booklet PDF -->
            <Border Grid.Column="2" Background="#1A202C" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="64-Bit Studio Acoustic Rack" Foreground="#D9B372" FontWeight="SemiBold" FontSize="13" />

                        <ToggleSwitch Header="WASAPI Exclusive (Event-Driven)"
                                      IsOn="{x:Bind ViewModel.PreferWasapiExclusive, Mode=TwoWay}" />

                        <ComboBox Header="Output Endpoint"
                                  ItemsSource="{x:Bind ViewModel.OutputEndpoints}"
                                  SelectedItem="{x:Bind ViewModel.SelectedEndpoint, Mode=TwoWay}"
                                  DisplayMemberPath="FriendlyName"
                                  HorizontalAlignment="Stretch" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Load PEQ (.txt)..." Click="OnLoadEqClick" HorizontalAlignment="Stretch" Background="#222938" Foreground="#E2E8F0" />
                            <Button Grid.Column="1" Content="Load FIR (.wav/.sofa)..." Click="OnLoadFirClick" HorizontalAlignment="Stretch" Background="#222938" Foreground="#E2E8F0" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.ActiveEqSummary, Mode=OneWay}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.FirImpulseFileName, Mode=OneWay}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                        <ToggleSwitch Header="ISO 226:2003 Dynamic Loudness"
                                      IsOn="{x:Bind ViewModel.IsIso226Enabled, Mode=TwoWay}" />

                        <Slider Header="Digital Attenuation (dB)"
                                Minimum="-40" Maximum="0" StepFrequency="1"
                                Value="{x:Bind ViewModel.VolumeAttenuationDb, Mode=TwoWay}" />

                        <Slider Header="FIR Convolver Dry / Wet Mix"
                                Minimum="0" Maximum="1" StepFrequency="0.05"
                                Value="{x:Bind ViewModel.FirDryWetMix, Mode=TwoWay}" />

                        <ToggleSwitch Header="24-Bit ±1 LSB TPDF Dither"
                                      IsOn="{x:Bind ViewModel.IsTpdfDitherEnabled, Mode=TwoWay}" />

                        <Border Visibility="{x:Bind ViewModel.HasSystemApoConflict, Mode=OneWay}"
                                Background="#3B1219" BorderBrush="#FDA4AF" BorderThickness="1" CornerRadius="6" Padding="8">
                            <TextBlock Text="{x:Bind ViewModel.SystemApoWarningText, Mode=OneWay}"
                                       Foreground="#FDA4AF" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <Border Background="#131720" BorderBrush="#33D9B372" BorderThickness="1" CornerRadius="8" Padding="10">
                            <TextBlock Text="{x:Bind ViewModel.SignalPathSummary, Mode=OneWay}"
                                       Foreground="#E2E8F0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <Border Height="1" Background="#2D3748" Margin="0,4" />

                        <!-- Classical 4-Level Serif & Encyclopedia Section -->
                        <TextBlock Text="Work, Classical Hierarchy &amp; Encyclopedia" Foreground="#D9B372" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ClassicalFourLevelSummary, Mode=OneWay, FallbackValue='--'}"
                                   Foreground="#E2E8F0" FontFamily="Georgia, Noto Serif SC, SimSun" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrack.WorkDisplay, Mode=OneWay, FallbackValue=''}"
                                   Foreground="#CBD5E1" FontFamily="Georgia, Noto Serif SC, SimSun" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ConductorsDisplay, Mode=OneWay, FallbackValue=''}"
                                   Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                        <!-- Multi-Recording A/B Switch -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasAlternateRecordings, Mode=OneWay}" Spacing="4">
                            <TextBlock Text="Multi-Recording A/B Comparison (Same Movement)" Foreground="#D9B372" FontSize="11" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AlternateRecordings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TrackItem">
                                        <Button Margin="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="#222938" Foreground="#E2E8F0" BorderBrush="#475569" Padding="8,4"
                                                Tag="{x:Bind TrackUid}" Click="OnSwitchAlternateRecordingClick">
                                            <TextBlock Text="{x:Bind AlternateVersionLabel}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Background="#131720" CornerRadius="6" Padding="8">
                            <TextBlock Text="{x:Bind ViewModel.CurrentBiographySummary, Mode=OneWay}"
                                       Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <!-- Split-Screen booklet.pdf Preview -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasBookletPdf, Mode=OneWay}" Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BookletPageStatusText" Grid.Column="0" Text="Booklet PDF"
                                           Foreground="#D9B372" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Prev" Padding="8,3" FontSize="11" Click="OnBookletPrevClick" />
                                <Button Grid.Column="2" Content="Next" Padding="8,3" FontSize="11" Click="OnBookletNextClick" />
                            </Grid>
                            <Border Background="#0F172A" CornerRadius="6" Padding="4" MaxHeight="260">
                                <Image x:Name="BookletPageImage" Stretch="Uniform" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Bar: Transport + Gold Badge + 150-Point Champagne Skia Waveform -->
        <Border Grid.Row="2" Background="#1A202C" BorderBrush="#2D3748" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay, FallbackValue='No Track Selected'}"
                               Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}"
                               Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" />
                </StackPanel>

                <skia:SKXamlCanvas x:Name="WaveformCanvas"
                                   Grid.Column="1"
                                   Height="44"
                                   PaintSurface="OnPaintWaveform"
                                   PointerPressed="OnWaveformPointerPressed" />

                <Border Grid.Column="2" Background="#26D9B372" BorderBrush="#66D9B372" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SignalPathBadge, Mode=OneWay}"
                               Foreground="#D9B372" FontSize="11" FontFamily="Consolas" />
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Prev" Command="{x:Bind ViewModel.PreviousTrackCommand}" Background="#242C3B" Foreground="#E2E8F0" />
                    <Button Content="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                            Background="#D9B372" Foreground="#131720" FontWeight="SemiBold" Padding="14,6" />
                    <Button Content="Next" Command="{x:Bind ViewModel.NextTrackCommand}" Background="#242C3B" Foreground="#E2E8F0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
