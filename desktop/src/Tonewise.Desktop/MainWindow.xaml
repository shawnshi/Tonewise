                                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2"><Slider Orientation="Vertical" Height="84" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.AutoEqRuleBand0Db, Mode=TwoWay}" AutomationProperties.Name="规则 31 Hz" /><TextBlock Text="31" FontSize="11" Foreground="{ThemeResource ZuneInkSecondaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind FormatDb(ViewModel.AutoEqRuleBand0Db), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ZuneInkPrimaryBrush}" HorizontalAlignment="Center" /></StackPanel>
