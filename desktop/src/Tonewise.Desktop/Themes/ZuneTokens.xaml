<?xml version="1.0" encoding="utf-8"?>
<!--
  Zune / Metro semantic design tokens for Tonewise.Desktop.
  "Content, Not Chrome": pure black (#000000) / pure white (#FFFFFF) canvas, zero corner radius (2px overlays),
  crisp Segoe UI Variable Display/Text + Microsoft YaHei UI typography, and Zune Magenta accent (#E5006B / #C20052).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ZuneCanvasBrush" Color="#000000" />
            <SolidColorBrush x:Key="ZuneSurfaceSubtleBrush" Color="#0E0E0E" />
            <SolidColorBrush x:Key="ZuneSurfaceHoverBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="ZuneSurfaceElevatedBrush" Color="#151515" />
            <SolidColorBrush x:Key="ZuneTransportBrush" Color="#050505" />
            <SolidColorBrush x:Key="ZuneInkPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ZuneInkSecondaryBrush" Color="#B5B5B5" />
            <SolidColorBrush x:Key="ZuneInkTertiaryBrush" Color="#888888" />
            <SolidColorBrush x:Key="ZuneInkOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ZuneAccentBrush" Color="#E5006B" />
            <SolidColorBrush x:Key="ZuneAccentSubtleBrush" Color="#26E5006B" />
            <SolidColorBrush x:Key="ZuneHairlineBrush" Color="#292929" />
            <SolidColorBrush x:Key="ZuneBorderControlBrush" Color="#737373" />
            <SolidColorBrush x:Key="ZuneStatusSuccessBrush" Color="#34D399" />
            <SolidColorBrush x:Key="ZuneStatusInfoBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="ZuneStatusWarnBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="ZuneStatusPurpleBrush" Color="#C084FC" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ZuneCanvasBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ZuneSurfaceSubtleBrush" Color="#F4F4F4" />
            <SolidColorBrush x:Key="ZuneSurfaceHoverBrush" Color="#EAEAEA" />
            <SolidColorBrush x:Key="ZuneSurfaceElevatedBrush" Color="#EFEFEF" />
            <SolidColorBrush x:Key="ZuneTransportBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="ZuneInkPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="ZuneInkSecondaryBrush" Color="#525252" />
            <SolidColorBrush x:Key="ZuneInkTertiaryBrush" Color="#6E6E6E" />
            <SolidColorBrush x:Key="ZuneInkOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ZuneAccentBrush" Color="#C20052" />
            <SolidColorBrush x:Key="ZuneAccentSubtleBrush" Color="#1CC20052" />
            <SolidColorBrush x:Key="ZuneHairlineBrush" Color="#DCDCDC" />
            <SolidColorBrush x:Key="ZuneBorderControlBrush" Color="#737373" />
            <SolidColorBrush x:Key="ZuneStatusSuccessBrush" Color="#047857" />
            <SolidColorBrush x:Key="ZuneStatusInfoBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="ZuneStatusWarnBrush" Color="#B45309" />
            <SolidColorBrush x:Key="ZuneStatusPurpleBrush" Color="#7E22CE" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ZuneCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZuneSurfaceSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZuneSurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ZuneSurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZuneTransportBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ZuneInkPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZuneInkSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZuneInkTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZuneInkOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ZuneAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ZuneAccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ZuneHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZuneBorderControlBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZuneStatusSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZuneStatusInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZuneStatusWarnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ZuneStatusPurpleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Font Families -->
    <FontFamily x:Key="ZuneDisplayFontFamily">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="ZuneBodyFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- Global WinUI 3 Fluent 2 Geometry Overrides -> Sharp Rectilinear Metro -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TextControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ComboBoxCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ToggleSwitchCornerRadius">0</CornerRadius>

    <!-- Zune Magenta Brand Accent (feeds AccentButtonStyle, ToggleSwitch, Slider, ProgressBar) -->
    <Color x:Key="SystemAccentColor">#E5006B</Color>
    <Color x:Key="SystemAccentColorLight1">#FF4D94</Color>
    <Color x:Key="SystemAccentColorLight2">#FF7AB0</Color>
    <Color x:Key="SystemAccentColorLight3">#FFA8CB</Color>
    <Color x:Key="SystemAccentColorDark1">#C20052</Color>
    <Color x:Key="SystemAccentColorDark2">#990041</Color>
    <Color x:Key="SystemAccentColorDark3">#700030</Color>

    <!-- Zune Typography Ramp (SemiLight/Normal optical weights for crisp DirectWrite rendering) -->
    <Style x:Key="ZuneHeroTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZuneDisplayFontFamily}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="SemiLight" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource ZuneInkPrimaryBrush}" />
    </Style>

    <Style x:Key="ZunePivotHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZuneDisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <Style x:Key="ZuneSubPivotStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZuneBodyFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="ZuneSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZuneBodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="30" />
        <Setter Property="Foreground" Value="{ThemeResource ZuneInkSecondaryBrush}" />
    </Style>

    <!-- Rectilinear Flat Button & Surface Styles -->
    <Style x:Key="ZuneFlatButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ZuneBodyFontFamily}" />
        <Setter Property="Background" Value="{ThemeResource ZuneSurfaceSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ZuneInkPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ZuneHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="ZuneGalleryActionButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ZuneBodyFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource ZuneInkPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ZuneAccentActionButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ZuneBodyFontFamily}" />
        <Setter Property="Background" Value="{ThemeResource ZuneAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ZuneInkOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ZuneFilterDropDownStyle" TargetType="DropDownButton">
        <Setter Property="FontFamily" Value="{StaticResource ZuneBodyFontFamily}" />
        <Setter Property="Background" Value="{ThemeResource ZuneSurfaceSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ZuneInkPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ZuneHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ZuneEditorialPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ZuneSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ZuneHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,12,0,12" />
    </Style>
</ResourceDictionary>
